 while true; do
  header
  echo -e "${BOLD}Other Linux / Rolling / NAS${NC}"
  cat <<'M'
  1) Alpine 3.21
  2) Alpine 3.22
  3) Alpine 3.23
  4) Alpine 3.24
  5) Fedora 43
  6) Fedora 44
  7) openSUSE Leap 16.0
  8) openSUSE Tumbleweed
  9) openEuler 20.03 LTS
 10) openEuler 22.03 LTS
 11) openEuler 24.03 LTS
 12) Kali Linux (Rolling)
 13) Arch Linux (Rolling)
 14) Gentoo (Rolling)
 15) AOSC OS (Rolling)
