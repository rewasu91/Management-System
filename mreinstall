#!/usr/bin/env bash
set -Eeuo pipefail

# VPS One-Click Reinstaller
# Targets: Debian 13 / Ubuntu 22.04
# Uses: https://github.com/bin456789/reinstall

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info()  { echo -e "${CYAN}[INFO]${NC} $*"; }
ok()    { echo -e "${GREEN}[ OK ]${NC} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $*"; }
die()   { echo -e "${RED}[FAIL]${NC} $*" >&2; exit 1; }

cleanup() {
  rm -f /tmp/reinstall-vps.sh.tmp 2>/dev/null || true
}
trap cleanup EXIT

clear || true
echo -e "${BOLD}====================================================${NC}"
echo -e "${BOLD}       VPS CLEAN REINSTALL - Debian / Ubuntu       ${NC}"
echo -e "${BOLD}====================================================${NC}"
echo

[[ $(id -u) -eq 0 ]] || die "Run this script as root."

# Basic environment checks
if [[ ! -r /etc/os-release ]]; then
  die "Unable to detect the current Linux system."
fi

. /etc/os-release
info "Current OS : ${PRETTY_NAME:-unknown}"
info "Kernel     : $(uname -r)"
info "Architecture: $(uname -m)"

ARCH=$(uname -m)
case "$ARCH" in
  x86_64|amd64|aarch64|arm64) ;;
  *) warn "Architecture $ARCH is less commonly tested. Continue only if you know it is supported." ;;
esac

# This reinstall method does not support container-style VPS virtualization.
VIRT="$(systemd-detect-virt 2>/dev/null || true)"
case "$VIRT" in
  openvz|lxc|lxc-libvirt)
    die "Virtualization '$VIRT' is not supported for disk-level reinstall."
    ;;
esac
info "Virtualization: ${VIRT:-unknown}"

# Need enough free RAM/disk for the bootstrap installer.
MEM_MB=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
ROOT_GB=$(df -BG / | awk 'NR==2 {gsub(/G/,"",$2); print $2}' 2>/dev/null || echo 0)
info "Memory     : ${MEM_MB} MB"
info "Root disk  : ${ROOT_GB} GB"

if (( MEM_MB < 512 )); then
  warn "Less than 512 MB RAM detected. Ubuntu reinstall may fail; Debian is safer on low-memory VPS."
fi

# Dependencies
for cmd in curl wget awk sed grep sha256sum; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    info "Installing required package for: $cmd"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y >/dev/null
    apt-get install -y curl wget coreutils gawk sed grep ca-certificates >/dev/null
    break
  fi
done

# Connectivity test
if ! curl -4fsSIL --connect-timeout 8 --max-time 15 https://raw.githubusercontent.com/ >/dev/null 2>&1; then
  warn "IPv4 GitHub check failed; trying normal network path..."
  curl -fsSIL --connect-timeout 8 --max-time 15 https://raw.githubusercontent.com/ >/dev/null 2>&1 \
    || die "Cannot reach GitHub. Check VPS DNS/network first."
fi
ok "Network check passed."

echo
cat <<'MENU'
Choose the new operating system:

  1) Debian 13 (Trixie)
  2) Ubuntu 22.04 LTS (Jammy)
  0) Cancel
MENU

echo
read -r -p "Select [1/2/0]: " CHOICE

case "$CHOICE" in
  1)
    TARGET_NAME="Debian 13"
    TARGET_ARGS=(debian 13)
    ;;
  2)
    TARGET_NAME="Ubuntu 22.04 LTS"
    TARGET_ARGS=(ubuntu 22.04)
    ;;
  0)
    echo "Cancelled."
    exit 0
    ;;
  *)
    die "Invalid selection."
    ;;
esac

echo
warn "THIS WILL ERASE THE VPS SYSTEM DISK."
warn "All files, users, services, VPN configs, databases and installed software on the system disk will be deleted."
echo
info "Target OS: $TARGET_NAME"
echo
cat <<'PASSINFO'
IMPORTANT ABOUT YOUR ROOT PASSWORD
----------------------------------
Linux cannot recover your existing root password in plaintext from /etc/shadow.
To keep the SAME password after reinstall, when the installer asks for a password:

  Username : root
  Password : enter your CURRENT root password

Do not leave the password blank, otherwise the installer may generate a random password.
PASSINFO

echo
read -r -p "Type ERASE to confirm reinstall to $TARGET_NAME: " CONFIRM
[[ "$CONFIRM" == "ERASE" ]] || die "Confirmation not received. Nothing was changed."

REINSTALL_URL="https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh"
REINSTALL_FILE="/root/reinstall.sh"

info "Downloading reinstall engine..."
curl -fL --retry 3 --connect-timeout 10 "$REINSTALL_URL" -o /tmp/reinstall-vps.sh.tmp
[[ -s /tmp/reinstall-vps.sh.tmp ]] || die "Downloaded installer is empty."

# Sanity check before replacing local copy.
grep -q 'reinstall' /tmp/reinstall-vps.sh.tmp || die "Downloaded file does not look like the expected reinstall script."
install -m 700 /tmp/reinstall-vps.sh.tmp "$REINSTALL_FILE"

ok "Installer downloaded."
info "SHA256: $(sha256sum "$REINSTALL_FILE" | awk '{print $1}')"
echo
warn "Your SSH session will disconnect after reboot."
warn "After reinstall, the SSH host key will change. If SSH warns about REMOTE HOST IDENTIFICATION, remove the old known_hosts entry on your PC."
echo

read -r -p "Start the reinstall setup now? [y/N]: " GO
case "$GO" in
  y|Y|yes|YES)
    ;;
  *)
    die "Cancelled before making boot changes."
    ;;
esac

echo
info "Launching installer for $TARGET_NAME..."
info "When prompted, use username 'root' and enter your CURRENT root password."
echo

# Let the upstream installer collect the password interactively so it is not
# exposed in this wrapper's command line or stored in a local plaintext file.
bash "$REINSTALL_FILE" "${TARGET_ARGS[@]}"

cat <<'EOF2'

====================================================
The reinstall environment has been prepared.

If the upstream installer instructs you to reboot, run:
  reboot

If you have NOT rebooted yet and want to cancel the prepared reinstall:
  bash /root/reinstall.sh reset
====================================================
EOF2
