 while true; do
  header
  echo -e "${BOLD}Debian / Ubuntu${NC}"
  cat <<'M'
  1) Debian 9 (Stretch)
  2) Debian 10 (Buster)
  3) Debian 11 (Bullseye)
  4) Debian 12 (Bookworm)
  5) Debian 13 (Trixie)
  6) Ubuntu 18.04 LTS
  7) Ubuntu 20.04 LTS
  8) Ubuntu 22.04 LTS
  9) Ubuntu 24.04 LTS
 10) Ubuntu 26.04 LTS
  0) Back
M
  read -r -p "Select: " c
  case "$c" in
   1) set_target "Debian 9" debian 9; return;; 2) set_target "Debian 10" debian 10; return;;
   3) set_target "Debian 11" debian 11; return;; 4) set_target "Debian 12" debian 12; return;;
   5) set_target "Debian 13" debian 13; return;; 6) set_target "Ubuntu 18.04 LTS" ubuntu 18.04; return;;
   7) set_target "Ubuntu 20.04 LTS" ubuntu 20.04; return;; 8) set_target "Ubuntu 22.04 LTS" ubuntu 22.04; return;;
