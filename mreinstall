   12) set_target "Kali Linux Rolling" kali; return;; 13) set_target "Arch Linux Rolling" arch; return;;
   14) set_target "Gentoo Rolling" gentoo; return;; 15) set_target "AOSC OS Rolling" aosc; return;;
   16) set_target "NixOS 26.05" nixos 26.05; return;; 17) set_target "fnOS 1" fnos 1; return;; 18) set_target "FygoOS 1" fygoos 1; return;;
