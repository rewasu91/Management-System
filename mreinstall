  esac
 done
}

menu_windows(){
 while true; do
  header
  echo -e "${BOLD}Windows ISO Installer${NC}"
  echo "Automatic ISO lookup is supported upstream for Windows 8.x/10/11 and Server 2019/2022/2025."
  echo
  cat <<'M'
  1) Windows 11 Pro
  2) Windows 11 Enterprise
  3) Windows 11 Enterprise LTSC 2024
  4) Windows 10 Pro
  5) Windows 10 Enterprise
  6) Windows Server 2019
  7) Windows Server 2022
  8) Windows Server 2025
  9) Custom Windows image name (automatic lookup)
 10) Custom Windows ISO URL
  0) Back
M
  read -r -p "Select: " c
  lang="en-us"
  case "$c" in
   1) image="Windows 11 Pro";; 2) image="Windows 11 Enterprise";; 3) image="Windows 11 Enterprise LTSC 2024";;
   4) image="Windows 10 Pro";; 5) image="Windows 10 Enterprise";; 6) image="Windows Server 2019";;
   7) image="Windows Server 2022";; 8) image="Windows Server 2025";;
   9) read -r -p "Exact Windows image name: " image; [[ -n "$image" ]] || continue;;
   10) read -r -p "Direct ISO URL: " iso; [[ "$iso" =~ ^https?:// ]] || { warn "Invalid URL"; sleep 1; continue; }; set_target "Windows custom ISO" windows "--iso=$iso"; return;;
   0) return 1;; *) warn "Invalid selection"; sleep 1; continue;;
  esac
  read -r -p "Language code [en-us]: " inlang; [[ -n "$inlang" ]] && lang="$inlang"
  set_target "$image ($lang)" windows "--image-name=$image" "--lang=$lang"
  return
 done
}

menu_advanced(){
 while true; do
  header
  echo -e "${BOLD}Advanced / Custom${NC}"
  cat <<'M'
  1) DD custom RAW/VHD image URL (.gz/.xz/.zst/.tar supported)
  2) Boot Alpine Live OS in RAM (no automatic disk wipe)
  3) Boot netboot.xyz (manual install via VNC/console)
  4) Cancel a prepared reinstall (before reboot)
  0) Back
M
  read -r -p "Select: " c
  case "$c" in
   1) read -r -p "RAW/VHD image URL: " url; [[ "$url" =~ ^https?:// ]] || { warn "Invalid URL"; sleep 1; continue; }; set_target "Custom DD image" dd --img "$url"; return;;
   2) set_target "Alpine Live OS (RAM only)" alpine --hold 1; return;;
   3) set_target "netboot.xyz" netboot.xyz; return;;
   4) fetch_engine; bash "$ENGINE_FILE" reset; exit $?;;
   0) return 1;; *) warn "Invalid selection"; sleep 1;;
  esac
 done
}

while [[ -z "$TARGET_NAME" ]]; do
 header
 echo -e "${GREEN}${BOLD}Detected provider: $PROVIDER${NC}"
 echo -e "${BOLD}Choose operating system family:${NC}"
 cat <<'M'
  1) Recommended for this VPS
  2) Debian / Ubuntu
  3) Enterprise Linux (Alma/Rocky/Oracle/CentOS/Anolis/OpenCloudOS/RHEL)
  4) Other Linux (Alpine/Fedora/openSUSE/openEuler/Kali/Arch/Gentoo/NixOS/NAS)
  5) Windows / Windows Server
  6) Advanced / Custom Image / netboot.xyz
  7) Show compatibility recommendation
  0) Exit
M
 read -r -p "Select [0-7]: " main
 case "$main" in
  1) menu_recommended || true;; 2) menu_debian_ubuntu || true;; 3) menu_rhel || true;; 4) menu_other_linux || true;; 5) menu_windows || true;; 6) menu_advanced || true;;
  7) header; print_recommendations; echo; pause;;
  0) exit 0;; *) warn "Invalid selection"; sleep 1;;
 esac
done

# Resource hints based on upstream documented minimums.
case "${TARGET_CMD[0]}" in
 debian|kali) (( MEM_MB < 256 )) && die "Target requires at least 256 MB RAM.";;
 ubuntu) (( MEM_MB < 512 )) && die "Ubuntu target requires at least 512 MB RAM."; (( ROOT_GB > 0 && ROOT_GB < 2 )) && warn "Ubuntu needs at least about 2 GB disk.";;
 alpine) :;;
 windows) (( MEM_MB < 512 )) && die "Windows requires at least 512 MB RAM; newer Windows generally needs 1 GB+ for this installer."; (( ROOT_GB > 0 && ROOT_GB < 25 )) && warn "Windows ISO installation generally requires at least 25 GB disk.";;
 *) (( MEM_MB < 512 )) && warn "Most selected targets require at least 512 MB RAM."; (( ROOT_GB > 0 && ROOT_GB < 5 )) && warn "Most selected targets require at least about 5 GB disk.";;
esac

header
info "Selected target: $TARGET_NAME"
info "Detected provider: $PROVIDER ($PROVIDER_CONF confidence)"

if [[ "$PROVIDER_ID" == "digitalocean" && "${TARGET_CMD[0]}" == "windows" ]]; then
  warn "Windows is not a recommended target in the DigitalOcean profile. Linux is preferred for Droplets."
fi
if (( IS_ARM )) && [[ "${TARGET_CMD[0]}" == "windows" ]]; then
  warn "You selected Windows on ARM64. Compatibility varies strongly by provider and instance type."
fi

echo
echo -e "${RED}${BOLD}WARNING: REINSTALL/INSTALL OPERATIONS CAN ERASE THE ENTIRE VPS SYSTEM DISK.${NC}"
echo "Existing files, VPN configs, databases, users and installed software may be destroyed."
echo
if [[ "${TARGET_CMD[0]}" != "netboot.xyz" && ! ( "${TARGET_CMD[0]}" == "alpine" && " ${TARGET_CMD[*]} " == *" --hold 1 "* ) ]]; then
 cat <<'P'
PASSWORD NOTE
-------------
Linux does not store the current root password in readable plaintext.
When the upstream installer asks for credentials, enter the same current password
if you want the new OS to use the same password.

For Windows, the installer normally uses the Administrator account and asks for a password.
P
fi
read -r -p "Type ERASE to continue with '$TARGET_NAME': " confirm
[[ "$confirm" == "ERASE" ]] || die "Cancelled. No changes were made."

fetch_engine

echo
printf '%b\n' "${BOLD}Command:${NC}"
printf '  bash %q' "$ENGINE_FILE"; for a in "${TARGET_CMD[@]}"; do printf ' %q' "$a"; done; echo
read -r -p "Start setup now? [y/N]: " go
case "$go" in y|Y|yes|YES) ;; *) die "Cancelled before boot changes were made.";; esac

info "Launching upstream reinstall engine..."
bash "$ENGINE_FILE" "${TARGET_CMD[@]}"

cat <<'DONE'

========================================================
SETUP COMMAND COMPLETED
========================================================
Read the upstream installer's final instructions carefully.
If it tells you to reboot, run:

  reboot

Before reboot, a prepared reinstall can normally be cancelled with:

  bash /root/reinstall.sh reset

After reinstall, the SSH host key normally changes. On your PC, if needed:

  ssh-keygen -R VPS_IP

Then reconnect using the credentials selected during setup.
DONE
