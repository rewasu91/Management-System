#!/usr/bin/env bash
set -Eeuo pipefail

# VPS Universal Reinstaller
# Wrapper for https://github.com/bin456789/reinstall
# Targets follow the upstream support matrix current at script creation time.

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; MAGENTA='\033[0;35m'; BOLD='\033[1m'; DIM='\033[2m'; NC='\033[0m'
info(){ echo -e "${CYAN}[INFO]${NC} $*"; }
ok(){ echo -e "${GREEN}[ OK ]${NC} $*"; }
warn(){ echo -e "${YELLOW}[WARN]${NC} $*"; }
die(){ echo -e "${RED}[FAIL]${NC} $*" >&2; exit 1; }
pause(){ read -r -p "Press Enter to continue..." _; }

ENGINE_URL="https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh"
ENGINE_FILE="/root/reinstall.sh"
TMP_FILE="/tmp/vps-reinstall-engine.$$"
trap 'rm -f "$TMP_FILE" 2>/dev/null || true' EXIT

[[ $(id -u) -eq 0 ]] || die "Please run this script as root."
[[ -r /etc/os-release ]] || die "Unable to detect current Linux distribution."
. /etc/os-release

ARCH=$(uname -m)
VIRT=$(systemd-detect-virt 2>/dev/null || true); [[ -n "$VIRT" ]] || VIRT=unknown
MEM_MB=$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo)
ROOT_GB=$(df -BG / | awk 'NR==2 {gsub(/G/,"",$2);print $2}'); [[ "$ROOT_GB" =~ ^[0-9]+$ ]] || ROOT_GB=0

# ---------------------------------------------------------
# Provider detection (local DMI first, metadata as validation)
# ---------------------------------------------------------
PROVIDER="Unknown / Generic"
PROVIDER_ID="generic"
PROVIDER_CONF="low"
DMI_VENDOR=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
DMI_PRODUCT=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
DMI_VERSION=$(cat /sys/class/dmi/id/product_version 2>/dev/null || true)
DMI_BOARD=$(cat /sys/class/dmi/id/board_vendor 2>/dev/null || true)
DMI_ALL=$(printf '%s %s %s %s' "$DMI_VENDOR" "$DMI_PRODUCT" "$DMI_VERSION" "$DMI_BOARD" | tr '[:upper:]' '[:lower:]')

set_provider(){ PROVIDER="$1"; PROVIDER_ID="$2"; PROVIDER_CONF="${3:-high}"; }

case "$DMI_ALL" in
  *digitalocean*) set_provider "DigitalOcean" digitalocean;;
  *amazon*ec2*|*amazon*) set_provider "Amazon Web Services (EC2)" aws;;
  *google*compute*engine*|*google*) set_provider "Google Cloud Platform (Compute Engine)" gcp;;
  *microsoft*corporation*|*virtual*machine*) set_provider "Microsoft Azure" azure medium;;
  *oracle*cloud*|*oraclecloud*) set_provider "Oracle Cloud Infrastructure" oraclecloud;;
  *hetzner*) set_provider "Hetzner Cloud" hetzner;;
  *linode*|*akamai*) set_provider "Akamai / Linode" linode;;
  *vultr*) set_provider "Vultr" vultr;;
  *contabo*) set_provider "Contabo" contabo;;
  *scaleway*) set_provider "Scaleway" scaleway;;
  *upcloud*) set_provider "UpCloud" upcloud;;
  *ovh*|*openstack*) set_provider "OVHcloud / OpenStack" openstack medium;;
  *alibaba*|*aliyun*) set_provider "Alibaba Cloud" alibaba;;
  *tencent*) set_provider "Tencent Cloud" tencent;;
  *huaweicloud*|*huawei*) set_provider "Huawei Cloud" huawei;;
  *leaseweb*) set_provider "Leaseweb" leaseweb;;
  *qemu*|*kvm*) set_provider "Generic KVM/QEMU VPS" generic-kvm medium;;
  *vmware*) set_provider "VMware VPS" vmware medium;;
  *xen*) set_provider "Generic Xen VPS" xen medium;;
esac

# Metadata validation/fallback. Keep timeouts tiny so startup never hangs.
metadata_get(){ curl -fsS --noproxy '*' --connect-timeout 1 --max-time 2 "$1" 2>/dev/null || true; }
if [[ "$PROVIDER_ID" == "generic" || "$PROVIDER_CONF" != "high" ]]; then
  md=$(metadata_get 'http://169.254.169.254/metadata/v1/id')
  if [[ "$md" =~ ^[0-9]+$ ]]; then
    set_provider "DigitalOcean" digitalocean high
  elif metadata_get 'http://169.254.169.254/latest/meta-data/instance-id' | grep -Eq '^i-[0-9a-f]+'; then
    set_provider "Amazon Web Services (EC2)" aws high
  elif metadata_get 'http://metadata.google.internal/computeMetadata/v1/instance/id' | grep -Eq '^[0-9]+'; then
    set_provider "Google Cloud Platform (Compute Engine)" gcp high
  fi
fi

IS_ARM=0
case "$ARCH" in aarch64|arm64) IS_ARM=1;; esac

# Recommendation profile is intentionally conservative: it describes what this
# wrapper recommends, not every OS a provider may technically boot.
RECOMMENDED=()
COMPATIBLE=()
NOT_RECOMMENDED=()
RECOMMEND_NOTE=""

build_recommendations(){
  RECOMMENDED=(); COMPATIBLE=(); NOT_RECOMMENDED=(); RECOMMEND_NOTE=""

  if (( IS_ARM )); then
    RECOMMENDED+=("Debian 12" "Debian 13" "Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Ubuntu 26.04 LTS" "Alpine 3.22/3.23/3.24")
    COMPATIBLE+=("Arch Linux" "Fedora (when upstream image supports this architecture)" "Other ARM-capable Linux targets")
    NOT_RECOMMENDED+=("Legacy x86-only images" "Unknown third-party DD images without ARM64 support")
  else
    RECOMMENDED+=("Debian 12" "Debian 13" "Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Ubuntu 26.04 LTS")
    COMPATIBLE+=("AlmaLinux 9/10" "Rocky Linux 9/10" "Alpine 3.22-3.24" "Fedora 43/44" "Windows Server 2022/2025")
  fi

  case "$PROVIDER_ID" in
    digitalocean)
      RECOMMENDED=("Debian 12" "Debian 13" "Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Ubuntu 26.04 LTS" "AlmaLinux 9" "Rocky Linux 9")
      COMPATIBLE=("Alpine 3.22-3.24" "Fedora 43/44" "Arch Linux" "Other standard Linux targets")
      NOT_RECOMMENDED=("Windows via this wrapper" "Unverified custom DD images")
      RECOMMEND_NOTE="DigitalOcean Droplets are Linux VMs; this profile prioritizes mainstream Linux distributions and avoids presenting Windows as a recommended target."
      ;;
    aws)
      RECOMMENDED=("Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Debian 12" "Debian 13" "AlmaLinux 9" "Rocky Linux 9")
      COMPATIBLE=("Windows Server 2022/2025" "Alpine" "Fedora" "Other supported Linux targets")
      RECOMMEND_NOTE="The upstream engine can inject AWS ENA/NVMe/Xen drivers when needed."
      ;;
    gcp)
      RECOMMENDED=("Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Debian 12" "Debian 13" "Rocky Linux 9")
      COMPATIBLE=("Windows Server 2022/2025 on supported x86 instances" "AlmaLinux" "Fedora" "Other supported Linux targets")
      if (( IS_ARM )); then NOT_RECOMMENDED+=("Windows on GCP T2A/ARM (upstream notes missing network driver)"); fi
      RECOMMEND_NOTE="The upstream engine can add GCP VirtIO/gVNIC/GGA drivers when needed."
      ;;
    azure)
      RECOMMENDED=("Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Debian 12" "Debian 13" "AlmaLinux 9" "Windows Server 2022/2025")
      COMPATIBLE=("Rocky Linux" "Fedora" "Other supported Linux targets")
      RECOMMEND_NOTE="The upstream engine can add Azure MANA networking drivers when needed."
      ;;
    oraclecloud)
      RECOMMENDED=("Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Debian 12" "Debian 13" "Oracle Linux 8/9/10")
      COMPATIBLE=("AlmaLinux" "Rocky Linux" "Alpine" "Other supported Linux targets")
      if (( IS_ARM )); then NOT_RECOMMENDED+=("Windows on OCI A1/ARM: upstream marks success as uncertain"); fi
      RECOMMEND_NOTE="OCI ARM instances need extra caution with Windows; Linux is the safer recommendation."
      ;;
    alibaba|tencent)
      RECOMMENDED=("Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Debian 12" "Debian 13" "AlmaLinux 9")
      COMPATIBLE=("Rocky Linux" "Windows Server 2022/2025" "Other supported Linux targets")
      RECOMMEND_NOTE="The upstream engine includes cloud-specific VirtIO drivers for Alibaba/Tencent environments when required."
      ;;
    hetzner|linode|vultr|contabo|upcloud|leaseweb|openstack|generic-kvm|vmware|xen|generic)
      RECOMMENDED=("Debian 12" "Debian 13" "Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Ubuntu 26.04 LTS" "AlmaLinux 9" "Rocky Linux 9")
      COMPATIBLE=("Alpine" "Fedora" "openSUSE" "Arch" "Windows Server on supported x86/KVM environments" "Other upstream-supported targets")
      RECOMMEND_NOTE="Generic compatibility profile: mainstream Linux is prioritized because it is the most portable across VPS platforms."
      ;;
    scaleway)
      RECOMMENDED=("Debian 12" "Debian 13" "Ubuntu 22.04 LTS" "Ubuntu 24.04 LTS" "Alpine")
      COMPATIBLE=("AlmaLinux" "Rocky Linux" "Other upstream-supported Linux targets")
      RECOMMEND_NOTE="On ARM, Linux is preferred; upstream reports Windows ARM compatibility on Scaleway COPARM1, but treat it as advanced."
      ;;
    *) :;;
  esac
}
build_recommendations

case "$VIRT" in openvz|lxc|lxc-libvirt) die "This reinstall engine does not support $VIRT virtualization.";; esac

for cmd in curl awk grep sed sha256sum; do
  command -v "$cmd" >/dev/null 2>&1 || {
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y && apt-get install -y curl ca-certificates coreutils gawk grep sed
    break
  }
done

info "Checking Internet connectivity..."
curl -fsSI --connect-timeout 8 --max-time 15 https://raw.githubusercontent.com/ >/dev/null || die "Cannot reach GitHub raw content. Check DNS/network."
ok "Internet connectivity is working."

fetch_engine(){
  info "Downloading latest reinstall engine..."
  curl -fL --retry 3 --retry-delay 2 --connect-timeout 10 "$ENGINE_URL" -o "$TMP_FILE" || die "Failed to download reinstall engine."
  [[ -s "$TMP_FILE" ]] || die "Downloaded reinstall engine is empty."
  install -m 700 "$TMP_FILE" "$ENGINE_FILE"
  ok "Engine saved as $ENGINE_FILE"
  info "SHA256: $(sha256sum "$ENGINE_FILE" | awk '{print $1}')"
}

header(){
  clear 2>/dev/null || true
  echo -e "${BOLD}========================================================${NC}"
  echo -e "${BOLD}             VPS UNIVERSAL REINSTALLER                 ${NC}"
  echo -e "${BOLD}========================================================${NC}"
  echo "Current OS      : ${PRETTY_NAME:-unknown}"
  echo "Provider        : $PROVIDER"
  echo "Detection       : $PROVIDER_CONF confidence"
  echo "Architecture    : $ARCH"
  echo "Virtualization  : $VIRT"
  echo "Memory          : ${MEM_MB} MB"
  echo "Root filesystem : ${ROOT_GB} GB"
  echo
}

TARGET_NAME=""; TARGET_CMD=()
set_target(){ TARGET_NAME="$1"; shift; TARGET_CMD=("$@"); }

print_recommendations(){
  echo -e "${GREEN}${BOLD}Recommended for this VPS${NC}"
  local i
  for i in "${RECOMMENDED[@]}"; do echo -e "  ${GREEN}★${NC} $i"; done
  echo
  echo -e "${CYAN}${BOLD}Compatible / advanced${NC}"
  for i in "${COMPATIBLE[@]}"; do echo -e "  ${CYAN}•${NC} $i"; done
  if ((${#NOT_RECOMMENDED[@]})); then
    echo
    echo -e "${YELLOW}${BOLD}Use caution / not recommended${NC}"
    for i in "${NOT_RECOMMENDED[@]}"; do echo -e "  ${YELLOW}!${NC} $i"; done
  fi
  [[ -n "$RECOMMEND_NOTE" ]] && { echo; echo -e "${DIM}$RECOMMEND_NOTE${NC}"; }
}

menu_recommended(){
 while true; do
  header
  print_recommendations
  echo
  echo -e "${BOLD}Quick install:${NC}"
  if (( IS_ARM )); then
    cat <<'M'
  1) Debian 12
  2) Debian 13
  3) Ubuntu 22.04 LTS
  4) Ubuntu 24.04 LTS
  5) Ubuntu 26.04 LTS
  6) Alpine 3.24
  0) Back
M
    read -r -p "Select: " c
    case "$c" in
      1) set_target "Debian 12" debian 12; return;;
      2) set_target "Debian 13" debian 13; return;;
      3) set_target "Ubuntu 22.04 LTS" ubuntu 22.04; return;;
      4) set_target "Ubuntu 24.04 LTS" ubuntu 24.04; return;;
      5) set_target "Ubuntu 26.04 LTS" ubuntu 26.04; return;;
      6) set_target "Alpine 3.24" alpine 3.24; return;;
      0) return 1;; *) warn "Invalid selection"; sleep 1;;
    esac
  else
    case "$PROVIDER_ID" in
      azure)
        cat <<'M'
  1) Ubuntu 24.04 LTS
  2) Ubuntu 22.04 LTS
  3) Debian 13
  4) Debian 12
  5) AlmaLinux 9
  6) Windows Server 2022
  7) Windows Server 2025
  0) Back
M
        read -r -p "Select: " c
        case "$c" in
          1) set_target "Ubuntu 24.04 LTS" ubuntu 24.04; return;; 2) set_target "Ubuntu 22.04 LTS" ubuntu 22.04; return;;
          3) set_target "Debian 13" debian 13; return;; 4) set_target "Debian 12" debian 12; return;; 5) set_target "AlmaLinux 9" almalinux 9; return;;
          6) set_target "Windows Server 2022 (en-us)" windows "--image-name=Windows Server 2022" "--lang=en-us"; return;;
          7) set_target "Windows Server 2025 (en-us)" windows "--image-name=Windows Server 2025" "--lang=en-us"; return;;
          0) return 1;; *) warn "Invalid selection"; sleep 1;;
        esac
        ;;
      digitalocean)
        cat <<'M'
  1) Debian 13
  2) Debian 12
  3) Ubuntu 24.04 LTS
  4) Ubuntu 22.04 LTS
  5) Ubuntu 26.04 LTS
  6) AlmaLinux 9
  7) Rocky Linux 9
  0) Back
M
        read -r -p "Select: " c
        case "$c" in
          1) set_target "Debian 13" debian 13; return;; 2) set_target "Debian 12" debian 12; return;;
          3) set_target "Ubuntu 24.04 LTS" ubuntu 24.04; return;; 4) set_target "Ubuntu 22.04 LTS" ubuntu 22.04; return;;
          5) set_target "Ubuntu 26.04 LTS" ubuntu 26.04; return;; 6) set_target "AlmaLinux 9" almalinux 9; return;;
          7) set_target "Rocky Linux 9" rocky 9; return;; 0) return 1;; *) warn "Invalid selection"; sleep 1;;
        esac
        ;;
      *)
        cat <<'M'
  1) Debian 13
  2) Debian 12
  3) Ubuntu 24.04 LTS
  4) Ubuntu 22.04 LTS
  5) Ubuntu 26.04 LTS
  6) AlmaLinux 9
  7) Rocky Linux 9
  0) Back
M
        read -r -p "Select: " c
        case "$c" in
          1) set_target "Debian 13" debian 13; return;; 2) set_target "Debian 12" debian 12; return;;
          3) set_target "Ubuntu 24.04 LTS" ubuntu 24.04; return;; 4) set_target "Ubuntu 22.04 LTS" ubuntu 22.04; return;;
          5) set_target "Ubuntu 26.04 LTS" ubuntu 26.04; return;; 6) set_target "AlmaLinux 9" almalinux 9; return;;
          7) set_target "Rocky Linux 9" rocky 9; return;; 0) return 1;; *) warn "Invalid selection"; sleep 1;;
        esac
        ;;
    esac
  fi
 done
}

