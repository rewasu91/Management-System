 while true; do
  header
  echo -e "${BOLD}Enterprise / RHEL Family${NC}"
  cat <<'M'
  1) AlmaLinux 8
  2) AlmaLinux 9
  3) AlmaLinux 10
  4) Rocky Linux 8
  5) Rocky Linux 9
  6) Rocky Linux 10
  7) Oracle Linux 8
  8) Oracle Linux 9
  9) Oracle Linux 10
 10) CentOS Stream 9
 11) CentOS Stream 10
 12) Anolis OS 7
 13) Anolis OS 8
 14) Anolis OS 23
 15) OpenCloudOS 8
 16) OpenCloudOS 9
 17) OpenCloudOS Stream 23
 18) RHEL / compatible custom QCOW2 URL
  0) Back
M
  read -r -p "Select: " c
  case "$c" in
   1) set_target "AlmaLinux 8" almalinux 8; return;; 2) set_target "AlmaLinux 9" almalinux 9; return;; 3) set_target "AlmaLinux 10" almalinux 10; return;;
   4) set_target "Rocky Linux 8" rocky 8; return;; 5) set_target "Rocky Linux 9" rocky 9; return;; 6) set_target "Rocky Linux 10" rocky 10; return;;
   7) set_target "Oracle Linux 8" oracle 8; return;; 8) set_target "Oracle Linux 9" oracle 9; return;; 9) set_target "Oracle Linux 10" oracle 10; return;;
