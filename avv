#!/usr/bin/env bash
set -euo pipefail
R=/usr/local/rere
B=/root/kaizensc-v7-ui-backup-$(date +%Y%m%d-%H%M%S)
mkdir -p "$B"
echo "[INFO] Backup: $B"
for n in kaizen-ui xray-account menu addssh trial-ssh extend-ssh cek-login-ssh list-ssh delete-ssh lock-ssh unlock-ssh check-ssh-config change-limit-ip-ssh change-limit-ip-all-ssh addss delss renewss cekss add-noobz ex-noobz cek-login-noobz config-noobz add-zivpn delete-zivpn extend-zivpn list-zivpn status-zivpn install-zivpn uninstall-zivpn change-port-zivpn change-obfs-zivpn; do [[ -f "$R/$n" ]] && cp -a "$R/$n" "$B/$n"; done
echo '' | base64 -d > "$R/kaizen-ui"
chmod +x "$R/kaizen-ui"
echo '' | base64 -d > "$R/xray-account"
chmod +x "$R/xray-account"
echo '' | base64 -d > "$R/menu"
chmod +x "$R/menu"
echo '' | base64 -d > "$R/addssh"
chmod +x "$R/addssh"
echo '' | base64 -d > "$R/trial-ssh"
chmod +x "$R/trial-ssh"
echo '' | base64 -d > "$R/extend-ssh"
chmod +x "$R/extend-ssh"
echo '' | base64 -d > "$R/cek-login-ssh"
chmod +x "$R/cek-login-ssh"
echo '' | base64 -d > "$R/list-ssh"
chmod +x "$R/list-ssh"
echo '' | base64 -d > "$R/delete-ssh"
chmod +x "$R/delete-ssh"
echo '' | base64 -d > "$R/lock-ssh"
chmod +x "$R/lock-ssh"
echo '' | base64 -d > "$R/unlock-ssh"
chmod +x "$R/unlock-ssh"
echo '' | base64 -d > "$R/check-ssh-config"
chmod +x "$R/check-ssh-config"
echo '' | base64 -d > "$R/change-limit-ip-ssh"
chmod +x "$R/change-limit-ip-ssh"
echo '' | base64 -d > "$R/change-limit-ip-all-ssh"
chmod +x "$R/change-limit-ip-all-ssh"
echo '' | base64 -d > "$R/addss"
chmod +x "$R/addss"
echo '' | base64 -d > "$R/delss"
chmod +x "$R/delss"
echo '' | base64 -d > "$R/renewss"
chmod +x "$R/renewss"
echo '' | base64 -d > "$R/cekss"
chmod +x "$R/cekss"
echo '' | base64 -d > "$R/add-noobz"
chmod +x "$R/add-noobz"
echo '' | base64 -d > "$R/ex-noobz"
chmod +x "$R/ex-noobz"
echo '' | base64 -d > "$R/cek-login-noobz"
chmod +x "$R/cek-login-noobz"
echo '' | base64 -d > "$R/config-noobz"
chmod +x "$R/config-noobz"
echo '' | base64 -d > "$R/add-zivpn"
chmod +x "$R/add-zivpn"
echo '' | base64 -d > "$R/delete-zivpn"
chmod +x "$R/delete-zivpn"
echo '' | base64 -d > "$R/extend-zivpn"
chmod +x "$R/extend-zivpn"
echo '' | base64 -d > "$R/status-zivpn"
chmod +x "$R/status-zivpn"
echo '' | base64 -d > "$R/install-zivpn"
chmod +x "$R/install-zivpn"
echo '' | base64 -d > "$R/uninstall-zivpn"
chmod +x "$R/uninstall-zivpn"
echo '' | base64 -d > "$R/change-obfs-zivpn"
chmod +x "$R/change-obfs-zivpn"
echo '[INFO] Validating shell syntax...'
for n in kaizen-ui xray-account menu addssh trial-ssh extend-ssh cek-login-ssh list-ssh delete-ssh lock-ssh unlock-ssh check-ssh-config change-limit-ip-ssh change-limit-ip-all-ssh addss delss renewss cekss add-noobz ex-noobz cek-login-noobz config-noobz add-zivpn delete-zivpn extend-zivpn list-zivpn status-zivpn install-zivpn uninstall-zivpn change-port-zivpn change-obfs-zivpn; do [[ -f "$R/$n" ]] || continue; head -n1 "$R/$n" | grep -Eq "bash|/sh" && bash -n "$R/$n" || true; done
echo '[OK] KaizenSC v7 centered UI applied.'
