#!/usr/bin/env bash
set -euo pipefail

TARGET=/usr/local/rere/xray-account
BACKUP="${TARGET}.bak.$(date +%Y%m%d-%H%M%S)"

if [[ ! -f "$TARGET" ]]; then
  echo "[ERROR] $TARGET not found."
  exit 1
fi

cp -a "$TARGET" "$BACKUP"
echo "[INFO] Backup created: $BACKUP"

python3 - "$TARGET" <<'PY'
from pathlib import Path
import sys
p = Path(sys.argv[1])
s = p.read_text()
old = "local p=$1 email=$2 c=$3 d tls='443' ntls='80' name=${email//@/%40}"
new = "local p=$1 email=$2 c=$3 d=$4 tls='443' ntls='80' name=${email//@/%40}"
if old in s:
    s = s.replace(old, new, 1)
elif new in s:
    print('[INFO] Fix already present.')
else:
    print('[ERROR] Expected links() declaration was not found. No changes made.')
    sys.exit(2)
p.write_text(s)
PY

chmod +x "$TARGET"

if ! bash -n "$TARGET"; then
  echo "[ERROR] Syntax validation failed. Restoring backup."
  cp -a "$BACKUP" "$TARGET"
  exit 1
fi

echo "[OK] Fixed unbound variable d."
echo "[OK] bash -n validation passed."
echo "[INFO] Test again from Xray > VLESS/VMess/Trojan > Create Account."
