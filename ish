#!/usr/bin/env bash
set -euo pipefail
STAMP="$(date +%Y%m%d-%H%M%S)"
BK="/root/kaizensc-v10-ui-backup-$STAMP"
mkdir -p "$BK"
echo "[INFO] Backup: $BK"
if [ -f "/usr/local/rere/kaizen-ui" ]; then cp -a "/usr/local/rere/kaizen-ui" "$BK/usr__local__rere__kaizen-ui"; fi
mkdir -p "$(dirname "/usr/local/rere/kaizen-ui")"
printf '%s' '' | base64 -d > "/usr/local/rere/kaizen-ui"
chmod +x "/usr/local/rere/kaizen-ui"
if [ -f "/usr/local/rere/trial-ssh" ]; then cp -a "/usr/local/rere/trial-ssh" "$BK/usr__local__rere__trial-ssh"; fi
mkdir -p "$(dirname "/usr/local/rere/trial-ssh")"
printf '%s' '' | base64 -d > "/usr/local/rere/trial-ssh"
chmod +x "/usr/local/rere/trial-ssh"
if [ -f "/usr/local/rere/info" ]; then cp -a "/usr/local/rere/info" "$BK/usr__local__rere__info"; fi
mkdir -p "$(dirname "/usr/local/rere/info")"
printf '%s' '' | base64 -d > "/usr/local/rere/info"
chmod +x "/usr/local/rere/info"
if [ -f "/usr/local/rere/addssh" ]; then cp -a "/usr/local/rere/addssh" "$BK/usr__local__rere__addssh"; fi
mkdir -p "$(dirname "/usr/local/rere/addssh")"
printf '%s' '' | base64 -d > "/usr/local/rere/addssh"
chmod +x "/usr/local/rere/addssh"
if [ -f "/usr/local/rere/menu" ]; then cp -a "/usr/local/rere/menu" "$BK/usr__local__rere__menu"; fi
mkdir -p "$(dirname "/usr/local/rere/menu")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu"
chmod +x "/usr/local/rere/menu"
if [ -f "/usr/local/rere/xray-account" ]; then cp -a "/usr/local/rere/xray-account" "$BK/usr__local__rere__xray-account"; fi
mkdir -p "$(dirname "/usr/local/rere/xray-account")"
printf '%s' '' | base64 -d > "/usr/local/rere/xray-account"
chmod +x "/usr/local/rere/xray-account"
echo "[OK] KaizenSC v10 UI/output patch applied."
echo "[INFO] No Xray/Nginx/HAProxy restart required."
