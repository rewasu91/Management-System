#!/usr/bin/env bash
set -euo pipefail
STAMP="$(date +%Y%m%d-%H%M%S)"
BK="/root/kaizensc-v12-backup-$STAMP"
mkdir -p "$BK"
echo "[INFO] Backup: $BK"
[ ! -f "/usr/local/rere/info" ] || cp -a "/usr/local/rere/info" "$BK/usr__local__rere__info"
mkdir -p "$(dirname "/usr/local/rere/info")"
printf '%s' '' | base64 -d > "/usr/local/rere/info"
chmod +x "/usr/local/rere/info"
[ ! -f "/usr/local/rere/menu" ] || cp -a "/usr/local/rere/menu" "$BK/usr__local__rere__menu"
mkdir -p "$(dirname "/usr/local/rere/menu")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu"
chmod +x "/usr/local/rere/menu"
[ ! -f "/usr/local/rere/xray-account" ] || cp -a "/usr/local/rere/xray-account" "$BK/usr__local__rere__xray-account"
mkdir -p "$(dirname "/usr/local/rere/xray-account")"
printf '%s' '' | base64 -d > "/usr/local/rere/xray-account"
chmod +x "/usr/local/rere/xray-account"
echo "[OK] Xray List Account and Total Account spacing fixed."
echo "[INFO] No service restart required."
