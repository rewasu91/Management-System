#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
set -u
DB=/etc/kaizensc/database/ssh/database.json
[[ -s "$DB" ]] || { echo 'No SSH account found.'; exit 0; }
clear
kaizen_header " • Extend SSH Account • "
echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
jq -r '.[]|[.Username,(.Expired//"Lifetime")]|@tsv' "$DB" | while IFS=$'\t' read -r u e; do
 printf 'Username     : %s\nExpire Date  : %s\n' "$u" "$e"
 echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
done
read -rp 'Input Username: ' user
old=$(jq -r --arg u "$user" '.[]|select(.Username==$u)|.Expired' "$DB" | head -1)
[[ -n "$old" && "$old" != null ]] || { echo '[ERROR] Account not found.'; exit 1; }
read -rp 'Use custom expired date? (y/n): ' ans
if [[ "$ans" =~ ^[Yy]$ ]]; then
  read -rp 'Custom expired (YYYY-MM-DD): ' custom
  [[ "$custom" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo '[ERROR] Invalid date format.'; exit 1; }
  new="$custom"
else
  read -rp 'Extend (days): ' days
  [[ "$days" =~ ^[0-9]+$ ]] || { echo '[ERROR] Days must be a number.'; exit 1; }
  now=$(date +%s); old_epoch=$(date -d "$old" +%s 2>/dev/null || echo 0)
  ((old_epoch>now)) && base=$old_epoch || base=$now
  new=$(date -d "@$((base + days*86400))" '+%F')
fi
jq --arg u "$user" --arg e "$new" 'map(if .Username==$u then .Expired=$e else . end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
# chage uses YYYY-MM-DD directly; user may be nologin but account expiration still applies.
chage -E "$new" "$user" >/dev/null 2>&1 || true
clear
kaizen_header " • SSH ACCOUNT EXTENDED • "
printf 'Account       : %s\nPrevious      : %s\nNew Expiry    : %s\nStatus        : SUCCESS\n' "$user" "$old" "$new"

