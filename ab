#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
set -euo pipefail
DB="/etc/kaizensc/database/ssh/database.json"
clear
kaizen_header " • Edit User/Pass SSH Account • "
[[ -s "$DB" ]] || { echo "No SSH accounts found."; exit 0; }
echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
jq -r '.[] | [.Username, (.LimitIP // "0"), (.Expired // "Lifetime")] | @tsv' "$DB" |
while IFS=$'\t' read -r user limit exp; do
  [[ -n "$user" ]] || continue
  printf 'Username     : %s\n' "$user"
  printf 'IP Limit     : %s\n' "$limit"
  printf 'Expire Date  : %s\n' "$exp"
  echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
done
echo
read -rp 'Username to edit: ' old
[[ -n "$old" ]] || exit 0
row=$(jq -c --arg u "$old" '.[] | select(.Username==$u)' "$DB" | head -n1)
[[ -n "$row" ]] || { echo "[ERROR] Account not found."; exit 1; }
read -rp "New Username [$old]: " new
new=${new:-$old}
[[ "$new" =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || { echo "[ERROR] Invalid username."; exit 1; }
if [[ "$new" != "$old" ]] && id "$new" >/dev/null 2>&1; then echo "[ERROR] Username already exists."; exit 1; fi
read -rsp 'New Password: ' pass; echo
[[ -n "$pass" ]] || { echo "[ERROR] Password cannot be empty."; exit 1; }
if [[ "$new" != "$old" ]]; then
  usermod -l "$new" "$old"
  if getent passwd "$new" | cut -d: -f6 | grep -qx "/home/$old"; then
    usermod -d "/home/$new" -m "$new" 2>/dev/null || true
  fi
fi
printf '%s:%s\n' "$new" "$pass" | chpasswd
tmp=$(mktemp)
jq --arg old "$old" --arg new "$new" 'map(if .Username==$old then .Username=$new else . end)' "$DB" > "$tmp"
mv "$tmp" "$DB"
clear
kaizen_header " • SSH USER/PASS UPDATED • "
echo "Previous Username : $old"
echo "New Username      : $new"
echo "Password          : UPDATED"
echo "Status            : SUCCESS"

