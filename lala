#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
CONF=/etc/shadowsocks-libev/akun.conf

clear
kaizen_header " • List Shadowsocks Account • "

[[ -s "$CONF" ]] || {
  echo "No Shadowsocks account found."
  read -rp 'Press Enter to continue...' _
  exit 0
}

mapfile -t rows < <(awk '/^### / {print $2 "|" $3}' "$CONF")
count=${#rows[@]}
if ((count==0)); then
  echo "No Shadowsocks account found."
  read -rp 'Press Enter to continue...' _
  exit 0
fi

C=$(kaizen_table_colour)
W=$(kaizen_text_colour)
Y=$(kaizen_yellow)
R=$(kaizen_reset)
BG='\e[0;47;30m'

uw=16
ew=11
for row in "${rows[@]}"; do
  u=${row%%|*}
  e=${row#*|}
  e="${e/T/ }"
  e="${e%% *}"
  ((${#u}>uw)) && uw=${#u}
  ((${#e}>ew)) && ew=${#e}
done

a=$(kaizen_repeat_line '─' $((uw+2)))
b=$(kaizen_repeat_line '─' $((ew+2)))
inner=$((uw+ew+5))

printf '%b┌%s┬%s┐%b\n' "$C" "$a" "$b" "$R"
printf '%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b\n' \
  "$C" "$R" "$BG" "$uw" "Username" "$R" "$C" \
  "$R" "$BG" "$ew" "Expire Date" "$R" "$C" "$R"
printf '%b├%s┼%s┤%b\n' "$C" "$a" "$b" "$R"

for row in "${rows[@]}"; do
  u=${row%%|*}
  e=${row#*|}
  e="${e/T/ }"
  e="${e%% *}"
  printf '%b│%b %-*s %b│%b %-*s %b│%b\n' \
    "$C" "$W" "$uw" "$u" "$C" "$W" "$ew" "$e" "$C" "$R"
done

printf '%b├%s┴%s┤%b\n' "$C" "$a" "$b" "$R"
printf '%b│%b Total User : %b%-*s%b│%b\n' \
  "$C" "$W" "$Y" "$((inner-14))" "$count" "$C" "$R"
printf '%b└%s┘%b\n' "$C" "$(kaizen_repeat_line '─' "$inner")" "$R"

read -rp 'Press Enter to continue...' _

