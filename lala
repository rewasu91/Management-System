 valid_proto "$p" || exit 2
 if [[ $mode == trial ]]; then
   clear; action_header "Create $(proto_label "$p") Trial Account"
   echo -e "  ${UI_WHITE}Information on adding an account${UI_PLAIN}"
   echo
   echo -e "  \e[0;36mExample of valid Expired input\e[0m"
