iplimit="1"
quota="1"

# Save to JSON database
jq --arg user "$Login" --arg pass "$Pass" --arg ip "$iplimit" --arg quota "$quota" --arg exp "$expire_time" \
    '. += [{"Username": $user, "Password": $pass, "LimitIP": $ip, "Quota": $quota, "Expired": $exp, "Locked": false}]' \
    "$database" > "${database}.tmp" && mv "${database}.tmp" "$database"

# Save quota limit & IP if provided
