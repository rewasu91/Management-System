mkdir -p $(dirname "$database")

if [[ ! -f "$database" ]]; then
    echo "[]" > "$database"
fi

generate_random_string() {
    tr -dc A-Za-z0-9 </dev/urandom | head -c 8
}

Login="trial-$(generate_random_string)"
Pass=$(generate_random_string)

clear
kaizen_header " • Create SSH Trial Account • "
echo -e "${WHITE}Information on adding an account${plain}"
echo
echo -e "\e[0;36mExample of valid Expired input\e[0m"
echo -e "${WHITE}- 1m  (expired 1 minute)${plain}"
echo -e "${WHITE}- 1h  (expired 1 hour)${plain}"
echo -e "${WHITE}- 1d  (expired 1 day)${plain}"
echo
kaizen_rainbow_line
echo
while true; do
    read -rp " Expired (1m/1h/1d): " masaaktif
    if [[ "$masaaktif" =~ ^[1-9][0-9]*[mhd]$ ]]; then
        n=${masaaktif%?}; unit=${masaaktif: -1}
        case "$unit" in m) unit_word="minutes";; h) unit_word="hours";; d) unit_word="days";; esac
