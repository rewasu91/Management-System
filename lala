		if [[ ${CLIENT_EXISTS} == '1' ]]; then
			echo ""
			echo -e "Username ${RED}${user}${NC} Already On VPS Please Choose Another"
			exit 1
		fi
	done
while true; do
    read -rp "Expired : " masaaktif
    exp=$(kaizen_parse_expiry "$masaaktif" 2>/dev/null) && [[ -n "$exp" ]] && break
    echo "[ERROR] Invalid expiry. Use 10, YYYY-MM-DD, or YYYY-MM-DD HH:MM:SS."
done
exp_store="${exp/ /T}"
hariini=$(date -d "0 days" +"%Y-%m-%d")
cat > /etc/shadowsocks-libev/$user-tls.json<<END
{   
    "server":"0.0.0.0",
    "server_port":$tls,
    "password":"$user",
