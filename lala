<b>UDP      :</b> <code>1-65535</code>
<b>Proxy    :</b> <code>3128</code>
<b>OpenVPN  :</b> <code>1194/2200</code>
${argo_info_telegram}
<b>──────────── SOCKS5 ────────────</b>
<code>socks5://${encoded_username}:${encoded_password}@${proxy_ip}:1080</code>
${dns_info_telegram}
<b>──────────── HTTP CUSTOM ────────────</b>
<code>${domain}:1-65535@${Login}:${Pass}</code>
<b>──────────── INFO ────────────</b>
<b>Limit IP :</b> <code>$iplimit</code>
<b>Payload  :</b>
<code>GET /ssh HTTP/1.1[crlf]Host:${domain}[crlf]Upgrade:websocket[crlf][crlf]</code>
<b>OpenVPN  :</b> <a href=\"https://$domain/fn/index.html\">https://$domain/fn/index.html</a>
<b>Expired  :</b> <code>$expire_time</code>
<b>──────────────────────────────</b>
"

curl -s -X POST "https://api.telegram.org/bot$telegram_bot_token/sendMessage" \
    -d "chat_id=$telegram_chatid" \
    -d "parse_mode=HTML" \
    -d "text=${TEKS}" > /dev/null

# Account information output
clear
echo -e ""
echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${plain}"
echo -e "${keatas2} ${bgPutih}            • SSH Trial Account Information •             ${plain} ${keatas2}"
echo -e "${CYAN}╠════════════════════════════════════════════════════════════╣${plain}"
echo -e "${CYAN}║${plain} ${white}Hostname        : $domain | $IPVPS${plain}"
echo -e "${CYAN}║${plain} ${white}Username        : $Login${plain}"
echo -e "${CYAN}║${plain} ${white}Password        : $Pass${plain}"
echo -e "${CYAN}║${plain} ${white}ISP Server      : $isp${plain}"
echo -e "${CYAN}║${plain} ${white}Region Server   : $region${plain}"
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
echo -e "${CYAN}║${plain} ${white}Port WebSocket  : 80, 2080, 2082, 8000, 8080, 8880${plain}"
echo -e "${CYAN}║${plain} ${white}Port TLS/SSL    : 443, 8443${plain}"
echo -e "${CYAN}║${plain} ${white}Port UDP Custom : 1-65535${plain}"
echo -e "${CYAN}║${plain} ${white}Port HTTP Proxy : 3128 (Limit Access)${plain}"
echo -e "${CYAN}║${plain} ${white}Port OpenVPN    : 1194 / 2200${plain}"
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
if [[ -n "$argo_info_output" ]]; then
    echo -e "$argo_info_output"
    echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
fi
echo -e "${CYAN}║${plain} ${white}Socks5          : socks5://${encoded_username}:${encoded_password}@${domain}:1080${plain}"
if [[ -n "$dns_info_output" ]]; then
    echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
    echo -e "$dns_info_output"
fi
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
echo -e "${CYAN}║${plain} ${white}HTTP Custom    : ${domain}:1-65535@${Login}:${Pass}${plain}"
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
echo -e "${CYAN}║${plain} ${white}Limit IP       : $iplimit${plain}"
echo -e "${CYAN}║${plain} ${white}Payload WS     : GET /ssh HTTP/1.1[crlf]Host: ${domain}[crlf]Upgrade: websocket[crlf][crlf]${plain}"
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
echo -e "${CYAN}║${plain} ${white}OpenVPN        : https://$domain/fn/index.html${plain}"
echo -e "${CYAN}╠────────────────────────────────────────────────────────────╣${plain}"
echo -e "${CYAN}║${plain} ${white}Expired On${plain}     : ${GREEN}$expire_time${plain}"
echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${plain}"


__KZN_TRIAL_SSH__
chmod 0755 "$RERE/trial-ssh"
bash -n "$RERE/trial-ssh"

[[ -f "$RERE/addss" ]] && cp -a "$RERE/addss" "$BACKUP/rere/addss" || true
cat > "$RERE/addss" <<'__KZN_ADDSS__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true

# Informasi
telegram_bot_token=$(cat /etc/kaizensc/bot/notif/bot.key)
telegram_chatid=$(cat /etc/kaizensc/bot/notif/client.id)
domain=$(cat /etc/xray/domain)
lastport1=$(grep "port_tls" /etc/shadowsocks-libev/akun.conf | tail -n1 | awk '{print $2}')
lastport2=$(grep "port_http" /etc/shadowsocks-libev/akun.conf | tail -n1 | awk '{print $2}')
if [[ $lastport1 == '' ]]; then
tls=2443
else
tls="$((lastport1+1))"
fi
if [[ $lastport2 == '' ]]; then
http=3443
else
http="$((lastport2+1))"
fi
