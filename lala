plain='\e[0m'
bgPutih="\e[0;47;30m"
keatas="${CYAN}│${plain}"
keatas2="${CYAN}║${plain}"

# === RAINBOW LINE ===
function cmd()
{
  printf "  "
  for i in {52..57} {57..52}
  do
  printf "\e[38;5;${i}m────\e[0m"
  done
  echo
}

# Function to URL-encode username and password
url_encode() {
    local raw="$1"
    local encoded=""
    for (( i=0; i<${#raw}; i++ )); do
        char="${raw:i:1}"
        case "$char" in
            [a-zA-Z0-9._~-]) encoded+="$char" ;;
            *) encoded+=$(printf '%%%02X' "'$char") ;;
        esac
    done
    echo "$encoded"
}

# Information
domain=$(cat /etc/xray/domain)
database="/etc/kaizensc/database/ssh/database.json"
isp=$(cat /root/.isp)
region=$(cat /root/.region)
nameserver=$(cat /etc/kaizensc/slowdns/nameserver)
pubkey=$(cat /etc/kaizensc/slowdns/server.pub)
telegram_bot_token=$(cat /etc/kaizensc/bot/notif/bot.key)
telegram_chatid=$(cat /etc/kaizensc/bot/notif/client.id)
IPVPS=$(cat /root/.ip)

# Check SlowDNS Tunnel
