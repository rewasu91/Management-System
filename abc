#!/usr/bin/env bash
set -euo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo '[ERROR] Run as root.'; exit 1; }
BACKUP="/root/xray-lock-limit-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP"
for f in /usr/local/rere/xray-account /usr/local/rere/menu-vless /usr/local/rere/menu-vmess /usr/local/rere/menu-trojan /etc/funny/config/xray/xray.conf /etc/crontab; do
  [[ -e "$f" ]] && cp -a --parents "$f" "$BACKUP/"
done
echo "[INFO] Backup: $BACKUP"
PAYLOAD_LINE=$(awk '/^__PAYLOAD_BELOW__$/ {print NR+1; exit}' "$0")
tail -n +"$PAYLOAD_LINE" "$0" | base64 -d | tar -xzf - -C /
chmod +x /usr/local/rere/xray-account /usr/local/rere/menu-vless /usr/local/rere/menu-vmess /usr/local/rere/menu-trojan
/usr/local/rere/xray-account count vless >/dev/null
if [[ -f /etc/crontab ]]; then
  sed -i -E 's#^\*/5 ([^#]*xray-account limit-check (vless|vmess|trojan).*)#* \1#' /etc/crontab || true
fi
bash -n /usr/local/rere/xray-account
for f in /usr/local/rere/menu-vless /usr/local/rere/menu-vmess /usr/local/rere/menu-trojan; do bash -n "$f"; done
if command -v nginx >/dev/null 2>&1; then nginx -t; fi
for p in vless vmess trojan; do
  if [[ -x /usr/local/xray-new/xray && -f /etc/funny/json/$p.json ]]; then /usr/local/xray-new/xray run -test -config "/etc/funny/json/$p.json" >/dev/null; fi
done
systemctl daemon-reload
for p in vless vmess trojan; do systemctl restart "xray-quota@$p" 2>/dev/null || true; done
systemctl restart nginx 2>/dev/null || true
systemctl restart cron 2>/dev/null || true
echo '[OK] Hotfix applied.'
echo '[INFO] IP/quota violation => LOCK; expiry => permanent delete.'
exit 0
__PAYLOAD_BELOW__

