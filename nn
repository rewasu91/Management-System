#!/usr/bin/env bash
set -euo pipefail
BACKUP="/root/kaizensc-v5-menu-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP"
FILES=(menu menu-ssh menu-xray menu-vless menu-vmess menu-trojan menu-system menu-noobz trial-ssh xray-account)
for f in "${FILES[@]}"; do
  [[ -e "/usr/local/rere/$f" ]] && cp -a "/usr/local/rere/$f" "$BACKUP/$f"
done
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
sed -n '/^__PAYLOAD__$/,$p' "$0" | tail -n +2 | base64 -d > "$TMP/payload.tar.gz"
tar -xzf "$TMP/payload.tar.gz" -C /
chmod +x /usr/local/rere/{menu,menu-ssh,menu-xray,menu-vless,menu-vmess,menu-trojan,menu-system,menu-noobz,trial-ssh,xray-account}
for f in /usr/local/rere/{menu,menu-ssh,menu-xray,menu-vless,menu-vmess,menu-trojan,menu-system,menu-noobz,trial-ssh,xray-account}; do
  bash -n "$f"
done
echo "[OK] KaizenSC trial/menu update applied."
echo "[INFO] Backup: $BACKUP"
exit 0
