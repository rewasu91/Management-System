#!/usr/bin/env bash
set -euo pipefail
BACKUP="/root/kaizensc-v6-menu-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP/usr/local/rere"
for f in menu xray-account menu-ss menu-noobz menu-wgcf menu-udp menu-udp-zivpn slowdns; do
  [[ -f "/usr/local/rere/$f" ]] && cp -a "/usr/local/rere/$f" "$BACKUP/usr/local/rere/$f"
done
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
base64 -d > "$TMP/payload.tar.gz" <<'PAYLOAD'

PAYLOAD
tar -xzf "$TMP/payload.tar.gz" -C /
chmod +x /usr/local/rere/menu /usr/local/rere/xray-account /usr/local/rere/menu-ss /usr/local/rere/menu-noobz /usr/local/rere/menu-wgcf /usr/local/rere/menu-udp /usr/local/rere/menu-udp-zivpn /usr/local/rere/slowdns
for f in menu xray-account menu-ss menu-noobz menu-wgcf menu-udp menu-udp-zivpn slowdns; do
  bash -n "/usr/local/rere/$f"
done
echo "[OK] KaizenSC v6 menu/output style patch applied."
echo "[INFO] Backup: $BACKUP"
