#!/usr/bin/env bash
set -euo pipefail
STAMP="$(date +%Y%m%d-%H%M%S)"
BK="/root/kaizensc-v14-backup-$STAMP"
mkdir -p "$BK"
echo "[INFO] Backup: $BK"
[ ! -f "/usr/local/rere/menu-vless" ] || cp -a "/usr/local/rere/menu-vless" "$BK/usr__local__rere__menu-vless"
mkdir -p "$(dirname "/usr/local/rere/menu-vless")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu-vless"
chmod +x "/usr/local/rere/menu-vless"
[ ! -f "/usr/local/rere/menu-trojan" ] || cp -a "/usr/local/rere/menu-trojan" "$BK/usr__local__rere__menu-trojan"
mkdir -p "$(dirname "/usr/local/rere/menu-trojan")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu-trojan"
chmod +x "/usr/local/rere/menu-trojan"
[ ! -f "/usr/local/rere/info" ] || cp -a "/usr/local/rere/info" "$BK/usr__local__rere__info"
mkdir -p "$(dirname "/usr/local/rere/info")"
printf '%s' '' | base64 -d > "/usr/local/rere/info"
chmod +x "/usr/local/rere/info"
[ ! -f "/usr/local/rere/menu" ] || cp -a "/usr/local/rere/menu" "$BK/usr__local__rere__menu"
mkdir -p "$(dirname "/usr/local/rere/menu")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu"
chmod +x "/usr/local/rere/menu"
[ ! -f "/usr/local/rere/xray-account" ] || cp -a "/usr/local/rere/xray-account" "$BK/usr__local__rere__xray-account"
mkdir -p "$(dirname "/usr/local/rere/xray-account")"
printf '%s' '' | base64 -d > "/usr/local/rere/xray-account"
chmod +x "/usr/local/rere/xray-account"
[ ! -f "/usr/local/rere/list-ssh" ] || cp -a "/usr/local/rere/list-ssh" "$BK/usr__local__rere__list-ssh"
mkdir -p "$(dirname "/usr/local/rere/list-ssh")"
printf '%s' '' | base64 -d > "/usr/local/rere/list-ssh"
chmod +x "/usr/local/rere/list-ssh"
[ ! -f "/usr/local/rere/menu-vmess" ] || cp -a "/usr/local/rere/menu-vmess" "$BK/usr__local__rere__menu-vmess"
mkdir -p "$(dirname "/usr/local/rere/menu-vmess")"
printf '%s' '' | base64 -d > "/usr/local/rere/menu-vmess"
chmod +x "/usr/local/rere/menu-vmess"
echo "[OK] KaizenSC v14 login-title/menu UI patch applied."
echo "[INFO] No Xray/Nginx/HAProxy restart required."
