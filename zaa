#!/usr/bin/env bash
set -euo pipefail
STAMP="$(date +%Y%m%d-%H%M%S)"
BK="/root/kaizensc-v9-ui-backup-$STAMP"
mkdir -p "$BK"
echo "[INFO] Backup: $BK"
if [ -f "/usr/local/rere/kaizen-ui" ]; then cp -a "/usr/local/rere/kaizen-ui" "$BK/$(basename "/usr/local/rere/kaizen-ui")"; fi
mkdir -p "$(dirname "/usr/local/rere/kaizen-ui")"
printf '%s' '' | base64 -d > "/usr/local/rere/kaizen-ui"
chmod +x "/usr/local/rere/kaizen-ui"
if [ -f "/usr/local/rere/extend-ssh" ]; then cp -a "/usr/local/rere/extend-ssh" "$BK/$(basename "/usr/local/rere/extend-ssh")"; fi
mkdir -p "$(dirname "/usr/local/rere/extend-ssh")"
printf '%s' '' | base64 -d > "/usr/local/rere/extend-ssh"
chmod +x "/usr/local/rere/extend-ssh"
if [ -f "/usr/local/rere/xray-account" ]; then cp -a "/usr/local/rere/xray-account" "$BK/$(basename "/usr/local/rere/xray-account")"; fi
mkdir -p "$(dirname "/usr/local/rere/xray-account")"
printf '%s' '' | base64 -d > "/usr/local/rere/xray-account"
chmod +x "/usr/local/rere/xray-account"

echo "[OK] KaizenSC v9 UI/result patch applied."
echo "[INFO] No Xray/Nginx/HAProxy restart required."
