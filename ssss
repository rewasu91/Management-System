#!/usr/bin/env bash
set -euo pipefail
RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; WHITE='\e[1;97m'; NC='\e[0m'
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo -e "${RED}Run this patch as root.${NC}"; exit 1; }
[[ -d /usr/local/rere ]] || { echo -e "${RED}/usr/local/rere not found. KaizenSC does not appear to be installed.${NC}"; exit 1; }
command -v python3 >/dev/null 2>&1 || { export DEBIAN_FRONTEND=noninteractive; apt-get update -y; apt-get install -y python3; }
stamp=$(date +%Y%m%d-%H%M%S)
backup="/root/kaizensc-brightness-backup-${stamp}"
mkdir -p "$backup"
[[ -e /usr/local/rere/adjust-text-brightness ]] && cp -a /usr/local/rere/adjust-text-brightness "$backup/"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
sed -n '/^__BRIGHTNESS_PAYLOAD__$/,$p' "$0" | tail -n +2 | base64 -d > "$tmp"
bash -n "$tmp"
install -m 0755 "$tmp" /usr/local/rere/adjust-text-brightness
/usr/local/rere/adjust-text-brightness --apply normal
bash -n /usr/local/rere/adjust-text-brightness
mkdir -p /etc/kaizensc
printf 'normal\n' > /etc/kaizensc/text-brightness.conf
cat <<MSG

Brightness white fix installed successfully.
Backup: $backup

Normal / Not Bright white now uses ANSI 0;97 (white/bright-white, non-bold).
Existing ANSI 0;37/1;37/0;97/1;97 and legacy 38;5;240 white are normalized to 0;97.
Other colours remain non-bold in Normal mode.
MSG
exit 0
__BRIGHTNESS_PAYLOAD__

