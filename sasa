#!/usr/bin/env bash
set -euo pipefail

RED='\e[1;31m'; GREEN='\e[1;32m'; YELLOW='\e[1;33m'; CYAN='\e[1;36m'; WHITE='\e[1;97m'; NC='\e[0m'

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo -e "${RED}Run this patch as root.${NC}"; exit 1; }
[[ -d /usr/local/rere ]] || { echo -e "${RED}/usr/local/rere not found. KaizenSC does not appear to be installed.${NC}"; exit 1; }

if ! command -v python3 >/dev/null 2>&1; then
  echo -e "${YELLOW}Installing python3...${NC}"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y python3
fi

stamp=$(date +%Y%m%d-%H%M%S)
backup="/root/kaizensc-patch-backup-${stamp}"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$backup"

for f in adjust-text-brightness fn-sc1 menu-argo; do
  [[ -e "/usr/local/rere/$f" ]] && cp -a "/usr/local/rere/$f" "$backup/$f"
done

sed -n '/^__PAYLOAD_BELOW__$/,$p' "$0" | tail -n +2 | base64 -d > "$tmp/payload.tar.gz"
tar -xzf "$tmp/payload.tar.gz" -C "$tmp"

for f in adjust-text-brightness fn-sc1 menu-argo; do
  bash -n "$tmp/$f"
done

install -m 0755 "$tmp/adjust-text-brightness" /usr/local/rere/adjust-text-brightness
install -m 0755 "$tmp/fn-sc1" /usr/local/rere/fn-sc1
install -m 0755 "$tmp/menu-argo" /usr/local/rere/menu-argo

# Repair any old dark-gray white markers and make Normal / Not Bright the active mode.
/usr/local/rere/adjust-text-brightness --apply normal

# Validate again after brightness conversion modifies text files.
bash -n /usr/local/rere/adjust-text-brightness
bash -n /usr/local/rere/fn-sc1
bash -n /usr/local/rere/menu-argo

if grep -q 'printf \\"' /usr/local/rere/fn-sc1 /usr/local/rere/menu-argo 2>/dev/null; then
  echo -e "${RED}Validation failed: escaped printf quote still exists.${NC}"
  exit 1
fi

cat <<MSG

Patch installed successfully.
Backup: $backup

Fixed:
- Service ON/OFF menu separator command errors.
- Cloudflare Argo menu recursion/flow and setup handling.
- Argo now creates a dedicated Nginx loopback listener on 127.0.0.1:1011 during setup.
- Normal / Not Bright white is standard non-bold white (0;37), not dark gray.
- Old 38;5;240 dark-gray white markers are migrated back to 0;37.
- Adjust Text Brightness menu separator matches Xray/SSH gradient style.
MSG
exit 0
