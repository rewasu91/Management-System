PAYLOAD
base64 -d "$TMP_DIR/payload.b64" > "$TMP_DIR/payload.tar.gz"
tar -xzf "$TMP_DIR/payload.tar.gz" -C "$TMP_DIR"

install -m 755 "$TMP_DIR/usr/local/rere/bot-menu" /usr/local/rere/bot-menu
install -m 755 "$TMP_DIR/usr/local/rere/bot-notification" /usr/local/rere/bot-notification
install -m 755 "$TMP_DIR/usr/local/rere/backup" /usr/local/rere/backup
install -m 755 "$TMP_DIR/usr/local/rere/restore" /usr/local/rere/restore
install -m 755 "$TMP_DIR/usr/local/rere/adjust-text-brightness" /usr/local/rere/adjust-text-brightness

mkdir -p /etc/kaizensc/bot/notif
[[ -s /etc/kaizensc/bot/notif/interval ]] || printf '10\n' > /etc/kaizensc/bot/notif/interval
chmod 600 /etc/kaizensc/bot/notif/bot.key /etc/kaizensc/bot/notif/client.id 2>/dev/null || true

# Keep the currently requested KaizenSC default appearance.
/usr/local/rere/adjust-text-brightness --apply normal >/dev/null 2>&1 || true

echo
echo 'KaizenSC Bot Manager patch installed successfully.'
echo "Backup of replaced files: $BACKUP_DIR"
echo 'New backup ZIP password: KznAutoSC'
echo 'Legacy Rerechan02 backup ZIPs remain restorable.'
