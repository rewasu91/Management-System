#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo 'Please run this patch as root.' >&2
  exit 1
fi

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP_DIR="/root/kaizensc-patch-backup-${STAMP}"
TMP_DIR=$(mktemp -d /tmp/kaizensc-bot-patch.XXXXXX)
trap 'rm -rf "$TMP_DIR"' EXIT
mkdir -p "$BACKUP_DIR/usr/local/rere"

for f in bot-menu bot-notification backup restore adjust-text-brightness; do
  if [[ -e "/usr/local/rere/$f" ]]; then
    cp -a "/usr/local/rere/$f" "$BACKUP_DIR/usr/local/rere/$f"
  fi
done
if [[ -e /etc/cron.d/kaizensc-bot-notification ]]; then
  mkdir -p "$BACKUP_DIR/etc/cron.d"
