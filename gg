#!/usr/bin/env bash
set -euo pipefail
if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "[ERROR] Please run this patch as root."
  exit 1
fi
BASE=/usr/local/kaisc
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="/root/kaizensc-final-align-backup-$STAMP"
mkdir -p "$BACKUP"
for f in menu info detail menu-system; do
  [[ -f "$BASE/$f" ]] && cp -a "$BASE/$f" "$BACKUP/$f"
done
restore_backup(){
  echo "[ERROR] Patch failed. Restoring previous files..."
  for f in menu info detail menu-system; do
    [[ -f "$BACKUP/$f" ]] && cp -a "$BACKUP/$f" "$BASE/$f"
  done
}
trap restore_backup ERR

base64 -d > "$BASE/menu" <<'KZN_MENU'

KZN_MENU
chmod 755 "$BASE/menu"

base64 -d > "$BASE/info" <<'KZN_INFO'

KZN_INFO
chmod 755 "$BASE/info"

base64 -d > "$BASE/detail" <<'KZN_DETAIL'

KZN_DETAIL
chmod 755 "$BASE/detail"

base64 -d > "$BASE/menu-system" <<'KZN_MENU_SYSTEM'

KZN_MENU_SYSTEM
chmod 755 "$BASE/menu-system"

for f in menu info detail menu-system; do
  bash -n "$BASE/$f"
done
grep -Fq 'Input Option [ 1-7 ]:' "$BASE/menu"
grep -Fq 'Vless WS Custompath' "$BASE/detail"
grep -Fq 'Xray Vless' "$BASE/menu"
grep -Fq 'Xray Trojan' "$BASE/menu"
trap - ERR
echo
echo "KaizenSC final alignment patch applied successfully."
echo "Backup: $BACKUP"
echo "Run: menu"
