#!/usr/bin/env bash
set -Eeuo pipefail

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "[ERROR] Run this script as root."; exit 1; }

STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="/root/xray-tcp-http-fix-$STAMP"
mkdir -p "$BACKUP"

echo "[INFO] Backup: $BACKUP"
for f in /etc/haproxy/haproxy.cfg /etc/funny/json/vless.json /etc/funny/json/vmess.json /etc/funny/json/trojan.json /usr/local/rere/xray-account; do
  [[ -e "$f" ]] && cp -a --parents "$f" "$BACKUP/"
done

python3 - <<'PY'
import json, pathlib

# Normalize RAW/TCP HTTP camouflage path. A default / path is much more
# compatible with clients/importers than custom TCP paths.
for proto in ('vless','vmess','trojan'):
    p=pathlib.Path(f'/etc/funny/json/{proto}.json')
    if not p.exists():
        raise SystemExit(f'[ERROR] Missing {p}')
    data=json.loads(p.read_text())
    found=0
    for ib in data.get('inbounds',[]):
        ss=ib.get('streamSettings',{})
        if ss.get('network') in ('tcp','raw') and ('tcpSettings' in ss or 'rawSettings' in ss):
            key='tcpSettings' if 'tcpSettings' in ss else 'rawSettings'
            obj=ss[key]
            obj['acceptProxyProtocol']=True
            hdr=obj.setdefault('header',{})
            hdr['type']='http'
            hdr.setdefault('request',{})['path']=['/']
            found+=1
    if not found:
        raise SystemExit(f'[ERROR] TCP/RAW inbound not found in {p}')
    p.write_text(json.dumps(data,indent=2)+'\n')

# Patch HAProxy from the unified transport build.
hp=pathlib.Path('/etc/haproxy/haproxy.cfg')
s=hp.read_text()
# Remove any previous version of these dedicated frontends first.
blocks=['xray_vless_tcp_tls','xray_vless_tcp_plain','xray_vmess_tcp_tls','xray_vmess_tcp_plain','xray_trojan_tcp_tls','xray_trojan_tcp_plain']
lines=s.splitlines(True)
out=[]
i=0
while i < len(lines):
    line=lines[i]
    if line.startswith('frontend ') and line.split()[1] in blocks:
        i+=1
        while i < len(lines) and not (lines[i].startswith('frontend ') or lines[i].startswith('backend ') or lines[i].startswith('listen ')):
            i+=1
        continue
    out.append(line); i+=1
s=''.join(out)
# Restore generic plain-port line first, then reserve dedicated TCP ports.
s=s.replace('    bind *:2082 tfo\n','')
s=s.replace('    bind *:2084-2199 tfo\n','    bind *:2084-2085 tfo\n    bind *:2088-2094 tfo\n    bind *:2097-2199 tfo\n')
# If an earlier hotfix already split the range, leave it as-is.
front='''# Dedicated RAW/TCP HTTP camouflage ingress.\n# Dedicated ports remove dependency on legacy TCP custom-path parsing.\nfrontend xray_vless_tcp_tls\n    mode tcp\n    bind *:2083 ssl crt /etc/haproxy/funny.pem tfo\n    default_backend XRAY_VLESS_TCP\n\nfrontend xray_vless_tcp_plain\n    mode tcp\n    bind *:2082 tfo\n    default_backend XRAY_VLESS_TCP\n\nfrontend xray_vmess_tcp_tls\n    mode tcp\n    bind *:2087 ssl crt /etc/haproxy/funny.pem tfo\n    default_backend XRAY_VMESS_TCP\n\nfrontend xray_vmess_tcp_plain\n    mode tcp\n    bind *:2086 tfo\n    default_backend XRAY_VMESS_TCP\n\nfrontend xray_trojan_tcp_tls\n    mode tcp\n    bind *:2096 ssl crt /etc/haproxy/funny.pem tfo\n    default_backend XRAY_TROJAN_TCP\n\nfrontend xray_trojan_tcp_plain\n    mode tcp\n    bind *:2095 tfo\n    default_backend XRAY_TROJAN_TCP\n\n'''
needle='\nbackend NGINX_H1\n'
pos=s.find(needle)
if pos < 0:
    raise SystemExit('[ERROR] backend NGINX_H1 not found in HAProxy config')
s=s[:pos+1]+front+s[pos+1:]
hp.write_text(s)

# Patch account output.
p=pathlib.Path('/usr/local/rere/xray-account')
s=p.read_text()
old="local p=$1 email=$2 c=$3 d=$4 tls='443' ntls='80' name=${email//@/%40}"
if old in s:
    s=s.replace(old, old+'''\n local tcp_tls tcp_ntls\n case "$p" in\n   vless) tcp_tls=2083; tcp_ntls=2082 ;;\n   vmess) tcp_tls=2087; tcp_ntls=2086 ;;\n   trojan) tcp_tls=2096; tcp_ntls=2095 ;;\n esac''',1)
elif 'vless) tcp_tls=2083; tcp_ntls=2082' not in s:
    raise SystemExit('[ERROR] Unexpected xray-account links() layout')
s=s.replace(' echo "Non-TLS Ports: 80-108, 2082, 8000, 8080-8180, 2084-2199"',
''' echo "Non-TLS Ports: 80-108, 8000, 8080-8180, 2084-2085, 2088-2094, 2097-2199"\n echo "TCP HTTP TLS     : $tcp_tls"\n echo "TCP HTTP Non-TLS : $tcp_ntls"''')
s=s.replace('vless://$c@$d:$tls?encryption=none&security=tls&sni=$d&type=tcp&headerType=http&path=%2Ftcpvless&host=$d#$name','vless://$c@$d:$tcp_tls?encryption=none&security=tls&sni=$d&type=tcp&headerType=http&path=%2F&host=$d#$name')
s=s.replace('vless://$c@$d:$ntls?encryption=none&security=none&type=tcp&headerType=http&path=%2Ftcpvless&host=$d#$name','vless://$c@$d:$tcp_ntls?encryption=none&security=none&type=tcp&headerType=http&path=%2F&host=$d#$name')
s=s.replace('trojan://$c@$d:$tls?security=tls&sni=$d&type=tcp&headerType=http&path=%2Ftcptrojan&host=$d#$name','trojan://$c@$d:$tcp_tls?security=tls&sni=$d&type=tcp&headerType=http&path=%2F&host=$d#$name')
s=s.replace('trojan://$c@$d:$ntls?security=none&type=tcp&headerType=http&path=%2Ftcptrojan&host=$d#$name','trojan://$c@$d:$tcp_ntls?security=none&type=tcp&headerType=http&path=%2F&host=$d#$name')
s=s.replace('echo "[TCP HTTP TLS]"; vm tcp /tcpvmess tls "$tls" http; echo','echo "[TCP HTTP TLS]"; vm tcp / tls "$tcp_tls" http; echo')
s=s.replace("echo \"[TCP HTTP Non-TLS]\"; vm tcp /tcpvmess '' \"$ntls\" http; echo","echo \"[TCP HTTP Non-TLS]\"; vm tcp / '' \"$tcp_ntls\" http; echo")
p.write_text(s)
PY

# Validate before touching running services.
echo "[INFO] Validating shell..."
bash -n /usr/local/rere/xray-account

XRAY_BIN=/usr/local/xray-new/xray
[[ -x "$XRAY_BIN" ]] || XRAY_BIN=$(command -v xray || true)
[[ -n "$XRAY_BIN" ]] || { echo "[ERROR] Xray binary not found."; exit 1; }
for p in vless vmess trojan; do
  echo "[INFO] Validating $p.json..."
  "$XRAY_BIN" run -test -config "/etc/funny/json/$p.json"
done

echo "[INFO] Validating HAProxy..."
haproxy -c -f /etc/haproxy/haproxy.cfg

# Permit dedicated ports on a local host firewall if one is being used.
if command -v iptables >/dev/null 2>&1; then
  for port in 2082 2083 2086 2087 2095 2096; do
    iptables -C INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -j ACCEPT
  done
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
fi
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
  for port in 2082 2083 2086 2087 2095 2096; do ufw allow "$port/tcp" >/dev/null; done
fi

echo "[INFO] Restarting Xray + HAProxy..."
systemctl restart xray-vless xray-vmess xray-trojan
systemctl restart haproxy

echo "[INFO] Listening TCP ports:"
ss -lntp | grep -E ':(2082|2083|2086|2087|2095|2096)\b' || true

echo
echo "[OK] TCP HTTP fix installed."
echo "VLESS : TLS 2083 | Non-TLS 2082 | path / | headerType http"
echo "VMess : TLS 2087 | Non-TLS 2086 | path / | headerType http"
echo "Trojan: TLS 2096 | Non-TLS 2095 | path / | headerType http"
echo "Backup: $BACKUP"
