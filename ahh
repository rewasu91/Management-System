#!/usr/bin/env bash
set -euo pipefail

STAMP=$(date +%Y%m%d-%H%M%S)
BKP="/root/xray-confdir-rename-backup-$STAMP"
mkdir -p "$BKP"

echo "[INFO] Backup: $BKP"
cp -a /etc/funny/xray "$BKP/funny-xray" 2>/dev/null || true
cp -a /etc/xray "$BKP/etc-xray" 2>/dev/null || true
cp -a /usr/local/rere/xray-account "$BKP/xray-account" 2>/dev/null || true
cp -a /etc/systemd/system/xray-vless.service /etc/systemd/system/xray-vmess.service /etc/systemd/system/xray-trojan.service "$BKP/" 2>/dev/null || true

rename_one() {
  local dir="$1" old="$2" new="$3"
  [[ -d "$dir" ]] || return 0
  if [[ -f "$dir/$old" ]]; then
    if [[ -f "$dir/$new" ]]; then
      # Prefer the active/new-style file; retain old copy in backup only.
      rm -f "$dir/$old"
    else
      mv "$dir/$old" "$dir/$new"
    fi
  fi
}

mkdir -p /etc/funny/xray
for p in vless vmess trojan; do
  # If only legacy /etc/xray/<proto> exists, migrate it first.
  if [[ ! -d "/etc/funny/xray/$p" && -d "/etc/xray/$p" ]]; then
    cp -a "/etc/xray/$p" "/etc/funny/xray/$p"
  fi
  mkdir -p "/etc/funny/xray/$p"
  rename_one "/etc/funny/xray/$p" '10-inbounds.json' 'inbounds.json'
  rename_one "/etc/funny/xray/$p" '20-outbounds.json' 'outbounds.json'
  rename_one "/etc/funny/xray/$p" '30-routing.json' 'routing.json'
  rename_one "/etc/funny/xray/$p" '40-core.json' 'core.json'
done

# Patch textual runtime scripts that may still point at numbered filenames.
for f in /usr/local/rere/xray-account /usr/local/rere/xray-setup /usr/local/rere/backup /usr/local/rere/restore; do
  [[ -f "$f" ]] || continue
  sed -i \
    -e 's#/10-inbounds\.json#/inbounds.json#g' \
    -e 's#/20-outbounds\.json#/outbounds.json#g' \
    -e 's#/30-routing\.json#/routing.json#g' \
    -e 's#/40-core\.json#/core.json#g' "$f"
done

# Patch any other plain-text helper scripts under /usr/local/rere.
while IFS= read -r -d '' f; do
  if file "$f" 2>/dev/null | grep -qiE 'text|script'; then
    sed -i \
      -e 's#/10-inbounds\.json#/inbounds.json#g' \
      -e 's#/20-outbounds\.json#/outbounds.json#g' \
      -e 's#/30-routing\.json#/routing.json#g' \
      -e 's#/40-core\.json#/core.json#g' "$f" || true
  fi
done < <(find /usr/local/rere -type f -print0 2>/dev/null)

# Ensure systemd uses /etc/funny/xray/<proto> confdirs.
for p in vless vmess trojan; do
  svc="/etc/systemd/system/xray-$p.service"
  if [[ -f "$svc" ]]; then
    sed -i -E "s#-confdir[ =]+/etc/xray/$p#-confdir /etc/funny/xray/$p#g" "$svc"
    sed -i -E "s#-confdir[ =]+/etc/funny/xray/$p/?#-confdir /etc/funny/xray/$p#g" "$svc"
  fi
done

# Verify there are no numbered config files left in the active confdir.
left=$(find /etc/funny/xray -type f \( -name '10-inbounds.json' -o -name '20-outbounds.json' -o -name '30-routing.json' -o -name '40-core.json' \) 2>/dev/null | wc -l)
if (( left != 0 )); then
  echo "[ERROR] Numbered config files still exist:"
  find /etc/funny/xray -type f \( -name '10-inbounds.json' -o -name '20-outbounds.json' -o -name '30-routing.json' -o -name '40-core.json' \)
  exit 1
fi

for p in vless vmess trojan; do
  for f in inbounds.json outbounds.json routing.json core.json; do
    [[ -s "/etc/funny/xray/$p/$f" ]] || { echo "[ERROR] Missing /etc/funny/xray/$p/$f"; exit 1; }
    jq empty "/etc/funny/xray/$p/$f"
  done
done

XRAY_BIN=/usr/local/xray-new/xray
[[ -x "$XRAY_BIN" ]] || XRAY_BIN=$(command -v xray || true)
[[ -n "$XRAY_BIN" && -x "$XRAY_BIN" ]] || { echo '[ERROR] Xray binary not found.'; exit 1; }

for p in vless vmess trojan; do
  echo "[INFO] Validating $p..."
  "$XRAY_BIN" run -test -confdir "/etc/funny/xray/$p" >/dev/null
 done

# Ensure runtime script no longer references old numbered names.
if grep -RniE '10-inbounds\.json|20-outbounds\.json|30-routing\.json|40-core\.json' /usr/local/rere 2>/dev/null | head -1 | grep -q .; then
  echo '[ERROR] A runtime helper still references numbered config names:'
  grep -RniE '10-inbounds\.json|20-outbounds\.json|30-routing\.json|40-core\.json' /usr/local/rere 2>/dev/null | head -20
  exit 1
fi

systemctl daemon-reload
systemctl restart xray-vless xray-vmess xray-trojan
for p in vless vmess trojan; do
  systemctl is-active --quiet "xray-$p" || { echo "[ERROR] xray-$p is not active"; exit 1; }
done

echo '[OK] Numbered Xray config filenames removed.'
echo '[OK] Active structure:'
find /etc/funny/xray -maxdepth 2 -type f -name '*.json' | sort
