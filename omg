#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "[ERROR] Run as root."; exit 1; }
CFG="/etc/haproxy/haproxy.cfg"
TS="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/haproxy-before-hu443-$TS.cfg"
cp -a "$CFG" "$BACKUP"
python3 - "$CFG" <<'PY'
from pathlib import Path
import re, sys
p=Path(sys.argv[1]); s=p.read_text()
s=re.sub(r'# === DEDICATED TLS 443 FOR WEBSOCKET \+ HTTPUPGRADE.*?(?=frontend multipurpose_tls)', '', s, flags=re.S)
s=s.replace('    bind *:400-777 tfo\n','    bind *:400-442 tfo\n    bind *:444-777 tfo\n')
s=re.sub(r'(?m)^[ \t]*bind \*:443(?:\s+[^\n]*)?\n','',s)
idx=s.find('frontend multipurpose_tls')
if idx < 0:
    raise SystemExit('[ERROR] frontend multipurpose_tls not found')
block='''# === DEDICATED TLS 443 FOR WEBSOCKET + HTTPUPGRADE
frontend tls443_http1
    mode http
    bind *:443 ssl crt /etc/haproxy/funny.pem alpn http/1.1
    option httplog
    default_backend MULTIPLEWS

# === FRONTEND MULTIPURPOSE TLS PORTS (except 443)
'''
s=s[:idx]+block+s[idx:]
p.write_text(s)
PY

echo "[INFO] Backup: $BACKUP"
if ! haproxy -c -f "$CFG"; then
  echo "[ERROR] HAProxy validation failed. Restoring..."
  cp -a "$BACKUP" "$CFG"
  exit 1
fi
nginx -t
systemctl restart haproxy
systemctl restart nginx
systemctl restart xray-hu

echo
echo "[OK] 443 now forces ALPN http/1.1 for WebSocket + HTTPUpgrade."
echo "[INFO] gRPC must use another TLS port such as 8443, 8999, 9443 or 9755."
echo
ss -lntp | grep -E ':(443|8001|8002|8003)\b' || true
