#!/usr/bin/env bash
set -euo pipefail

HAP=/etc/haproxy/haproxy.cfg
NGMAIN=/etc/funny/nginx/main.conf
TS=$(date +%Y%m%d-%H%M%S)
BACKUP=/root/xray-tls-passthrough-$TS

[[ $EUID -eq 0 ]] || { echo "[ERROR] Run as root"; exit 1; }
[[ -f "$HAP" ]] || { echo "[ERROR] $HAP not found"; exit 1; }
[[ -f "$NGMAIN" ]] || { echo "[ERROR] $NGMAIN not found"; exit 1; }

mkdir -p "$BACKUP"
cp -a "$HAP" "$BACKUP/haproxy.cfg"
cp -a "$NGMAIN" "$BACKUP/main.conf"

grep -Eq '^[[:space:]]*listen[[:space:]]+18050[[:space:]]+ssl' "$NGMAIN" || {
  echo "[ERROR] Nginx TLS listener 18050 not found"
  exit 1
}

python3 - "$HAP" <<'PY'
from pathlib import Path
import re, sys
p=Path(sys.argv[1])
s=p.read_text()

# Remove previous dedicated blocks.
s=re.sub(r'(?ms)^# === DEDICATED TLS 443 FOR WEBSOCKET \+ HTTPUPGRADE.*?(?=^frontend |\Z)','',s)
s=re.sub(r'(?ms)^# === DEDICATED 443 TCP PASSTHROUGH TO NGINX TLS.*?(?=^frontend |\Z)','',s)
s=re.sub(r'(?ms)^# === XRAY TLS PASSTHROUGH PORTS.*?(?=^frontend |\Z)','',s)

# Remove target bind lines from all existing frontends.
targets=[443,8443,8999,9443,9755]
lines=[]
for line in s.splitlines(True):
    st=line.strip()
    if st.startswith('bind '):
        if any(f'*:{p}' in st for p in targets):
            continue
        if '*:400-777' in st or '*:400-442' in st or '*:444-777' in st:
            continue
    lines.append(line)
s=''.join(lines)

m=re.search(r'(?m)^frontend[ \t]+',s)
if not m:
    raise SystemExit('[ERROR] No HAProxy frontend found')

block='''# === XRAY TLS PASSTHROUGH PORTS
frontend xray_tls_passthrough
    mode tcp
    bind *:443
    bind *:8443
    bind *:8999
    bind *:9443
    bind *:9755
    bind *:400-777
    option tcplog
    timeout client 1h
    default_backend NGINX_TLS_18050

'''
s=s[:m.start()]+block+s[m.start():]

s=re.sub(r'(?ms)^backend[ \t]+NGINX_TLS_18050\b.*?(?=^backend |^frontend |\Z)','',s)
s=s.rstrip()+'''\n\nbackend NGINX_TLS_18050\n    mode tcp\n    timeout connect 10s\n    timeout server 1h\n    server nginx_tls 127.0.0.1:18050 check\n'''
p.write_text(s+'\n')
PY

echo "[INFO] Validating Nginx..."
nginx -t

echo "[INFO] Validating HAProxy..."
if ! haproxy -c -f "$HAP"; then
  echo "[ERROR] HAProxy validation failed; restoring backup"
  cp -a "$BACKUP/haproxy.cfg" "$HAP"
  exit 1
fi

systemctl restart nginx
systemctl restart xray-hu || true
systemctl restart xray-ws || true
systemctl restart xray-grpc || true
systemctl restart haproxy

echo
echo "[OK] TLS passthrough enabled for:"
echo "443, 8443, 8999, 9443, 9755, 400-777"
echo
echo "[INFO] Key listeners:"
ss -lntp | grep -E ':(443|8443|8999|9443|9755|18050|8001|8002|8003)\\b' || true
echo
echo "[INFO] HAProxy block:"
grep -nA15 -B2 'xray_tls_passthrough\|NGINX_TLS_18050' "$HAP" || true
echo
echo "[INFO] Backup: $BACKUP"
echo
echo "Test example:"
DOMAIN=$(cat /etc/xray/domain 2>/dev/null || echo YOUR-DOMAIN)
echo "curl -vk --http1.1 -H 'Host: $DOMAIN' -H 'Connection: Upgrade' -H 'Upgrade: websocket' https://$DOMAIN:8443/hu-vless"
echo
echo "Expected: HTTP/1.1 101 Switching Protocols"
