#!/usr/bin/env bash
set -euo pipefail

STAMP=$(date +%Y%m%d-%H%M%S)
BKP="/root/xray-funny-confdir-backup-$STAMP"
mkdir -p "$BKP"
echo "[INFO] Backup: $BKP"
cp -a /etc/xray "$BKP/xray" 2>/dev/null || true
cp -a /etc/funny "$BKP/funny" 2>/dev/null || true
cp -a /etc/systemd/system/xray-vless.service /etc/systemd/system/xray-vmess.service /etc/systemd/system/xray-trojan.service "$BKP/" 2>/dev/null || true

mkdir -p /etc/funny/xray
for p in vless vmess trojan; do
  if [[ -d "/etc/xray/$p" ]]; then
    rm -rf "/etc/funny/xray/$p.new"
    cp -a "/etc/xray/$p" "/etc/funny/xray/$p.new"
    rm -rf "/etc/funny/xray/$p"
    mv "/etc/funny/xray/$p.new" "/etc/funny/xray/$p"
  elif [[ ! -d "/etc/funny/xray/$p" ]]; then
    echo "[ERROR] Missing config directory for $p"; exit 1
  fi
done

mkdir -p '/usr/local/rere'
printf '%s' '' | base64 -d > '/usr/local/rere/xray-account'
chmod +x '/usr/local/rere/xray-account'
mkdir -p '/usr/local/rere'
printf '%s' '' | base64 -d > '/usr/local/rere/backup'
chmod +x '/usr/local/rere/backup'
mkdir -p '/usr/local/rere'
printf '%s' '' | base64 -d > '/usr/local/rere/restore'
chmod +x '/usr/local/rere/restore'
mkdir -p '/usr/local/rere'
printf '%s' '' | base64 -d > '/usr/local/rere/xray-setup'
chmod +x '/usr/local/rere/xray-setup'
mkdir -p '/etc/systemd/system'
printf '%s' '' | base64 -d > '/etc/systemd/system/xray-vless.service'
mkdir -p '/etc/systemd/system'
printf '%s' '' | base64 -d > '/etc/systemd/system/xray-vmess.service'
mkdir -p '/etc/systemd/system'
printf '%s' '' | base64 -d > '/etc/systemd/system/xray-trojan.service'

chmod 644 /etc/funny/xray/vless/*.json /etc/funny/xray/vmess/*.json /etc/funny/xray/trojan/*.json
echo "[INFO] Validating Xray split configs..."
for p in vless vmess trojan; do /usr/local/xray-new/xray run -test -confdir "/etc/funny/xray/$p" >/dev/null || { echo "[ERROR] $p validation failed"; exit 1; }; done
systemctl daemon-reload
systemctl restart xray-vless xray-vmess xray-trojan
for p in vless vmess trojan; do systemctl is-active --quiet "xray-$p" || { echo "[ERROR] xray-$p is not active"; exit 1; }; done
# Keep old confdirs as migration backup instead of deleting immediately.
if [[ -d /etc/xray/vless || -d /etc/xray/vmess || -d /etc/xray/trojan ]]; then
  mkdir -p "/etc/xray/legacy-confdir-$STAMP"
  for p in vless vmess trojan; do [[ -d "/etc/xray/$p" ]] && mv "/etc/xray/$p" "/etc/xray/legacy-confdir-$STAMP/$p"; done
fi
echo "[OK] Xray configs moved to /etc/funny/xray/"
echo "[OK] Account output now uses username only and plain / paths."
echo "[OK] Backup/restore now includes all critical account state plus consistent SQLite snapshot."
