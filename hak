#!/usr/bin/env bash
set -euo pipefail
RERE=/usr/local/rere
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/kaizensc-multi-fix-backup-${STAMP}"

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Please run as root."; exit 1; }
[[ -d "$RERE" ]] || { echo "KaizenSC not found: $RERE"; exit 1; }
mkdir -p "$BACKUP/rere"


[[ -f "$RERE/kaizen-ui" ]] && cp -a "$RERE/kaizen-ui" "$BACKUP/rere/kaizen-ui" || true
cat > "$RERE/kaizen-ui" <<'__KZN_KAIZEN_UI__'
#!/usr/bin/env bash
# Shared KaizenSC submenu/action header.
KUI_CYAN='\e[0;36m'
KUI_WHITE='\e[0;97m'
KUI_PLAIN='\e[0m'
KUI_BG='\e[0;47;30m'
kaizen_repeat(){
  local ch="$1" n="$2" out='' i
  for ((i=0;i<n;i++)); do out+="$ch"; done
  printf '%s' "$out"
}
kaizen_header(){
  local title="$1" width=49 len left right line
  len=${#title}
  (( len > width )) && width=$len
  left=$(( (width-len)/2 )); right=$(( width-len-left ))
  line=$(kaizen_repeat '─' "$width")
  printf '%b┌%s┐%b\n' "$KUI_CYAN" "$line" "$KUI_PLAIN"
  printf '%b│%b%b%*s%s%*s%b%b│%b\n' "$KUI_CYAN" "$KUI_PLAIN" "$KUI_BG" "$left" '' "$title" "$right" '' "$KUI_PLAIN" "$KUI_CYAN" "$KUI_PLAIN"
  printf '%b└%s┘%b\n\n' "$KUI_CYAN" "$line" "$KUI_PLAIN"
  printf '%b' "$KUI_WHITE"
}

kaizen_result_header(){
  clear
  kaizen_header " • $1 • "
}

# Compact account tables + runtime Adjust Text Brightness support.
kaizen_text_mode(){ local f=/etc/kaizensc/text-brightness.conf; [[ -r "$f" ]] && cat "$f" 2>/dev/null || printf 'normal'; }
kaizen_sgr(){ local c="$1" m; m=$(kaizen_text_mode); [[ "$m" == bold ]] && printf '\e[1;%sm' "$c" || printf '\e[0;%sm' "$c"; }
kaizen_table_colour(){ kaizen_sgr 36; }; kaizen_text_colour(){ kaizen_sgr 97; }
kaizen_green(){ kaizen_sgr 32; }; kaizen_red(){ kaizen_sgr 31; }; kaizen_yellow(){ kaizen_sgr 33; }; kaizen_reset(){ printf '\e[0m'; }
kaizen_is_ssh_account_user(){
 local u="$1" e uid
 [[ -n "$u" && "$u" != syslog && "$u" != nobody ]] || return 1
 e=$(getent passwd "$u" 2>/dev/null || true); [[ -n "$e" ]] || return 1
 uid=$(printf '%s' "$e"|awk -F: '{print $3}'); [[ "$uid" =~ ^[0-9]+$ ]] || return 1
 (( uid >= 1000 && uid != 65534 ))
}
kaizen_repeat_line(){ local ch="$1" n="$2" out='' i; for ((i=0;i<n;i++)); do out+="$ch"; done; printf '%s' "$out"; }

# Minimum widths requested by KaizenSC. Columns automatically grow when data
# is longer, so values are never truncated just to fit the default box.
KZN_SSH_USER_W=16
KZN_SSH_EXP_W=11
KZN_SSH_IP_W=2
KZN_XRAY_USER_W=16
KZN_XRAY_EXP_W=11
KZN_XRAY_QUOTA_W=7
KZN_XRAY_IP_W=2

kaizen_fmt_bytes_table(){
 local b="${1:-0}"
 [[ "$b" =~ ^[0-9]+$ ]] || b=0
 awk -v b="$b" 'BEGIN {
   if (b >= 1073741824) {v=b/1073741824; u="GB"}
   else if (b >= 1048576) {v=b/1048576; u="MB"}
   else if (b >= 1024) {v=b/1024; u="KB"}
   else {v=b; u="B"}
   if (v == int(v)) printf "%.0f %s", v, u;
   else if (v < 10) printf "%.2f %s", v, u;
   else printf "%.1f %s", v, u;
 }'
}

kaizen_ssh_table_prepare(){
 KZN_SSH_USER_W=16; KZN_SSH_EXP_W=11; KZN_SSH_IP_W=2
 local db=/etc/kaizensc/database/ssh/database.json u exp lim iptxt n
 [[ -s "$db" ]] || return 0
 while IFS=$'\t' read -r u exp lim; do
   kaizen_is_ssh_account_user "$u" || continue
   exp="${exp%% *}"
   [[ "$lim" =~ ^[0-9]+$ ]] || lim=0
   (( lim > 0 )) && iptxt="$lim" || iptxt='UL'
   n=${#u}; (( n > KZN_SSH_USER_W )) && KZN_SSH_USER_W=$n
   n=${#exp}; (( n > KZN_SSH_EXP_W )) && KZN_SSH_EXP_W=$n
   n=${#iptxt}; (( n > KZN_SSH_IP_W )) && KZN_SSH_IP_W=$n
 done < <(jq -r '.[] | [.Username, (.Expired // "Lifetime"), (.LimitIP // 0)] | @tsv' "$db" 2>/dev/null)
}

kaizen_xray_table_prepare(){
 local proto="${1:-}" db=/etc/kaizensc/database/xray/accounts.db email u exp lim quota iptxt qtxt n
 KZN_XRAY_USER_W=16; KZN_XRAY_EXP_W=11; KZN_XRAY_QUOTA_W=7; KZN_XRAY_IP_W=2
 [[ -n "$proto" && -s "$db" ]] || return 0
 while IFS='|' read -r email exp lim quota; do
   [[ -n "$email" ]] || continue
   u="${email%@*}"; exp="${exp%% *}"
   [[ "$lim" =~ ^[0-9]+$ ]] || lim=0
   [[ "$quota" =~ ^[0-9]+$ ]] || quota=0
   (( lim > 0 )) && iptxt="$lim" || iptxt='UL'
   (( quota > 0 )) && qtxt="$(kaizen_fmt_bytes_table "$quota")" || qtxt='UL'
   n=${#u}; (( n > KZN_XRAY_USER_W )) && KZN_XRAY_USER_W=$n
   n=${#exp}; (( n > KZN_XRAY_EXP_W )) && KZN_XRAY_EXP_W=$n
   n=${#qtxt}; (( n > KZN_XRAY_QUOTA_W )) && KZN_XRAY_QUOTA_W=$n
   n=${#iptxt}; (( n > KZN_XRAY_IP_W )) && KZN_XRAY_IP_W=$n
 done < <(sqlite3 -separator '|' "$db" "SELECT email,expired,ip_limit,quota_bytes FROM accounts WHERE protocol='$proto' ORDER BY email;" 2>/dev/null)
}

kaizen_ssh_table_header(){
 kaizen_ssh_table_prepare
 local c r bg='\e[0;47;30m' a b d
 c=$(kaizen_table_colour); r=$(kaizen_reset)
 a=$(kaizen_repeat_line '─' $((KZN_SSH_USER_W+2)))
 b=$(kaizen_repeat_line '─' $((KZN_SSH_EXP_W+2)))
 d=$(kaizen_repeat_line '─' $((KZN_SSH_IP_W+2)))
 printf '%b┌%s┬%s┬%s┐%b\n' "$c" "$a" "$b" "$d" "$r"
 printf '%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b\n' \
   "$c" "$r" "$bg" "$KZN_SSH_USER_W" Username "$r" "$c" \
   "$r" "$bg" "$KZN_SSH_EXP_W" "Expire Date" "$r" "$c" \
   "$r" "$bg" "$KZN_SSH_IP_W" "IP" "$r" "$c" "$r"
 printf '%b├%s┼%s┼%s┤%b\n' "$c" "$a" "$b" "$d" "$r"
}
kaizen_ssh_table_row(){
 local c w r exp; c=$(kaizen_table_colour); w=$(kaizen_text_colour); r=$(kaizen_reset); exp="${2%% *}"
 printf '%b│%b %-*s %b│%b %-*s %b│%b %-*s %b│%b\n' \
   "$c" "$w" "$KZN_SSH_USER_W" "$1" "$c" \
   "$w" "$KZN_SSH_EXP_W" "$exp" "$c" \
   "$w" "$KZN_SSH_IP_W" "$3" "$c" "$r"
}
kaizen_ssh_table_total_row(){
  local total="$1" c w y r inner
  c=$(kaizen_table_colour); w=$(kaizen_text_colour); y=$(kaizen_yellow); r=$(kaizen_reset)
  inner=$((KZN_SSH_USER_W + KZN_SSH_EXP_W + KZN_SSH_IP_W + 8))
  printf '%b├%s┴%s┴%s┤%b\n' "$c" \
    "$(kaizen_repeat_line '─' $((KZN_SSH_USER_W+2)))" \
    "$(kaizen_repeat_line '─' $((KZN_SSH_EXP_W+2)))" \
    "$(kaizen_repeat_line '─' $((KZN_SSH_IP_W+2)))" "$r"
  printf '%b│%b Total User : %b%-*s%b│%b\n' "$c" "$w" "$y" "$((inner-14))" "$total" "$c" "$r"
  printf '%b└%s┘%b\n' "$c" "$(kaizen_repeat_line '─' "$inner")" "$r"
}
kaizen_ssh_table_footer(){
 local c r a b d; c=$(kaizen_table_colour); r=$(kaizen_reset)
 a=$(kaizen_repeat_line '─' $((KZN_SSH_USER_W+2)))
 b=$(kaizen_repeat_line '─' $((KZN_SSH_EXP_W+2)))
 d=$(kaizen_repeat_line '─' $((KZN_SSH_IP_W+2)))
 printf '%b└%s┴%s┴%s┘%b\n' "$c" "$a" "$b" "$d" "$r"
}

kaizen_xray_table_header(){
 local proto="${1:-}" c r bg='\e[0;47;30m' a b q d
 kaizen_xray_table_prepare "$proto"
 c=$(kaizen_table_colour); r=$(kaizen_reset)
 a=$(kaizen_repeat_line '─' $((KZN_XRAY_USER_W+2)))
 b=$(kaizen_repeat_line '─' $((KZN_XRAY_EXP_W+2)))
 q=$(kaizen_repeat_line '─' $((KZN_XRAY_QUOTA_W+2)))
 d=$(kaizen_repeat_line '─' $((KZN_XRAY_IP_W+2)))
 printf '%b┌%s┬%s┬%s┬%s┐%b\n' "$c" "$a" "$b" "$q" "$d" "$r"
 printf '%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b\n' \
   "$c" "$r" "$bg" "$KZN_XRAY_USER_W" Username "$r" "$c" \
   "$r" "$bg" "$KZN_XRAY_EXP_W" "Expire Date" "$r" "$c" \
   "$r" "$bg" "$KZN_XRAY_QUOTA_W" Quota "$r" "$c" \
   "$r" "$bg" "$KZN_XRAY_IP_W" IP "$r" "$c" "$r"
 printf '%b├%s┼%s┼%s┼%s┤%b\n' "$c" "$a" "$b" "$q" "$d" "$r"
}
kaizen_xray_table_row(){
 local c w r exp
 c=$(kaizen_table_colour); w=$(kaizen_text_colour); r=$(kaizen_reset)
 exp="${2%% *}"
 printf '%b│%b %-*s %b│%b %-*s %b│%b %-*s %b│%b %-*s %b│%b\n' \
   "$c" "$w" "$KZN_XRAY_USER_W" "$1" "$c" \
   "$w" "$KZN_XRAY_EXP_W" "$exp" "$c" \
   "$w" "$KZN_XRAY_QUOTA_W" "$3" "$c" \
   "$w" "$KZN_XRAY_IP_W" "$4" "$c" "$r"
}

kaizen_xray_table_total_row(){
  local total="$1" c w y r inner
  c=$(kaizen_table_colour); w=$(kaizen_text_colour); y=$(kaizen_yellow); r=$(kaizen_reset)
  inner=$((KZN_XRAY_USER_W + KZN_XRAY_EXP_W + KZN_XRAY_QUOTA_W + KZN_XRAY_IP_W + 11))
  printf '%b├%s┴%s┴%s┴%s┤%b\n' "$c" \
    "$(kaizen_repeat_line '─' $((KZN_XRAY_USER_W+2)))" \
    "$(kaizen_repeat_line '─' $((KZN_XRAY_EXP_W+2)))" \
    "$(kaizen_repeat_line '─' $((KZN_XRAY_QUOTA_W+2)))" \
    "$(kaizen_repeat_line '─' $((KZN_XRAY_IP_W+2)))" "$r"
  printf '%b│%b Total User : %b%-*s%b│%b\n' "$c" "$w" "$y" "$((inner-14))" "$total" "$c" "$r"
  printf '%b└%s┘%b\n' "$c" "$(kaizen_repeat_line '─' "$inner")" "$r"
}
kaizen_xray_table_footer(){
 local c r a b q d; c=$(kaizen_table_colour); r=$(kaizen_reset)
 a=$(kaizen_repeat_line '─' $((KZN_XRAY_USER_W+2)))
 b=$(kaizen_repeat_line '─' $((KZN_XRAY_EXP_W+2)))
 q=$(kaizen_repeat_line '─' $((KZN_XRAY_QUOTA_W+2)))
 d=$(kaizen_repeat_line '─' $((KZN_XRAY_IP_W+2)))
 printf '%b└%s┴%s┴%s┴%s┘%b\n' "$c" "$a" "$b" "$q" "$d" "$r"
}
kaizen_total_users(){ local y w r; y=$(kaizen_yellow); w=$(kaizen_text_colour); r=$(kaizen_reset); printf '\n%bTotal User : %b%s%b\n' "$w" "$y" "$1" "$r"; }

KZN_UNLOCK_USER_W=16
KZN_UNLOCK_EXP_W=11
KZN_UNLOCK_REASON_W=10
kaizen_unlock_table_header(){
 local c r bg='\e[0;47;30m' a b d
 c=$(kaizen_table_colour); r=$(kaizen_reset)
 a=$(kaizen_repeat_line '─' $((KZN_UNLOCK_USER_W+2))); b=$(kaizen_repeat_line '─' $((KZN_UNLOCK_EXP_W+2))); d=$(kaizen_repeat_line '─' $((KZN_UNLOCK_REASON_W+2)))
 printf '%b┌%s┬%s┬%s┐%b\n' "$c" "$a" "$b" "$d" "$r"
 printf '%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b\n' "$c" "$r" "$bg" "$KZN_UNLOCK_USER_W" Username "$r" "$c" "$r" "$bg" "$KZN_UNLOCK_EXP_W" "Expire Date" "$r" "$c" "$r" "$bg" "$KZN_UNLOCK_REASON_W" Reason "$r" "$c" "$r"
 printf '%b├%s┼%s┼%s┤%b\n' "$c" "$a" "$b" "$d" "$r"
}
kaizen_unlock_table_row(){ local c w r; c=$(kaizen_table_colour); w=$(kaizen_text_colour); r=$(kaizen_reset); printf '%b│%b %-*s %b│%b %-*s %b│%b %-*s %b│%b\n' "$c" "$w" "$KZN_UNLOCK_USER_W" "$1" "$c" "$w" "$KZN_UNLOCK_EXP_W" "${2%% *}" "$c" "$w" "$KZN_UNLOCK_REASON_W" "${3:-Manual}" "$c" "$r"; }
kaizen_unlock_table_footer(){ local c r a b d; c=$(kaizen_table_colour); r=$(kaizen_reset); a=$(kaizen_repeat_line '─' $((KZN_UNLOCK_USER_W+2))); b=$(kaizen_repeat_line '─' $((KZN_UNLOCK_EXP_W+2))); d=$(kaizen_repeat_line '─' $((KZN_UNLOCK_REASON_W+2))); printf '%b└%s┴%s┴%s┘%b\n' "$c" "$a" "$b" "$d" "$r"; }

__KZN_KAIZEN_UI__
chmod 0755 "$RERE/kaizen-ui"
bash -n "$RERE/kaizen-ui"

[[ -f "$RERE/lock-ssh" ]] && cp -a "$RERE/lock-ssh" "$BACKUP/rere/lock-ssh" || true
cat > "$RERE/lock-ssh" <<'__KZN_LOCK_SSH__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
set -u
DB=/etc/kaizensc/database/ssh/database.json
RED='\e[0;31m'; GREEN='\e[0;32m'; NC='\e[0m'
[[ -s "$DB" ]] || { echo 'No SSH account found.'; exit 0; }
# normalize Locked field
jq 'map((if has("Locked") then . else . + {Locked:false} end) | (if has("LockReason") then . else . + {LockReason:""} end))' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
clear
kaizen_header " • Lock SSH Account • "
kaizen_ssh_table_header
jq -r '.[] | select((.Locked // false)==false) | [.Username,(.Expired//"Lifetime"),(.LimitIP//0)] | @tsv' "$DB" | while IFS=$'\t' read -r u e l; do
 kaizen_is_ssh_account_user "$u" || continue
 [[ "$l" =~ ^[0-9]+$ ]] || l=0
 (( l > 0 )) && ltxt="$l" || ltxt='UL'
 kaizen_ssh_table_row "$u" "$e" "$ltxt"
done
kaizen_ssh_table_footer
count=0
while read -r u; do kaizen_is_ssh_account_user "$u" && count=$((count+1)); done < <(jq -r '.[]|select((.Locked//false)==false)|.Username' "$DB")
((count>0)) || { echo 'No unlocked SSH account.'; exit 0; }
read -rp 'Input Username: ' user
kaizen_is_ssh_account_user "$user" || { echo '[ERROR] SSH account not found.'; exit 1; }
exists=$(jq -r --arg u "$user" '.[]|select(.Username==$u and ((.Locked//false)==false))|.Username' "$DB" | head -1)
[[ -n "$exists" ]] || { echo -e "${RED}Account not found or already locked.${NC}"; exit 1; }
read -rp "Reason [Manual]: " reason
reason=${reason:-Manual}
read -rp "Lock SSH account '$user'? (y/n): " yn
[[ "$yn" =~ ^[Yy]$ ]] || { echo 'Cancelled.'; exit 0; }
passwd -l "$user" >/dev/null 2>&1 || usermod -L "$user" >/dev/null 2>&1 || true
jq --arg u "$user" --arg r "$reason" 'map(if .Username==$u then .Locked=true | .LockReason=$r else . end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
mkdir -p /etc/kaizensc/recovery/ssh
printf '%s\tLOCK\t%s\t%s\n' "$user" "$reason" "$(date '+%F %T')" >> /etc/kaizensc/recovery/ssh/recovery.tsv
kaizen_result_header "SSH ACCOUNT LOCKED"
echo "Account : $user"
echo "Reason  : $reason"
echo "Status  : LOCKED"

__KZN_LOCK_SSH__
chmod 0755 "$RERE/lock-ssh"
bash -n "$RERE/lock-ssh"

[[ -f "$RERE/unlock-ssh" ]] && cp -a "$RERE/unlock-ssh" "$BACKUP/rere/unlock-ssh" || true
cat > "$RERE/unlock-ssh" <<'__KZN_UNLOCK_SSH__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
set -u
DB=/etc/kaizensc/database/ssh/database.json
RED='\e[0;31m'; GREEN='\e[0;32m'; NC='\e[0m'
[[ -s "$DB" ]] || { echo 'No locked SSH account.'; exit 0; }
jq 'map((if has("Locked") then . else . + {Locked:false} end) | (if has("LockReason") then . else . + {LockReason:""} end))' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
count=0
while read -r u; do kaizen_is_ssh_account_user "$u" && count=$((count+1)); done < <(jq -r '.[]|select((.Locked//false)==true)|.Username' "$DB")
((count>0)) || { clear; echo 'No locked SSH account.'; exit 0; }
clear
kaizen_header " • Unlock SSH Account • "
KZN_UNLOCK_USER_W=16; KZN_UNLOCK_EXP_W=11; KZN_UNLOCK_REASON_W=10
while IFS=$'\t' read -r u e reason; do
 kaizen_is_ssh_account_user "$u" || continue; e="${e%% *}"; reason=${reason:-Manual}
 ((${#u}>KZN_UNLOCK_USER_W)) && KZN_UNLOCK_USER_W=${#u}; ((${#e}>KZN_UNLOCK_EXP_W)) && KZN_UNLOCK_EXP_W=${#e}; ((${#reason}>KZN_UNLOCK_REASON_W)) && KZN_UNLOCK_REASON_W=${#reason}
done < <(jq -r '.[] | select((.Locked//false)==true) | [.Username,(.Expired//"Lifetime"),(.LockReason//"Manual")] | @tsv' "$DB")
kaizen_unlock_table_header
while IFS=$'\t' read -r u e reason; do kaizen_is_ssh_account_user "$u" || continue; kaizen_unlock_table_row "$u" "$e" "${reason:-Manual}"; done < <(jq -r '.[] | select((.Locked//false)==true) | [.Username,(.Expired//"Lifetime"),(.LockReason//"Manual")] | @tsv' "$DB")
kaizen_unlock_table_footer
read -rp 'Input Username: ' user
kaizen_is_ssh_account_user "$user" || { echo '[ERROR] SSH account not found.'; exit 1; }
exists=$(jq -r --arg u "$user" '.[]|select(.Username==$u and ((.Locked//false)==true))|.Username' "$DB" | head -1)
[[ -n "$exists" ]] || { echo -e "${RED}Locked account not found.${NC}"; exit 1; }
mapfile -t recent_ips < <(journalctl -u ssh -u sshd --no-pager 2>/dev/null | grep -E "Accepted .* for ${user} " | grep -oE 'from ([0-9a-fA-F:.]+)' | awk '{print $2}' | sort -u)
usermod -U "$user" >/dev/null 2>&1 || true
passwd -u "$user" >/dev/null 2>&1 || true
command -v faillock >/dev/null 2>&1 && faillock --user "$user" --reset >/dev/null 2>&1 || true
command -v pam_tally2 >/dev/null 2>&1 && pam_tally2 --user "$user" --reset >/dev/null 2>&1 || true
if command -v fail2ban-client >/dev/null 2>&1; then
  jails=$(fail2ban-client status 2>/dev/null | sed -n 's/.*Jail list:[[:space:]]*//p')
  IFS=',' read -ra jail_arr <<< "$jails"
  for jail in "${jail_arr[@]}"; do
    jail=$(echo "$jail" | xargs); [[ -n "$jail" ]] || continue
    for ip in "${recent_ips[@]}"; do fail2ban-client set "$jail" unbanip "$ip" >/dev/null 2>&1 || true; done
  done
fi
jq --arg u "$user" 'map(if .Username==$u then .Locked=false | .LockReason="" else . end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
mkdir -p /etc/kaizensc/recovery/ssh
printf '%s\tUNLOCK\t%s\n' "$user" "$(date '+%F %T')" >> /etc/kaizensc/recovery/ssh/recovery.tsv
kaizen_result_header "SSH ACCOUNT UNLOCKED"
echo "Account : $user"
echo "Status  : UNLOCKED"
echo "Login/IP History : CLEARED"

__KZN_UNLOCK_SSH__
chmod 0755 "$RERE/unlock-ssh"
bash -n "$RERE/unlock-ssh"

[[ -f "$RERE/delete-ssh" ]] && cp -a "$RERE/delete-ssh" "$BACKUP/rere/delete-ssh" || true
cat > "$RERE/delete-ssh" <<'__KZN_DELETE_SSH__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
set -u
DB=/etc/kaizensc/database/ssh/database.json
[[ -s "$DB" ]] || { echo 'No SSH account found.'; exit 0; }
clear
kaizen_header " • Delete SSH Account • "
kaizen_ssh_table_header
jq -r '.[]|[.Username,(.Expired//"Lifetime"),(.LimitIP//0)] | @tsv' "$DB" | while IFS=$'\t' read -r u e l; do
 kaizen_is_ssh_account_user "$u" || continue
 [[ "$l" =~ ^[0-9]+$ ]] || l=0
 (( l > 0 )) && ltxt="$l" || ltxt='UL'
 kaizen_ssh_table_row "$u" "$e" "$ltxt"
done
kaizen_ssh_table_footer
read -rp 'Input Username: ' user
kaizen_is_ssh_account_user "$user" || { echo '[ERROR] SSH account not found.'; exit 1; }
jq -e --arg u "$user" '.[]|select(.Username==$u)' "$DB" >/dev/null || { echo '[ERROR] Account not found.'; exit 1; }
read -rp "Delete SSH account '$user'? (y/n): " yn
[[ "$yn" =~ ^[Yy]$ ]] || { echo 'Cancelled.'; exit 0; }
userdel -f -r "$user" >/dev/null 2>&1 || true
rm -f /etc/kaizensc/limit/ssh/{ip,cache,quota,usage}/"$user" 2>/dev/null || true
jq --arg u "$user" 'map(select(.Username!=$u))' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
kaizen_result_header "SSH ACCOUNT DELETED"
