[[ -f /etc/crontab ]] && cp -a /etc/crontab "$BACKUP/crontab" || true
if [[ -f /etc/crontab ]] && ! grep -q '/usr/local/rere/xp-wireguard' /etc/crontab; then
  echo '*/15 * * * * root /usr/local/rere/xp-wireguard >/dev/null 2>&1' >> /etc/crontab
fi
systemctl restart cron >/dev/null 2>&1 || true

# Preserve current text-brightness selection; default to Normal if no state exists.
mkdir -p /etc/kaizensc
[[ -s /etc/kaizensc/text-brightness.conf ]] || printf 'normal\n' > /etc/kaizensc/text-brightness.conf

# Runtime UI sanity checks.
source "$RERE/kaizen-ui"
for fn in kaizen_xray_table_header kaizen_xray_table_row kaizen_unlock_table_header kaizen_unlock_table_row; do
  declare -F "$fn" >/dev/null || { echo "Missing UI helper: $fn"; exit 1; }
done

echo
echo "Patch installed successfully."
echo "Backup: $BACKUP"
echo "Main changes: SSH/Xray lock-unlock, Shadowsocks, Wireguard manager, ZiVPN UI, Extra Protocol/FastDNS, UDP menus, port detail and rebuild reboot flow."
