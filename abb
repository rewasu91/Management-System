#!/usr/bin/env bash
set -euo pipefail

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo '[ERROR] Please run this patch as root.' >&2
  exit 1
fi

if [[ ! -d /usr/local/rere ]]; then
  echo '[ERROR] /usr/local/rere not found. KaizenSC does not appear to be installed.' >&2
  exit 1
fi

BACKUP_DIR="/root/kaizensc-patch-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP_DIR"
for f in /usr/local/rere/adjust-text-brightness /usr/local/rere/bot-menu; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP_DIR/"
done

if ! command -v python3 >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -y
  apt-get install -y python3
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
base64 -d > "$TMP/payload.tar.gz" <<'PAYLOAD_EOF'

PAYLOAD_EOF

tar -xzf "$TMP/payload.tar.gz" -C /
chmod +x /usr/local/rere/adjust-text-brightness /usr/local/rere/bot-menu

# Apply requested default/current mode across every KaizenSC text script.
/usr/local/rere/adjust-text-brightness --apply normal

# Validate the two replacement scripts and audit fixed ANSI sequences.
bash -n /usr/local/rere/adjust-text-brightness
bash -n /usr/local/rere/bot-menu
python3 <<'PY'
import os,re,sys
root='/usr/local/rere'
pat=re.compile(r'\\(?:e|033)\[([0-9;]+)(m)')
bold=[]; dark=[]
for base,_,files in os.walk(root):
    for name in files:
        p=os.path.join(base,name)
        try:
            data=open(p,'rb').read()
            if b'\x00' in data: continue
            text=data.decode('utf-8')
        except Exception:
            continue
        for m in pat.finditer(text):
            vals=[]
            try: vals=[int(x or 0) for x in m.group(1).split(';')]
            except ValueError: continue
            if 1 in vals: bold.append((p,m.group(0)))
            if vals[:3] == [38,5,240] or vals[:4] == [0,38,5,240]: dark.append((p,m.group(0)))
if bold or dark:
    print('[WARN] ANSI audit found remaining fixed sequences:')
    print('  bold:', len(bold), 'dark-gray:', len(dark))
    for item in (bold+dark)[:10]: print(' ', item[0], item[1])
else:
    print('[OK] All fixed KaizenSC ANSI colours are Normal / Not Bright; white uses non-bold 97.')
PY

echo
echo '[OK] Patch installed successfully.'
echo "[OK] Backup: $BACKUP_DIR"
echo '[OK] Default/current text mode: Normal / Not Bright'
echo '[OK] White: ANSI 0;97 (white, non-bold)'
echo '[OK] Bot Manager updated; Coming Soon entries removed.'
