#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'
XRAY_BIN=/usr/local/xray-new/xray
BASE=/etc/kaizensc/xray
cmd(){ kaizen_rainbow_line 2>/dev/null || true; }
header(){ clear; kaizen_header " • $1 • "; }
choose_proto(){
  header "$1"
  echo -e "  ${CYAN}[01]${plain} ${WHITE}Vless${plain}"
  echo -e "  ${CYAN}[02]${plain} ${WHITE}Vmess${plain}"
  echo -e "  ${CYAN}[03]${plain} ${WHITE}Trojan${plain}"
  echo -e "  ${CYAN}[04]${plain} ${WHITE}Back to Routing Manager${plain}"
  cmd
  read -rp "Select protocol: " pr
  case "$pr" in 1|01) PROTO=vless;;2|02) PROTO=vmess;;3|03) PROTO=trojan;;*) return 1;;esac
}
validate_proto(){
  local p="$1"
  if [[ -x "$XRAY_BIN" ]]; then
    "$XRAY_BIN" run -test -confdir "$BASE/$p" >/tmp/kzn-routing-test.log 2>&1
    return $?
  fi
  for f in "$BASE/$p"/*.json; do jq empty "$f" || return 1; done
}
edit_file(){
  local title="$1" file="$2" p="$3" bak
  bak="${file}.bak.$(date +%Y%m%d-%H%M%S)"
  cp -a "$file" "$bak"
  header "$title"
  "${EDITOR:-nano}" "$file"
  if jq empty "$file" >/dev/null 2>&1 && validate_proto "$p"; then
    systemctl restart "xray-$p" >/dev/null 2>&1 || true
    header "ROUTING UPDATED"
    echo -e "${GREEN}Configuration valid and xray-$p restarted.${plain}"
  else
    cp -a "$bak" "$file"
    header "ROUTING ERROR"
    echo -e "${RED}Invalid routing configuration. Original file restored.${plain}"
    cat /tmp/kzn-routing-test.log 2>/dev/null | tail -20
  fi
  echo; read -rp 'Press Enter to continue...' _
}
check_all(){
  header "CHECK CONFIG ROUTING"
  local p
  for p in vless vmess trojan; do
    if validate_proto "$p"; then
      echo -e "${WHITE}$(tr '[:lower:]' '[:upper:]' <<< "${p:0:1}")${p:1} : ${GREEN}VALID${plain}"
    else
      echo -e "${WHITE}$p : ${RED}INVALID${plain}"
      cat /tmp/kzn-routing-test.log 2>/dev/null | tail -10
    fi
  done
  echo; read -rp 'Press Enter to continue...' _
}
while true; do
  header "ROUTING MANAGER"
  echo -e "  ${CYAN}[01]${plain} ${WHITE}Outbounds Routing${plain}"
  echo -e "  ${CYAN}[02]${plain} ${WHITE}Rules Routing${plain}"
  echo -e "  ${CYAN}[03]${plain} ${WHITE}Check Config Routing${plain}"
  echo -e "  ${CYAN}[04]${plain} ${WHITE}Back to System VPS${plain}"
  cmd
  echo -e "  ${CYAN}[ x]${plain} ${WHITE}Exit${plain}"
  cmd; echo
  read -rp "Please select an option [01-04 or x]: " opt
  case "$opt" in
    1|01) choose_proto "OUTBOUNDS ROUTING" && edit_file "OUTBOUNDS ROUTING - $PROTO" "$BASE/$PROTO/outbounds.json" "$PROTO" ;;
    2|02) choose_proto "RULES ROUTING" && edit_file "RULES ROUTING - $PROTO" "$BASE/$PROTO/routing.json" "$PROTO" ;;
    3|03) check_all ;;
    4|04) exec menu-system ;;
    x|X) clear; exit 0 ;;
    *) sleep 1 ;;
  esac
done

