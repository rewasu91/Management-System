#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; YELLOW='\e[0;33m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'
bgPutih='\e[0;47;30m'
BOT_DIR='/etc/kaizensc/bot/notif'
BOT_KEY="$BOT_DIR/bot.key"
CHAT_ID="$BOT_DIR/client.id"
INTERVAL_FILE="$BOT_DIR/interval"
CRON_FILE='/etc/cron.d/kaizensc-bot-notification'
NOTIFY_SCRIPT='/usr/local/rere/bot-notification'

cmd(){ printf '  '; local i; for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done; echo; }
invalid(){ echo; echo -e "${RED}  Invalid option, please try again!${plain}"; sleep 1; }
center_title(){ local title="$1" width=49 len left right; len=${#title}; left=$(( (width-len)/2 )); right=$(( width-len-left )); printf "${CYAN}│${plain}${bgPutih}%*s%s%*s${plain}${CYAN}│${plain}\n" "$left" '' "$title" "$right" ''; }
header(){ local title="$1"; clear; echo; echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"; center_title " • ${title} • "; echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"; }
pause(){ echo; read -rp '  Press Enter to continue...' _; }

read_credentials(){
  BOT_API=$(cat "$BOT_KEY" 2>/dev/null || true)
  BOT_CHATID=$(cat "$CHAT_ID" 2>/dev/null || true)
}
have_credentials(){ read_credentials; [[ -n "$BOT_API" && -n "$BOT_CHATID" ]]; }
show_credentials(){
  read_credentials
  echo -e "  ${WHITE}Your BOT API :${plain}"
  if [[ -n "$BOT_API" ]]; then echo -e "    ${YELLOW}${BOT_API}${plain}"; else echo -e "    ${YELLOW}Not configured${plain}"; fi
  echo
  echo -e "  ${WHITE}Your CHATID  :${plain}"
  if [[ -n "$BOT_CHATID" ]]; then echo -e "    ${YELLOW}${BOT_CHATID}${plain}"; else echo -e "    ${YELLOW}Not configured${plain}"; fi
}

save_credentials(){
  local title="$1" api itd ans
  header "$title"
  read -rp '  BOT API : ' api
  read -rp '  CHAT ID : ' itd
  if [[ -z "$api" || -z "$itd" ]]; then
    echo; echo -e "${RED}  BOT API and CHAT ID cannot be empty.${plain}"; pause; return
  fi
  echo
  echo -e "${WHITE}  BOT API : ${YELLOW}${api}${plain}"
  echo -e "${WHITE}  CHAT ID : ${YELLOW}${itd}${plain}"
  echo
  read -rp '  Save this BOT API & CHAT ID? [y/N]: ' ans
  [[ "$ans" =~ ^[Yy]$ ]] || return
  mkdir -p "$BOT_DIR"
  printf '%s\n' "$api" > "$BOT_KEY"
  printf '%s\n' "$itd" > "$CHAT_ID"
  chmod 600 "$BOT_KEY" "$CHAT_ID" 2>/dev/null || true
  header 'BOT API & CHAT ID SAVED'
  echo -e "${GREEN}  BOT API & CHAT ID saved successfully.${plain}"
  pause
}

get_interval(){
  local n
  n=$(cat "$INTERVAL_FILE" 2>/dev/null || true)
  [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= 59 )) || n=10
  printf '%s' "$n"
}
notification_status(){ [[ -f "$CRON_FILE" ]] && printf 'ON' || printf 'OFF'; }
write_notification_cron(){
  local n="$1"
  cat > "$CRON_FILE" <<CRON
# KaizenSC periodic Telegram VPS notification
*/${n} * * * * root ${NOTIFY_SCRIPT} >/dev/null 2>&1
CRON
  chmod 644 "$CRON_FILE"
}
notification_menu(){
  local op n status
  mkdir -p "$BOT_DIR"
  [[ -s "$INTERVAL_FILE" ]] || printf '10\n' > "$INTERVAL_FILE"
  while true; do
    n=$(get_interval); status=$(notification_status)
    header 'NOTIFICATION FROM BOT'
    if [[ "$status" == ON ]]; then
      echo -e "                  ${WHITE}Status ${GREEN}[ON]${plain}"
    else
      echo -e "                  ${WHITE}Status ${RED}[OFF]${plain}"
    fi
    echo
    cmd
    if [[ "$status" == ON ]]; then
      echo -e "  ${CYAN}[01]${plain} ${WHITE}OFF${plain}"
    else
      echo -e "  ${CYAN}[01]${plain} ${WHITE}ON${plain}"
    fi
    echo -e "  ${CYAN}[02]${plain} ${WHITE}Set Time Notif ${GREEN}${n}m${plain}"
    echo -e "  ${CYAN}[03]${plain} ${WHITE}Back to Bot & Backup Manager${plain}"
    cmd
    echo -e "  ${CYAN}[ x]${plain} ${WHITE}Exit${plain}"
    cmd
    echo
    read -rp " $(echo -e "${WHITE}Please select an option [01-03 or x]:${plain} ")" op
    case "$op" in
      1|01)
        if [[ "$status" == ON ]]; then
          rm -f "$CRON_FILE"
          header 'NOTIFICATION FROM BOT'; echo -e "${YELLOW}  Periodic BOT notification is now OFF.${plain}"; sleep 1
        else
          if ! have_credentials; then
            header 'NOTIFICATION FROM BOT'; echo -e "${RED}  BOT API / CHAT ID is not configured.${plain}"; echo -e "${WHITE}  Configure it first from Bot & Backup Manager.${plain}"; pause
          elif [[ ! -x "$NOTIFY_SCRIPT" ]]; then
            header 'NOTIFICATION FROM BOT'; echo -e "${RED}  Notification helper is missing.${plain}"; pause
          else
            write_notification_cron "$n"
            "$NOTIFY_SCRIPT" >/dev/null 2>&1 || true
            header 'NOTIFICATION FROM BOT'; echo -e "${GREEN}  Periodic BOT notification is now ON.${plain}"; sleep 1
          fi
        fi
        ;;
      2|02)
        header 'SET NOTIFICATION TIME'
        echo -e "${WHITE}  Current interval : ${GREEN}${n} minutes${plain}"
        echo -e "${WHITE}  Allowed range    : 1 - 59 minutes${plain}"
        echo
        read -rp '  New interval (minutes): ' n
        if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= 59 )); then
          printf '%s\n' "$n" > "$INTERVAL_FILE"
          [[ -f "$CRON_FILE" ]] && write_notification_cron "$n"
          echo; echo -e "${GREEN}  Notification interval changed to ${n} minutes.${plain}"; sleep 1
        else
          echo; echo -e "${RED}  Invalid interval. Use 1-59 minutes.${plain}"; sleep 1
        fi
        ;;
      3|03) return ;;
      x|X) clear; exit 0 ;;
      *) invalid ;;
    esac
  done
}

run_backup(){
  header 'BACKUP DATABASE'
  if [[ ! -x /usr/local/rere/backup ]]; then echo -e "${RED}  Backup script is not installed.${plain}"; pause; return; fi
  /usr/local/rere/backup
  pause
}
run_restore(){
  header 'RESTORE DATABASE'
  if [[ ! -x /usr/local/rere/restore ]]; then echo -e "${RED}  Restore script is not installed.${plain}"; pause; return; fi
  /usr/local/rere/restore
  pause
}

