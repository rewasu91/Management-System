    2|02) apply_dns "Default DNS" "1.1.1.1 8.8.8.8" "" "1.1.1.1 8.8.8.8" ;;
    3|03) custom_dns ;;
    4|04) show_details ;;
    5|05) exec menu-system ;;
    x|X) clear; exit 0 ;;
    *) echo -e "${RED}Invalid option.${plain}"; sleep 1 ;;
  esac
done

