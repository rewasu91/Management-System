#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; YELLOW='\e[0;33m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'
SELECTED_DNS_FILE="/etc/dns-manager-selected.conf"

cmd(){ kaizen_rainbow_line 2>/dev/null || { printf '  '; for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done; echo; }; }
pause(){ echo; read -rp 'Press Enter to continue...' _; }
header(){ clear; kaizen_header " • $1 • "; }

detect_resolver(){
  RESOLV_TARGET="$(readlink -f /etc/resolv.conf 2>/dev/null || true)"
  if [[ "$RESOLV_TARGET" == *systemd/resolve* ]]; then RESOLVER_TYPE="systemd-resolved"
  elif [[ "$RESOLV_TARGET" == *resolvconf* ]]; then RESOLVER_TYPE="resolvconf"
  else RESOLVER_TYPE="static"
  fi
}
current_dns(){
  local dns
  if [[ -s "$SELECTED_DNS_FILE" ]]; then
    tr '\n' ' ' < "$SELECTED_DNS_FILE" | xargs
  else
    dns=$(awk '/^nameserver[[:space:]]+/ {print $2}' /etc/resolv.conf 2>/dev/null | awk '!seen[$0]++' | paste -sd ', ' -)
    [[ -n "$dns" ]] && printf '%s' "$dns" || printf 'Not detected'
  fi
}
backup_files(){
  local tag; tag=$(date +%Y%m%d-%H%M%S)
  [[ -f /etc/resolv.conf ]] && cp -a /etc/resolv.conf "/etc/resolv.conf.bak-$tag" 2>/dev/null || true
  [[ -f /etc/systemd/resolved.conf ]] && cp -a /etc/systemd/resolved.conf "/etc/systemd/resolved.conf.bak-$tag" 2>/dev/null || true
  [[ -f /etc/resolvconf/resolv.conf.d/head ]] && cp -a /etc/resolvconf/resolv.conf.d/head "/etc/resolvconf/resolv.conf.d/head.bak-$tag" 2>/dev/null || true
}
restart_dns(){
  case "$RESOLVER_TYPE" in
    systemd-resolved) systemctl restart systemd-resolved 2>/dev/null || true; resolvectl flush-caches 2>/dev/null || true ;;
    resolvconf) resolvconf -u 2>/dev/null || true; systemctl restart resolvconf 2>/dev/null || true ;;
    static) : ;;
  esac
}
apply_dns(){
  local title="$1" main="$2" fallback="$3" ns="$4" ans
  detect_resolver
  header "APPLY DNS PROFILE"
  echo -e "${WHITE}Profile       : ${GREEN}$title${plain}"
  echo -e "${WHITE}Resolver Type : ${GREEN}$RESOLVER_TYPE${plain}"
  echo -e "${WHITE}Primary DNS   : ${GREEN}$main${plain}"
  echo -e "${WHITE}Fallback DNS  : ${GREEN}${fallback:-None}${plain}"
  echo
  read -rp "Continue with this DNS configuration? (y/n): " ans
  [[ "$ans" =~ ^[Yy]$ ]] || return
  backup_files
  printf '%s\n' $ns > "$SELECTED_DNS_FILE"

  if [[ "$RESOLVER_TYPE" == systemd-resolved ]]; then
    mkdir -p /etc/systemd
    cat > /etc/systemd/resolved.conf <<EOF
[Resolve]
DNS=$main
FallbackDNS=$fallback
EOF
  elif [[ "$RESOLVER_TYPE" == resolvconf ]]; then
    mkdir -p /etc/resolvconf/resolv.conf.d
    : > /etc/resolvconf/resolv.conf.d/head
    for d in $ns; do echo "nameserver $d" >> /etc/resolvconf/resolv.conf.d/head; done
    : > /etc/resolvconf/resolv.conf.d/base
    : > /etc/resolvconf/resolv.conf.d/tail
  else
    : > /etc/resolv.conf
    for d in $ns; do echo "nameserver $d" >> /etc/resolv.conf; done
  fi
  restart_dns
  header "DNS UPDATED"
  echo -e "${GREEN}DNS configuration updated successfully.${plain}"
  echo -e "${WHITE}Current DNS: ${GREEN}$(current_dns)${plain}"
  pause
}
custom_dns(){
  local entries=() d joined
  header "CUSTOM DNS"
  echo -e "${WHITE}Enter DNS servers one by one.${plain}"
  echo -e "${WHITE}Leave empty and press Enter when finished.${plain}"
  echo
  while true; do
    read -rp "DNS Server: " d
    [[ -z "$d" ]] && break
    [[ "$d" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$|: ]] || { echo -e "${RED}Invalid DNS address.${plain}"; continue; }
    entries+=("$d")
  done
  ((${#entries[@]})) || return
  joined="${entries[*]}"
  apply_dns "Custom DNS" "$joined" "" "$joined"
}
show_details(){
  detect_resolver
  header "CURRENT DNS DETAILS"
  echo -e "${WHITE}Resolver Type : ${GREEN}$RESOLVER_TYPE${plain}"
  echo -e "${WHITE}Current DNS   : ${GREEN}$(current_dns)${plain}"
  echo -e "${WHITE}Config Path   : ${GREEN}/etc/resolv.conf${plain}"
  echo
  cat /etc/resolv.conf 2>/dev/null || true
  pause
}

while true; do
