#!/usr/bin/env bash
set -euo pipefail
RERE=/usr/local/rere
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/kaizensc-system-menu-backup-${STAMP}"

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Please run as root."; exit 1; }
[[ -d "$RERE" ]] || { echo "KaizenSC not found: $RERE"; exit 1; }
mkdir -p "$BACKUP/rere"

[[ -f "$RERE/menu-system" ]] && cp -a "$RERE/menu-system" "$BACKUP/rere/menu-system" || true
cat > "$RERE/menu-system" <<'__KZN_MENU_SYSTEM__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; YELLOW='\e[0;33m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'; bgPutih='\e[0;47;30m'; keatas="${CYAN}│${plain}"
cmd(){ printf '  '; local i; for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done; echo; }
invalid(){ echo; echo -e "${RED}Invalid option, please try again!${plain}"; sleep 1; }
header(){ clear; echo; if declare -F kaizen_header >/dev/null; then kaizen_header " • $1 • "; else echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"; printf "${CYAN}│${plain}${bgPutih}%49s${plain}${CYAN}│${plain}\n" " $1"; echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"; fi; }
result_title(){ header "$1"; }

change_banner(){
 result_title 'CHANGE SSH BANNER'
 read -rp 'Input your SSH banner: ' bns
 printf '%s\n' "$bns" > /etc/issue.net
 systemctl daemon-reload
 for s in ssh sshd dropbear ws-stunnel multiplex ws-dual; do systemctl cat "$s" >/dev/null 2>&1 && systemctl restart "$s" >/dev/null 2>&1 || true; done
 echo -e "${GREEN}SSH banner updated successfully.${plain}"
}

system_status(){
 result_title 'SYSTEM STATUS'
 local uptime_text cpu_load ram_total ram_used ram_pct disk_total disk_used disk_pct
 uptime_text=$(uptime -p 2>/dev/null | sed 's/^up //' || echo '-')
 cpu_load=$(awk '{print $1" / "$2" / "$3}' /proc/loadavg 2>/dev/null || echo '-')
 ram_total=$(free -m | awk '/^Mem:/ {print $2}')
 ram_used=$(free -m | awk '/^Mem:/ {print $3}')
 if [[ ${ram_total:-0} -gt 0 ]]; then ram_pct=$((ram_used*100/ram_total)); else ram_pct=0; fi
 read -r disk_total disk_used disk_pct < <(df -h / | awk 'NR==2 {print $2, $3, $5}')
 echo -e "${WHITE}  Uptime      : ${GREEN}${uptime_text:-'-'}${plain}"
 echo -e "${WHITE}  CPU Load    : ${GREEN}${cpu_load:-'-'}${plain}"
 echo -e "${WHITE}  RAM Usage   : ${GREEN}${ram_used:-0} MB / ${ram_total:-0} MB (${ram_pct}%)${plain}"
 echo -e "${WHITE}  SSD Usage   : ${GREEN}${disk_used:-'-'} / ${disk_total:-'-'} (${disk_pct:-'-'})${plain}"
 echo -e "${WHITE}  CPU Cores   : ${GREEN}$(nproc 2>/dev/null || echo '-')${plain}"
 echo -e "${WHITE}  Kernel      : ${GREEN}$(uname -r)${plain}"
}

restart_all(){
 result_title 'RESTART ALL SERVICE'
 echo -e "${WHITE}Restarting installed services...${plain}"; echo
 services=(ssh sshd dropbear multiplex ws-stunnel ws-dual cron xray-vless xray-vmess xray-trojan haproxy sslh nginx openvpn dnstt udp-custom api v2ray xray-quota@vless xray-quota@vmess xray-quota@trojan)
 for s in "${services[@]}"; do
   if systemctl cat "$s" >/dev/null 2>&1; then
     if systemctl restart "$s" >/dev/null 2>&1; then printf "${GREEN}[OK]${plain}   ${WHITE}%s${plain}\n" "$s"; else printf "${RED}[FAIL]${plain} ${WHITE}%s${plain}\n" "$s"; fi
   fi
 done
 [[ -f /etc/xray/domargo ]] && systemctl cat cloudflared >/dev/null 2>&1 && systemctl restart cloudflared >/dev/null 2>&1 || true
}

choose_region(){
 local region=$1 zones choice
 mapfile -t zones < <(timedatectl list-timezones | grep -E "^${region}/")
 ((${#zones[@]}>0)) || { result_title 'CHANGE TIMEZONE'; echo -e "${RED}No timezone found.${plain}"; return; }
 while true; do
   header "${region} TIMEZONES"
   local i; for i in "${!zones[@]}"; do printf "  ${CYAN}[%02d]${plain} ${WHITE}%s${plain}\n" "$((i+1))" "${zones[$i]}"; done
   cmd; echo -e "  ${CYAN}[ x]${plain} ${WHITE}Back${plain}"; cmd; echo
   read -rp " $(echo -e "${WHITE}Select timezone:${plain} ")" choice
   [[ "$choice" =~ ^[Xx]$ ]] && return
   if [[ "$choice" =~ ^[0-9]+$ ]] && ((choice>=1 && choice<=${#zones[@]})); then
     timedatectl set-timezone "${zones[$((choice-1))]}" && { result_title 'TIMEZONE UPDATED'; echo -e "${GREEN}Timezone changed to ${zones[$((choice-1))]}.${plain}"; }; return
   fi
   invalid
 done
}

change_timezone(){
 while true; do
  header 'CHANGE TIMEZONE'
  current_tz=$(timedatectl show -p Timezone --value 2>/dev/null || cat /etc/timezone 2>/dev/null || echo '-')
  echo -e "  ${WHITE}Current timezone: ${GREEN}${current_tz}${plain}"
  echo
  echo -e "  ${CYAN}[01]${plain} ${WHITE}Africa${plain}"
  echo -e "  ${CYAN}[02]${plain} ${WHITE}America${plain}"
  echo -e "  ${CYAN}[03]${plain} ${WHITE}Antarctica${plain}"
  echo -e "  ${CYAN}[04]${plain} ${WHITE}Asia${plain}"
  echo -e "  ${CYAN}[05]${plain} ${WHITE}Atlantic${plain}"
  echo -e "  ${CYAN}[06]${plain} ${WHITE}Australia${plain}"
  echo -e "  ${CYAN}[07]${plain} ${WHITE}Europe${plain}"
  echo -e "  ${CYAN}[08]${plain} ${WHITE}Indian${plain}"
  echo -e "  ${CYAN}[09]${plain} ${WHITE}Pacific${plain}"
  echo -e "  ${CYAN}[10]${plain} ${WHITE}View Current Time Zone${plain}"
  echo -e "  ${CYAN}[11]${plain} ${WHITE}Back to System VPS${plain}"
  cmd
  echo -e "  ${CYAN}[ x]${plain} ${WHITE}Exit${plain}"
  cmd; echo
  read -rp " $(echo -e "${WHITE}Please select an option [01-11 or x]:${plain} ")" opt
  case "$opt" in
   1|01) choose_region Africa;; 2|02) choose_region America;; 3|03) choose_region Antarctica;; 4|04) choose_region Asia;;
   5|05) choose_region Atlantic;; 6|06) choose_region Australia;; 7|07) choose_region Europe;; 8|08) choose_region Indian;; 9|09) choose_region Pacific;;
   10) result_title 'CURRENT TIMEZONE'; timedatectl; read -rp 'Press Enter to continue...' _;;
   11) return;;
   x|X) clear; exit 0;;
   *) invalid;;
  esac
 done
}

speedtest_vps(){
 result_title 'SPEEDTEST VPS'
 if command -v speedtest >/dev/null 2>&1; then
   speedtest
 elif command -v speedtest-cli >/dev/null 2>&1; then
   speedtest-cli
 else
   echo -e "${WHITE}Installing speedtest-cli...${plain}"
   apt-get update -qq >/dev/null 2>&1 || true
   DEBIAN_FRONTEND=noninteractive apt-get install -y speedtest-cli >/dev/null 2>&1 || true
   if command -v speedtest-cli >/dev/null 2>&1; then
     speedtest-cli
   else
     echo -e "${RED}Unable to install or run speedtest-cli.${plain}"
   fi
 fi
 echo
 read -rp 'Press Enter to continue...' _
}

reboot_vps(){
 result_title 'REBOOT VPS'
 echo -e "${YELLOW}The VPS will reboot immediately.${plain}"
 echo
 read -rp 'Continue reboot VPS? (y/n): ' yn
 [[ "$yn" =~ ^[Yy]$ ]] || return
 sync
 systemctl reboot || reboot
}

coming_soon(){
 result_title "$1"
 echo -e "${YELLOW}Coming Soon${plain}"
 echo
 read -rp 'Press Enter to continue...' _
}

MREINSTALL_URL='https://raw.githubusercontent.com/rewasu91/Management-System/refs/heads/main/mreinstall'
MREINSTALL_FILE='/root/mreinstall'

rebuild_vps(){
 result_title 'REINSTALL / REBUILD VPS'
 echo -e "${WHITE}Downloading latest VPS reinstall manager...${plain}"
 echo

 if ! curl -fL --retry 3 --retry-delay 2 --connect-timeout 10 --max-time 60 \
   "$MREINSTALL_URL" -o "$MREINSTALL_FILE"; then
   echo
   echo -e "${RED}Failed to download VPS reinstall manager.${plain}"
   echo -e "${WHITE}Source:${plain}"
   echo -e "${CYAN}${MREINSTALL_URL}${plain}"
   echo
   read -rp 'Press Enter to continue...' _
   return
 fi

 if [[ ! -s "$MREINSTALL_FILE" ]]; then
   echo -e "${RED}Downloaded reinstall manager is empty.${plain}"
   rm -f "$MREINSTALL_FILE"
   read -rp 'Press Enter to continue...' _
   return
 fi

 chmod 700 "$MREINSTALL_FILE"

 if ! bash -n "$MREINSTALL_FILE"; then
   echo
   echo -e "${RED}Downloaded reinstall manager failed Bash syntax validation.${plain}"
   read -rp 'Press Enter to continue...' _
   return
 fi

 clear
 bash "$MREINSTALL_FILE"
 local rc=$?

 if (( rc != 0 )); then
   echo
   echo -e "${YELLOW}Reinstall manager exited with status ${rc}.${plain}"
   read -rp 'Press Enter to continue...' _
   return
 fi

 result_title 'REINSTALL PREPARED'
 echo -e "${GREEN}Reinstall setup completed successfully.${plain}"
 echo -e "${YELLOW}VPS will reboot automatically in 5 seconds...${plain}"
 sync
 sleep 5
 systemctl reboot || reboot
}

