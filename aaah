kzn_box_row(){
    local label="$1" value="$2"
    # Fixed-width row matching the 46-character panel border.
    # Long values are truncated instead of pushing the right border outward.
    printf '│ %-12.12s : %-27.27s │\n' "$label" "$value"
}

kzn_progress_pid=""
kzn_progress_file=""

kzn_progress_start(){
    local label="$1" start_pct="$2" end_pct="$3"
    kzn_progress_file=$(mktemp /tmp/kaisc-progress.XXXXXX)
    : > "$kzn_progress_file"

    (
        local pct="$start_pct" elapsed=0 i=0
        local spin='|/-\'
        while [[ -f "$kzn_progress_file" ]]; do
            if (( pct < end_pct - 1 )); then
                pct=$((pct+1))
            fi
            elapsed=$((elapsed+1))
            i=$(( (i+1) % 4 ))
            printf '\r    [%3d%%] [%c] %-26.26s %02ds' \
                "$pct" "${spin:i:1}" "$label" "$elapsed"
            sleep 1
        done
    ) &
    kzn_progress_pid=$!
}

kzn_progress_stop(){
    local final_pct="$1" label="$2"
    [[ -n "${kzn_progress_file:-}" ]] && rm -f "$kzn_progress_file" 2>/dev/null || true
    [[ -n "${kzn_progress_pid:-}" ]] && wait "$kzn_progress_pid" 2>/dev/null || true
    printf '\r    [%3d%%] [✓] %-26.26s OK\n' "$final_pct" "$label"
    kzn_progress_pid=""
    kzn_progress_file=""
}

kzn_progress_fail(){
    local final_pct="$1" label="$2"
    [[ -n "${kzn_progress_file:-}" ]] && rm -f "$kzn_progress_file" 2>/dev/null || true
    [[ -n "${kzn_progress_pid:-}" ]] && wait "$kzn_progress_pid" 2>/dev/null || true
    printf '\r    [%3d%%] [x] %-26.26s FAILED\n' "$final_pct" "$label"
    kzn_progress_pid=""
    kzn_progress_file=""
}

kzn_elapsed(){
    local now total h m s
    now=$(date +%s)
    total=$((now-INSTALL_START_EPOCH))
    ((total < 0)) && total=0
    h=$((total/3600))
    m=$(((total%3600)/60))
    s=$((total%60))
    if ((h>0)); then
        printf '%dh %02dm %02ds' "$h" "$m" "$s"
    elif ((m>0)); then
        printf '%dm %02ds' "$m" "$s"
    else
        printf '%ds' "$s"
    fi
}

kzn_exit_handler(){
    local rc=$?
    [[ -n "${kzn_progress_file:-}" ]] && rm -f "$kzn_progress_file" 2>/dev/null || true
    [[ -n "${kzn_progress_pid:-}" ]] && wait "$kzn_progress_pid" 2>/dev/null || true
    if [[ "$INSTALL_SUCCESS" != "1" && "$rc" -ne 0 ]]; then
        printf '\n'
        printf '%s\n' '╭────────────────────────────────────────────╮'
        printf '%s\n' '│          KAIZENSC INSTALLATION FAILED      │'
        printf '%s\n' '├────────────────────────────────────────────┤'
        kzn_box_row "Stage" "$CURRENT_STAGE"
        kzn_box_row "Code" "$rc"
        kzn_box_row "Time" "$(kzn_elapsed)"
        printf '%s\n' '├────────────────────────────────────────────┤'
        kzn_box_row "Log" "/var/log/kaizensc-install.log"
        printf '%s\n' '╰────────────────────────────────────────────╯'
    fi
}
