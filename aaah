kzn_download(){
    local url="$1" dest="$2"
    local tmp="${dest}.part"

    rm -f "$tmp"

    if command -v curl >/dev/null 2>&1; then
        curl -fL \
            --retry 3 \
            --retry-delay 2 \
            --connect-timeout 15 \
            --max-time 300 \
            -o "$tmp" "$url" || return 1
    else
        wget --tries=3 --timeout=20 -q -O "$tmp" "$url" || return 1
    fi

    [[ -s "$tmp" ]] || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$dest"
}

kzn_restart_once(){
    local svc="$1"
    systemctl restart "$svc" >/dev/null 2>&1 || true
}

kzn_wait_for_apt_lock(){
    local waited=0 max_wait=300 busy lock
    local locks=(
        /var/lib/dpkg/lock-frontend
        /var/lib/dpkg/lock
        /var/lib/apt/lists/lock
        /var/cache/apt/archives/lock
    )

    while true; do
        busy=0
        for lock in "${locks[@]}"; do
            if command -v fuser >/dev/null 2>&1 && fuser "$lock" >/dev/null 2>&1; then
                busy=1
                break
            fi
        done
        ((busy==0)) && return 0

        ((waited==0)) && printf '\n    Package manager is busy. Waiting for apt/dpkg lock...\n'
        if ((waited>=max_wait)); then
            printf '\n[ERROR] apt/dpkg lock is still busy after %d seconds.\n' "$max_wait"
            ps -eo pid,etime,cmd | grep -E '[a]pt|[d]pkg|[u]nattended-upgrade' || true
            return 1
        fi
        sleep 2
        waited=$((waited+2))
    done
}

kzn_apt_update(){
    kzn_wait_for_apt_lock || return 1
    if ! apt-get -o Acquire::Retries=3 \
                 -o Acquire::http::Timeout=20 \
                 -o Acquire::https::Timeout=20 \
                 update >/tmp/kaisc-apt-update.log 2>&1; then
        echo "[ERROR] Repository update failed."
        tail -n 30 /tmp/kaisc-apt-update.log 2>/dev/null || true
        return 1
    fi
}

kzn_pkg_required(){
    local missing=() p
    for p in "$@"; do
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' || missing+=("$p")
    done
    ((${#missing[@]}==0)) && return 0

    kzn_wait_for_apt_lock || return 1
    if ! apt-get install -y --no-install-recommends "${missing[@]}" >/tmp/kaisc-apt-required.log 2>&1; then
        echo "[ERROR] Required package installation failed."
        tail -n 30 /tmp/kaisc-apt-required.log 2>/dev/null || true
        return 1
    fi
}

kzn_pkg_optional(){
    local p
    for p in "$@"; do
        dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed' && continue
        apt-get install -y --no-install-recommends "$p" >/dev/null 2>&1 || true
    done
}

