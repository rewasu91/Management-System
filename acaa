#!/usr/bin/env bash
set -euo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Run as root."; exit 1; }
RERE=/usr/local/rere
STAMP="$(date +%Y%m%d-%H%M%S)"
SAVE="/root/kaizensc-before-header-restore-${STAMP}"
mkdir -p "$SAVE"

[[ -f "$RERE/account-notify" ]] && cp -a "$RERE/account-notify" "$SAVE/account-notify" || true
cat > "$RERE/account-notify" <<'__KZN_ACCOUNT_NOTIFY__'
#!/usr/bin/env bash
set -u
BOT_DIR=/etc/kaizensc/bot/notif
BOT_KEY="$BOT_DIR/bot.key"
CHAT_ID="$BOT_DIR/client.id"

[[ -s "$BOT_KEY" && -s "$CHAT_ID" ]] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

event="${1:-EVENT}"
protocol="${2:-Unknown}"
account="${3:-Unknown}"
detail="${4:-}"

bot_api=$(tr -d '\r\n' < "$BOT_KEY" 2>/dev/null)
chat_id=$(tr -d '\r\n' < "$CHAT_ID" 2>/dev/null)
[[ -n "$bot_api" && -n "$chat_id" ]] || exit 0

domain=$(cat /etc/xray/domain 2>/dev/null || hostname -f 2>/dev/null || hostname)
server_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
[[ -n "$server_ip" ]] || server_ip="-"
now=$(date '+%Y-%m-%d %H:%M:%S %Z')

html_escape(){ printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
pretty_protocol(){
  case "${1,,}" in
    vless) echo "Vless" ;;
    vmess) echo "Vmess" ;;
    trojan) echo "Trojan" ;;
    ssh) echo "SSH" ;;
    wireguard) echo "WireGuard" ;;
    zivpn) echo "ZiVPN" ;;
    shadowsocks|shadowshocks) echo "Shadowsocks" ;;
    *) echo "$1" ;;
  esac
}
center_line(){
  local text="$1" width=34 len left right
  len=${#text}; ((width<len)) && width=$len
  left=$(( (width-len)/2 )); right=$(( width-len-left ))
  printf '%*s%s%*s' "$left" '' "$text" "$right" ''
}

pt=$(pretty_protocol "$protocol")
title="${pt} Account Information"
line="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
header="$(html_escape "$line")
$(html_escape "$(center_line "$title")")
$(html_escape "$line")"

body="Event: <code>$(html_escape "$event")</code>
Account: <code>$(html_escape "$account")</code>"
[[ -n "$detail" ]] && body="${body}
Detail: <code>$(html_escape "$detail")</code>"
body="${body}
Server: <code>$(html_escape "$domain")</code>
IP VPS: <code>$(html_escape "$server_ip")</code>
Time: <code>$(html_escape "$now")</code>"

curl -fsS --connect-timeout 5 --max-time 12 --retry 1 \
  -X POST "https://api.telegram.org/bot${bot_api}/sendMessage" \
  --data-urlencode "chat_id=${chat_id}" \
  --data-urlencode "parse_mode=HTML" \
  --data-urlencode "disable_web_page_preview=true" \
  --data-urlencode "text=${header}
${body}" >/dev/null 2>&1 || true
exit 0

__KZN_ACCOUNT_NOTIFY__
chmod 0755 "$RERE/account-notify"
bash -n "$RERE/account-notify"

[[ -f "$RERE/account-notify-full" ]] && cp -a "$RERE/account-notify-full" "$SAVE/account-notify-full" || true
cat > "$RERE/account-notify-full" <<'__KZN_ACCOUNT_NOTIFY_FULL__'
#!/usr/bin/env bash
set -u
BOT_DIR=/etc/kaizensc/bot/notif
BOT_KEY="$BOT_DIR/bot.key"
CHAT_ID="$BOT_DIR/client.id"

title="${1:-Account Information}"
protocol="${2:-Unknown}"
account="${3:-Unknown}"

[[ -s "$BOT_KEY" && -s "$CHAT_ID" ]] || exit 0
command -v curl >/dev/null 2>&1 || exit 0
token=$(tr -d '\r\n' < "$BOT_KEY" 2>/dev/null)
chat=$(tr -d '\r\n' < "$CHAT_ID" 2>/dev/null)
[[ -n "$token" && -n "$chat" ]] || exit 0

body=$(cat)
[[ -n "$body" ]] || exit 0

html_escape(){ printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
center_line(){
  local text="$1" width=34 len left right
  len=${#text}; ((width<len)) && width=$len
  left=$(( (width-len)/2 )); right=$(( width-len-left ))
  printf '%*s%s%*s' "$left" '' "$text" "$right" ''
}

line="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
header="$(html_escape "$line")
$(html_escape "$(center_line "$title")")
$(html_escape "$line")"

formatted=""
while IFS= read -r line_in; do
  [[ -n "$line_in" ]] || { formatted+=$'\n'; continue; }
  if [[ "$line_in" == *":"* ]]; then
    label="${line_in%%:*}"
    value="${line_in#*:}"; value="${value# }"
    if [[ "${label// /}" == "Download" && "$value" =~ ^https?:// ]]; then
      formatted+="$(html_escape "${label}:") <a href=\"$(html_escape "$value")\">$(html_escape "$value")</a>"$'\n'
    else
      formatted+="$(html_escape "${label}:") <code>$(html_escape "$value")</code>"$'\n'
    fi
  else
    formatted+="$(html_escape "$line_in")"$'\n'
  fi
done <<< "$body"

payload="${header}

${formatted}"
max=3800
while [[ -n "$payload" ]]; do
  if ((${#payload}<=max)); then
    chunk="$payload"; payload=""
  else
    chunk="${payload:0:max}"
    last_nl=$(awk -v s="$chunk" 'BEGIN{p=0;for(i=1;i<=length(s);i++)if(substr(s,i,1)=="\n")p=i;print p}')
    if ((last_nl>500)); then
      chunk="${payload:0:last_nl}"; payload="${payload:last_nl}"
    else
      payload="${payload:max}"
    fi
  fi
  curl -fsS --connect-timeout 5 --max-time 15 --retry 1 \
    -X POST "https://api.telegram.org/bot${token}/sendMessage" \
    --data-urlencode "chat_id=${chat}" \
    --data-urlencode "parse_mode=HTML" \
    --data-urlencode "disable_web_page_preview=true" \
    --data-urlencode "text=${chunk}" >/dev/null 2>&1 || true
done
exit 0

__KZN_ACCOUNT_NOTIFY_FULL__
chmod 0755 "$RERE/account-notify-full"
bash -n "$RERE/account-notify-full"

[[ -f "$RERE/xray-account" ]] && cp -a "$RERE/xray-account" "$SAVE/xray-account" || true
cat > "$RERE/xray-account" <<'__KZN_XRAY_ACCOUNT__'
#!/usr/bin/env bash
set -u

# Shared UI helpers
if [[ -r /usr/local/rere/kaizen-ui ]]; then
  source /usr/local/rere/kaizen-ui
else
  echo "[ERROR] KaizenSC UI helper not found: /usr/local/rere/kaizen-ui" >&2
  exit 1
fi

for __fn in kaizen_header kaizen_xray_table_header kaizen_xray_table_row kaizen_xray_table_footer kaizen_xray_table_total_row; do
  declare -F "$__fn" >/dev/null 2>&1 || {
    echo "[ERROR] KaizenSC UI helper is incomplete: $__fn" >&2
    exit 1
  }
done
unset __fn
proto_label(){ case "$1" in vless) echo Vless;; vmess) echo Vmess;; trojan) echo Trojan;; *) echo "$1";; esac; }
action_header(){ local t="$1"; command -v kaizen_header >/dev/null 2>&1 && kaizen_header " • $t • " || { echo "=== $t ==="; echo; }; }
result_header(){
  local t="$1"
  clear
  action_header "$t"
}

ACTION_TITLE=''
UI_RED='\e[0;31m'
UI_CYAN='\e[0;36m'
UI_WHITE='\e[0;97m'
UI_PLAIN='\e[0m'
xray_rainbow(){
  local i
  printf '  '
  for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done
  echo
}
BASE=/etc/kaizensc
DB="$BASE/database/xray/accounts.db"
REC="$BASE/recovery/xray/recovery.tsv"
XRAY_BIN=/usr/local/xray-new/xray
mkdir -p "$(dirname "$DB")" "$(dirname "$REC")"
touch "$REC"
sqlite3 "$DB" 'CREATE TABLE IF NOT EXISTS accounts(protocol TEXT NOT NULL,email TEXT NOT NULL,credential TEXT NOT NULL,expired TEXT NOT NULL,ip_limit INTEGER NOT NULL DEFAULT 0,quota_bytes INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL,PRIMARY KEY(protocol,email));'
sqlite3 "$DB" "PRAGMA table_info(accounts);" | grep -q '|locked|' || sqlite3 "$DB" "ALTER TABLE accounts ADD COLUMN locked INTEGER NOT NULL DEFAULT 0;"
sqlite3 "$DB" "PRAGMA table_info(accounts);" | grep -q '|lock_reason|' || sqlite3 "$DB" "ALTER TABLE accounts ADD COLUMN lock_reason TEXT NOT NULL DEFAULT '';"

domain(){ cat /etc/xray/domain 2>/dev/null || hostname -f; }
json(){ echo "/etc/kaizensc/xray/$1/inbounds.json"; }
service(){ echo "xray-$1"; }
api_port(){ case "$1" in vless) echo 10080;; vmess) echo 10081;; trojan) echo 10082;; esac; }
valid_proto(){ [[ "$1" =~ ^(vless|vmess|trojan)$ ]]; }
credential_key(){ [[ "$1" == trojan ]] && echo password || echo id; }
restart_proto(){ systemctl restart "$(service "$1")"; }
fmt_bytes(){
 local b="${1:-0}"
 [[ "$b" =~ ^[0-9]+$ ]] || b=0
 awk -v b="$b" 'BEGIN {
   if (b >= 1073741824) {v=b/1073741824; u="GB"}
   else if (b >= 1048576) {v=b/1048576; u="MB"}
   else if (b >= 1024) {v=b/1024; u="KB"}
   else {v=b; u="B"}
   if (v == int(v)) printf "%.0f %s", v, u;
   else if (v < 10) printf "%.2f %s", v, u;
   else printf "%.1f %s", v, u;
 }'
}
expire_parse(){ local x="$1"; if [[ "$x" =~ ^[0-9]+$ ]]; then date -d "+$x days" '+%F %T'; elif [[ "$x" =~ ^[0-9]+[mhd]$ ]]; then local n=${x%?} u=${x: -1}; case $u in m) u=minutes;; h) u=hours;; d) u=days;; esac; date -d "+$n $u" '+%F %T'; else date -d "$x" '+%F %T' 2>/dev/null; fi; }
text_to_uuid(){
 local text="$1" h
 h=$(printf '%s' "$text" | sha256sum | awk '{print $1}')
 # RFC4122-shaped deterministic UUID from arbitrary text.
 printf '%s-%s-4%s-8%s-%s\n' "${h:0:8}" "${h:8:4}" "${h:13:3}" "${h:17:3}" "${h:20:12}"
}
current_stat_total(){
 local p="$1" email="$2" api
 api="127.0.0.1:$(api_port "$p")"
 "$XRAY_BIN" api statsquery --server="$api" 2>/dev/null | jq -r --arg e "$email" '[.stat[]? | select(.name == ("user>>>"+$e+">>>traffic>>>uplink") or .name == ("user>>>"+$e+">>>traffic>>>downlink")) | (.value // 0)] | add // 0' 2>/dev/null || echo 0
}
sync_usage_once(){
  local p="$1" email="$2" total old usage delta
  mkdir -p "$BASE/limit/xray/$p/usage" "$BASE/limit/xray/$p/cache"
  total=$(current_stat_total "$p" "$email"); [[ "$total" =~ ^[0-9]+$ ]] || total=0
  old=$(cat "$BASE/limit/xray/$p/cache/$email" 2>/dev/null || echo 0); [[ "$old" =~ ^[0-9]+$ ]] || old=0
  usage=$(cat "$BASE/limit/xray/$p/usage/$email" 2>/dev/null || echo 0); [[ "$usage" =~ ^[0-9]+$ ]] || usage=0
  if (( total >= old )); then delta=$((total-old)); else delta=$total; fi
  usage=$((usage+delta))
  echo "$usage" > "$BASE/limit/xray/$p/usage/$email"
  echo "$total" > "$BASE/limit/xray/$p/cache/$email"
  printf '%s\n' "$usage"
}
clear_account_login_state(){
 local p="$1" email="$2" log="/var/log/xray/$p.log" tmp baseline
 # Remove only this account's historic login rows; keep other users' logs intact.
 if [[ -f "$log" ]]; then
   tmp=$(mktemp "${log}.clear.XXXXXX")
   grep -Fv -- "$email" "$log" > "$tmp" 2>/dev/null || true
   cat "$tmp" > "$log"
   rm -f "$tmp"
 fi
 mkdir -p "$BASE/limit/xray/$p/cache"
 baseline=$(current_stat_total "$p" "$email"); [[ "$baseline" =~ ^[0-9]+$ ]] || baseline=0
 echo "$baseline" > "$BASE/limit/xray/$p/cache/$email"
}

add_json(){ local p=$1 email=$2 cred=$3 key; key=$(credential_key "$p"); jq --arg p "$p" --arg e "$email" --arg c "$cred" --arg k "$key" '(.inbounds[] | select(.protocol==$p) | .settings.clients) += [if $k=="id" then {id:$c,email:$e,level:0} else {password:$c,email:$e,level:0} end]' "$(json "$p")" > "$(json "$p").tmp" && mv "$(json "$p").tmp" "$(json "$p")"; }
delete_json(){ local p=$1 email=$2; jq --arg p "$p" --arg e "$email" '(.inbounds[] | select(.protocol==$p) | .settings.clients) |= map(select(.email!=$e))' "$(json "$p")" > "$(json "$p").tmp" && mv "$(json "$p").tmp" "$(json "$p")"; }
update_credential_json(){ local p=$1 email=$2 cred=$3 key; key=$(credential_key "$p"); jq --arg p "$p" --arg e "$email" --arg c "$cred" --arg k "$key" '(.inbounds[] | select(.protocol==$p) | .settings.clients) |= map(if .email==$e then (if $k=="id" then .id=$c else .password=$c end) else . end)' "$(json "$p")" > "$(json "$p").tmp" && mv "$(json "$p").tmp" "$(json "$p")"; }

xray_html_escape(){ printf '%s' "${1:-}" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }
xray_center_title(){
  local text="$1" width=32 len pad out="" i
  len=${#text}; pad=$(( (width-len)/2 )); ((pad<1)) && pad=1
  for ((i=0;i<pad;i++)); do out+="&#160;"; done
  printf '%s%s' "$out" "$(xray_html_escape "$text")"
}
xray_send_html(){
  local html="$1" token chat
  [[ -s /etc/kaizensc/bot/notif/bot.key && -s /etc/kaizensc/bot/notif/client.id ]] || return 0
  command -v curl >/dev/null 2>&1 || return 0
  token=$(tr -d '\r\n' < /etc/kaizensc/bot/notif/bot.key 2>/dev/null)
  chat=$(tr -d '\r\n' < /etc/kaizensc/bot/notif/client.id 2>/dev/null)
  [[ -n "$token" && -n "$chat" ]] || return 0
  curl -fsS --connect-timeout 5 --max-time 15 --retry 1 \
    -X POST "https://api.telegram.org/bot${token}/sendMessage" \
    --data-urlencode "chat_id=${chat}" \
    --data-urlencode "parse_mode=HTML" \
    --data-urlencode "disable_web_page_preview=true" \
    --data-urlencode "text=${html}" >/dev/null 2>&1 || true
}
xray_notify_created_html(){
  local p="$1" email="$2" cred="$3" d="$4" exp="$5"
  local raw line info="" links_html="" title section escaped label value msg part
  raw=$(links "$p" "$email" "$cred" "$d" "$exp" 2>/dev/null || true)
  [[ -n "$raw" ]] || return 0
  case "$p" in
    vless) title="Vless Account Information" ;;
    vmess) title="Vmess Account Information" ;;
    trojan) title="Trojan Account Information" ;;
    *) title="$(proto_label "$p") Account Information" ;;
  esac
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    case "$line" in
      ═*) ;;
      \[*\])
        section="${line#[}"; section="${section%]}"
        links_html+=$'\n'"<b>$(xray_html_escape "$section") :</b>"$'\n'
        ;;
      vless://*|vmess://*|trojan://*)
        escaped=$(xray_html_escape "$line")
        links_html+="<pre><code>${escaped}</code></pre>"$'\n'
        ;;
      *:*)
        label="${line%%:*}"
        value="${line#*:}"; value="${value# }"
        info+="$(xray_html_escape "${label}:") <code>$(xray_html_escape "$value")</code>"$'\n'
        ;;
      *) info+="$(xray_html_escape "$line")"$'\n' ;;
    esac
  done <<< "$raw"

  local hline="━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" hwidth=34 hlen hleft hright centered
  hlen=${#title}; ((hwidth<hlen)) && hwidth=$hlen
  hleft=$(( (hwidth-hlen)/2 )); hright=$(( hwidth-hlen-hleft ))
  printf -v centered '%*s%s%*s' "$hleft" '' "$title" "$hright" ''
  msg="$(xray_html_escape "$hline")
$(xray_html_escape "$centered")
$(xray_html_escape "$hline")"$'\n\n'"${info}"
  if ((${#msg}+${#links_html} <= 3900)); then
    xray_send_html "${msg}"$'\n'"${links_html}"
    return 0
  fi
  xray_send_html "$msg"
  part=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if ((${#part}+${#line}+1 > 3800)); then xray_send_html "$part"; part=""; fi
    part+="$line"$'\n'
  done <<< "$links_html"
  [[ -n "$part" ]] && xray_send_html "$part"
}

links(){
 local p="${1:-}" email="${2:-}" c="${3:-}" d="${4:-}" exp="${5:-}"
 local tls='443' ntls='80' name user tcp_tls tcp_ntls row ip_limit quota_bytes ip_text quota_text
 [[ -n "$p" && -n "$email" && -n "$c" && -n "$d" ]] || { echo '[ERROR] Incomplete account data.'; return 1; }
 user=${email%@*}
 name=$user
 case "$p" in
   vless) tcp_tls=2083; tcp_ntls=2082 ;;
   vmess) tcp_tls=2087; tcp_ntls=2086 ;;
   trojan) tcp_tls=2096; tcp_ntls=2095 ;;
 esac
 row=$(sqlite3 -separator '|' "$DB" "SELECT ip_limit,quota_bytes FROM accounts WHERE protocol='$p' AND email='$email' LIMIT 1;" 2>/dev/null || true)
 IFS='|' read -r ip_limit quota_bytes <<< "$row"
 [[ "${ip_limit:-}" =~ ^[0-9]+$ ]] || ip_limit=0
 [[ "${quota_bytes:-}" =~ ^[0-9]+$ ]] || quota_bytes=0
 (( ip_limit > 0 )) && ip_text="$ip_limit" || ip_text='Unlimited'
 (( quota_bytes > 0 )) && quota_text="$(fmt_bytes "$quota_bytes")" || quota_text='Unlimited'
 echo "Host/IP           : $d"
 echo "Email             : ${email%@*}"
 echo "UUID              : $c"
 echo "Limit IP          : $ip_text"
 echo "Limit Quota       : $quota_text"
 echo "Port TLS          : 443, 8443, 8999, 9443, 9755, 400-777"
 echo "Port none TLS     : 80-108, 8000, 8080-8180, 2084-2085, 2088-2094, 2097-2199"
 echo "Port TCP TLS      : $tcp_tls"
 echo "Port TCP none TLS : $tcp_ntls"
 echo '══════════════════════════════════════════════════'
 echo "Expired : ${exp%% *}"
 echo '══════════════════════════════════════════════════'
 echo
 if [[ $p == vless ]]; then
   echo "[WebSocket TLS]"; echo "vless://$c@$d:$tls?encryption=none&security=tls&sni=$d&type=ws&host=$d&path=/vlessws#$name"; echo
   echo "[WebSocket Non-TLS]"; echo "vless://$c@$d:$ntls?encryption=none&security=none&type=ws&host=$d&path=/vlessws#$name"; echo
   echo "[HTTPUpgrade TLS]"; echo "vless://$c@$d:$tls?encryption=none&security=tls&sni=$d&type=httpupgrade&host=$d&path=/hu-vless#$name"; echo
   echo "[HTTPUpgrade Non-TLS]"; echo "vless://$c@$d:$ntls?encryption=none&security=none&type=httpupgrade&host=$d&path=/hu-vless#$name"; echo
   echo "[XHTTP TLS]"; echo "vless://$c@$d:$tls?encryption=none&security=tls&sni=$d&type=xhttp&host=$d&path=/xhttpvl&mode=auto#$name"; echo
   echo "[XHTTP Non-TLS]"; echo "vless://$c@$d:$ntls?encryption=none&security=none&type=xhttp&host=$d&path=/xhttpvl&mode=auto#$name"; echo
   echo "[gRPC TLS]"; echo "vless://$c@$d:$tls?encryption=none&security=tls&sni=$d&type=grpc&serviceName=vless-grpc&mode=gun#$name"; echo
   echo "[gRPC Non-TLS]"; echo "vless://$c@$d:$ntls?encryption=none&security=none&type=grpc&serviceName=vless-grpc&mode=gun#$name"; echo
   echo "[TCP HTTP TLS]"; echo "vless://$c@$d:$tcp_tls?encryption=none&security=tls&sni=$d&type=tcp&headerType=http&path=/&host=$d#$name"; echo
   echo "[TCP HTTP Non-TLS]"; echo "vless://$c@$d:$tcp_ntls?encryption=none&security=none&type=tcp&headerType=http&path=/&host=$d#$name"; echo
 elif [[ $p == trojan ]]; then
   echo "[WebSocket TLS]"; echo "trojan://$c@$d:$tls?security=tls&sni=$d&type=ws&host=$d&path=/trojan#$name"; echo
   echo "[WebSocket Non-TLS]"; echo "trojan://$c@$d:$ntls?security=none&type=ws&host=$d&path=/trojan#$name"; echo
   echo "[HTTPUpgrade TLS]"; echo "trojan://$c@$d:$tls?security=tls&sni=$d&type=httpupgrade&host=$d&path=/hu-trojan#$name"; echo
   echo "[HTTPUpgrade Non-TLS]"; echo "trojan://$c@$d:$ntls?security=none&type=httpupgrade&host=$d&path=/hu-trojan#$name"; echo
   echo "[XHTTP TLS]"; echo "trojan://$c@$d:$tls?security=tls&sni=$d&type=xhttp&host=$d&path=/xhttptr&mode=auto#$name"; echo
   echo "[XHTTP Non-TLS]"; echo "trojan://$c@$d:$ntls?security=none&type=xhttp&host=$d&path=/xhttptr&mode=auto#$name"; echo
   echo "[gRPC TLS]"; echo "trojan://$c@$d:$tls?security=tls&sni=$d&type=grpc&serviceName=trojan-grpc&mode=gun#$name"; echo
   echo "[gRPC Non-TLS]"; echo "trojan://$c@$d:$ntls?security=none&type=grpc&serviceName=trojan-grpc&mode=gun#$name"; echo
   echo "[TCP HTTP TLS]"; echo "trojan://$c@$d:$tcp_tls?security=tls&sni=$d&type=tcp&headerType=http&path=/&host=$d#$name"; echo
   echo "[TCP HTTP Non-TLS]"; echo "trojan://$c@$d:$tcp_ntls?security=none&type=tcp&headerType=http&path=/&host=$d#$name"; echo
 else
   vm(){ local net=$1 path=$2 sec=$3 port=$4 type=${5:-none}; local raw; raw=$(printf '{"v":"2","ps":"%s","add":"%s","port":"%s","id":"%s","aid":"0","scy":"auto","net":"%s","type":"%s","host":"%s","path":"%s","tls":"%s","sni":"%s"}' "$user" "$d" "$port" "$c" "$net" "$type" "$d" "$path" "$sec" "$([[ $sec == tls ]] && echo "$d")" | base64 -w0); echo "vmess://$raw"; }
   echo "[WebSocket TLS]"; vm ws /vmess tls "$tls"; echo
   echo "[WebSocket Non-TLS]"; vm ws /vmess '' "$ntls"; echo
   echo "[HTTPUpgrade TLS]"; vm httpupgrade /hu-vmess tls "$tls"; echo
   echo "[HTTPUpgrade Non-TLS]"; vm httpupgrade /hu-vmess '' "$ntls"; echo
   echo "[XHTTP TLS]"; vm xhttp /xhttpvm tls "$tls"; echo
   echo "[XHTTP Non-TLS]"; vm xhttp /xhttpvm '' "$ntls"; echo
   echo "[gRPC TLS]"; vm grpc vmess-grpc tls "$tls"; echo
   echo "[gRPC Non-TLS]"; vm grpc vmess-grpc '' "$ntls"; echo
   echo "[TCP HTTP TLS]"; vm tcp / tls "$tcp_tls" http; echo
   echo "[TCP HTTP Non-TLS]"; vm tcp / '' "$tcp_ntls" http; echo
 fi
 echo '══════════════════════════════════════════════════'
}

print_expired_section(){
 local exp="${1:-}" d label width=50 pad
 d="${exp%% *}"
 label="Expired : $d"
 pad=$(( (width-${#label})/2 )); ((pad<0)) && pad=0
 echo '══════════════════════════════════════════════════'
 printf '%*s%s
' "$pad" '' "$label"
}

create(){
