     /usr/local/rere/account-notify EXPIRED "$(proto_label "$p")" "${e%@*}" "Account auto deleted after expiry" >/dev/null 2>&1 || true
     changed=1
   done < <(sqlite3 "$DB" "SELECT email FROM accounts WHERE protocol='$p' AND expired <= '$now';")
   ((changed==1)) && restart_proto "$p"
 done
}
quota_daemon(){
