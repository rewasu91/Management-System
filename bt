#!/usr/bin/env bash
set -u
DB=/etc/kaizensc/database/ssh/database.json
LOG=/etc/kaizensc/log/ssh/expired.log
[[ -f "$DB" ]] || { mkdir -p "$(dirname "$DB")"; echo '[]' > "$DB"; }
jq empty "$DB" 2>/dev/null || exit 1
mkdir -p "$(dirname "$LOG")"
now=$(date +%s)
tmp=$(mktemp)
echo '[]' > "$tmp"
removed=0
while IFS= read -r account; do
  user=$(jq -r '.Username // empty' <<<"$account")
  exp=$(jq -r '.Expired // empty' <<<"$account")
  [[ -n "$user" ]] || continue
  exp_epoch=$(date -d "$exp" +%s 2>/dev/null || echo 0)
  if ((exp_epoch>0 && exp_epoch<=now)); then
    userdel -f -r "$user" >/dev/null 2>&1 || true
    rm -f /etc/kaizensc/limit/ssh/{ip,cache,quota,usage}/"$user" 2>/dev/null || true
    printf 'Expired: %s (Expired On: %s)\n' "$user" "$exp" >> "$LOG"
    /usr/local/rere/account-notify EXPIRED SSH "$user" "Expired: $exp; account auto deleted" >/dev/null 2>&1 || true
    removed=$((removed+1))
  else
    # Invalid/lifetime rows are preserved, never silently deleted from database.
    jq --argjson a "$account" '. += [$a]' "$tmp" > "$tmp.next" && mv "$tmp.next" "$tmp"
  fi
done < <(jq -c '.[]' "$DB")
mv "$tmp" "$DB"
((removed>0)) && echo "Expired SSH accounts removed: $removed" || true

