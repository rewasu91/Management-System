#!/usr/bin/env bash
CONFIG_PATH="/etc/zivpn/config.json"
PASSWORD_DB="/etc/zivpn/password.json"
[[ -f "$PASSWORD_DB" && -f "$CONFIG_PATH" ]] || exit 0

get_passwords(){ jq -r '.auth.config[]?' "$CONFIG_PATH" 2>/dev/null; }
update_passwords(){
  local json
  json=$(printf '%s\n' "$@" | jq -R . | jq -s .)
  jq --argjson a "$json" '.auth.config=$a' "$CONFIG_PATH" > "$CONFIG_PATH.tmp" && mv "$CONFIG_PATH.tmp" "$CONFIG_PATH"
  systemctl restart zivpn.service >/dev/null 2>&1 || true
}

now=$(date +%s)
mapfile -t active < <(get_passwords)
changed=0
while IFS=$'\t' read -r pass exp; do
  [[ -n "$pass" && -n "$exp" ]] || continue
  epoch=$(date -d "$exp" +%s 2>/dev/null || echo 0)
  if ((epoch>0 && epoch<=now)); then
    new=()
    for p in "${active[@]}"; do [[ "$p" == "$pass" ]] || new+=("$p"); done
    active=("${new[@]}")
    jq --arg p "$pass" 'del(.[]|select(.password==$p))' "$PASSWORD_DB" > "$PASSWORD_DB.tmp" && mv "$PASSWORD_DB.tmp" "$PASSWORD_DB"
    /usr/local/rere/account-notify EXPIRED ZiVPN "$pass" "Expired: $exp; password auto deleted" >/dev/null 2>&1 || true
    changed=1
  fi
done < <(jq -r '.[]|[.password,.expired]|@tsv' "$PASSWORD_DB" 2>/dev/null)
((changed)) && update_passwords "${active[@]}"

