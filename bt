#!/usr/bin/env bash
set -u
DB=/etc/kaizensc/database/ssh/database.json
[[ -s "$DB" ]] || exit 0
AUTH=$(mktemp); trap 'rm -f "$AUTH"' EXIT
{ [[ -r /var/log/auth.log ]] && tail -n 30000 /var/log/auth.log; [[ -r /var/log/secure ]] && tail -n 30000 /var/log/secure; journalctl --no-pager -n 30000 -u ssh.service -u sshd.service -u dropbear.service 2>/dev/null || true; } > "$AUTH"
active_count(){
 local u=$1 ips='' pid ip n sessions
 while read -r pid; do
   [[ -n "$pid" ]] || continue
   ip=$(grep -F "[$pid]" "$AUTH" 2>/dev/null | grep -Ei 'Accepted|auth succeeded' | tail -n1 | sed -nE 's/.* from ([0-9a-fA-F:.]+)( port [0-9]+)?.*/\1/p')
   [[ -n "$ip" && "$ip" != 127.0.0.1 && "$ip" != ::1 ]] && ips+="$ip"$'\n'
 done < <(ps -eo pid=,args= | awk -v u="$u" 'index($0,"sshd: "u"@") {print $1}')
 ips+=$(who 2>/dev/null | awk -v u="$u" '$1==u{gsub(/[()]/,"",$NF); print $NF}')$'\n'
 n=$(printf '%s' "$ips" | awk 'NF&&!seen[$0]++{n++}END{print n+0}')
 sessions=$(ps -eo args= | awk -v u="$u" 'index($0,"sshd: "u"@"){n++} END{print n+0}')
 ((n==0 && sessions>0)) && n=$sessions
 echo "$n"
}
jq 'map(if has("Locked") then . else . + {Locked:false} end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
while IFS=$'\t' read -r user limit locked; do
  [[ "$limit" =~ ^[0-9]+$ ]] || limit=0
  [[ "$locked" == true ]] && continue
  ((limit>0)) || continue
  count=$(active_count "$user")
  if ((count>limit)); then
    passwd -l "$user" >/dev/null 2>&1 || usermod -L "$user" >/dev/null 2>&1 || true
    jq --arg u "$user" 'map(if .Username==$u then .Locked=true else . end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
    mkdir -p /etc/kaizensc/recovery/ssh /etc/kaizensc/log/ssh
    printf '%s\tLOCK\tIP Limit (%s/%s)\t%s\n' "$user" "$count" "$limit" "$(date '+%F %T')" >> /etc/kaizensc/recovery/ssh/recovery.tsv
    printf '%s Locked User: %s | Active IP: %s | Max: %s\n' "$(date '+%F %T')" "$user" "$count" "$limit" >> /etc/kaizensc/log/ssh/limit.log
    /usr/local/rere/account-notify BANNED SSH "$user" "IP Limit: $count/$limit" >/dev/null 2>&1 || true
  fi
done < <(jq -r '.[]|[.Username,(.LimitIP//0),(.Locked//false)]|@tsv' "$DB")

