#!/usr/bin/env bash
set -euo pipefail

RERE=/usr/local/rere
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/kaizensc-bot-backup-fix-${STAMP}"

[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Please run as root."; exit 1; }
[[ -d "$RERE" ]] || { echo "KaizenSC not found: $RERE"; exit 1; }

mkdir -p "$BACKUP"

[[ -f "$RERE/account-notify" ]] && cp -a "$RERE/account-notify" "$BACKUP/account-notify" || true
cat > "$RERE/account-notify" <<'__KZN_ACCOUNT_NOTIFY__'
#!/usr/bin/env bash
set -u

BOT_DIR=/etc/kaizensc/bot/notif
BOT_KEY="$BOT_DIR/bot.key"
CHAT_ID="$BOT_DIR/client.id"

# Notification failures must never break account operations.
[[ -s "$BOT_KEY" && -s "$CHAT_ID" ]] || exit 0
command -v curl >/dev/null 2>&1 || exit 0

event="${1:-EVENT}"
protocol="${2:-Unknown}"
account="${3:-Unknown}"
detail="${4:-}"

bot_api=$(tr -d '\r\n' < "$BOT_KEY" 2>/dev/null)
chat_id=$(tr -d '\r\n' < "$CHAT_ID" 2>/dev/null)
[[ -n "$bot_api" && -n "$chat_id" ]] || exit 0

domain=$(cat /etc/xray/domain 2>/dev/null || hostname -f 2>/dev/null || hostname)
server_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
[[ -n "$server_ip" ]] || server_ip="-"
now=$(date '+%Y-%m-%d %H:%M:%S %Z')

case "$event" in
  CREATED) icon="✅" ;;
  EXTENDED) icon="🔄" ;;
  DELETED) icon="🗑️" ;;
  EXPIRED) icon="⌛" ;;
  LOCKED|BANNED) icon="🚫" ;;
  UNLOCKED) icon="🔓" ;;
  *) icon="ℹ️" ;;
esac

text="${icon} KaizenSC Account Notification
Event    : ${event}
Protocol : ${protocol}
Account  : ${account}"
[[ -n "$detail" ]] && text="${text}
Detail   : ${detail}"
text="${text}
Server   : ${domain}
IP VPS   : ${server_ip}
Time     : ${now}"

curl -fsS \
  --connect-timeout 5 \
  --max-time 12 \
  --retry 1 \
  -X POST "https://api.telegram.org/bot${bot_api}/sendMessage" \
  --data-urlencode "chat_id=${chat_id}" \
  --data-urlencode "text=${text}" \
  >/dev/null 2>&1 || true

exit 0

__KZN_ACCOUNT_NOTIFY__
chmod 0755 "$RERE/account-notify"
bash -n "$RERE/account-notify"

[[ -f "$RERE/backup" ]] && cp -a "$RERE/backup" "$BACKUP/backup" || true
cat > "$RERE/backup" <<'__KZN_BACKUP__'
#!/usr/bin/env bash
set -euo pipefail
source /usr/local/rere/kaizen-ui 2>/dev/null || true

ZIP_PASSWORD='KznAutoSC'
STAMP=$(date '+%Y%m%d-%H%M%S')
RAND=$(openssl rand -hex 3 2>/dev/null || printf '%06d' "$RANDOM")
ARCHIVE="/root/KaizenSC-Backup-${STAMP}-${RAND}.zip"
WORK=$(mktemp -d /tmp/kaizensc-backup.XXXXXX)
PAYLOAD="$WORK/backup"
BOT_DIR=/etc/kaizensc/bot/notif

cleanup(){ rm -rf "$WORK"; }
trap cleanup EXIT

green(){ printf '\e[0;32m%s\e[0m\n' "$*"; }
yellow(){ printf '\e[0;33m%s\e[0m\n' "$*"; }
red(){ printf '\e[0;31m%s\e[0m\n' "$*"; }

if declare -F kaizen_header >/dev/null 2>&1; then
  clear
  kaizen_header " • BACKUP DATABASE • "
else
  clear
  echo "=== BACKUP DATABASE ==="
fi

for cmd in zip unzip sha256sum jq find xargs; do
  command -v "$cmd" >/dev/null 2>&1 || {
    red "Required command is missing: $cmd"
    exit 1
  }
done

mkdir -p "$PAYLOAD/etc" "$PAYLOAD/root" "$PAYLOAD/var/www/html/fn"

copy_dir(){
  local src="$1" dst="$2"
  [[ -d "$src" ]] || return 0
  mkdir -p "$dst"
  cp -a "$src"/. "$dst"/
}
copy_file(){
  local src="$1" dst="$2"
  [[ -f "$src" ]] || return 0
  mkdir -p "$(dirname "$dst")"
  cp -a "$src" "$dst"
}

green "Collecting important KaizenSC data..."

# 1) Account databases and settings. Avoid runtime traffic/cache/log files.
copy_dir /etc/kaizensc/database "$PAYLOAD/etc/kaizensc/database"
copy_dir /etc/kaizensc/bot "$PAYLOAD/etc/kaizensc/bot"
copy_dir /etc/kaizensc/recovery "$PAYLOAD/etc/kaizensc/recovery"
copy_dir /etc/kaizensc/config "$PAYLOAD/etc/kaizensc/config"
copy_dir /etc/kaizensc/xray "$PAYLOAD/etc/kaizensc/xray"
copy_file /etc/kaizensc/text-brightness.conf "$PAYLOAD/etc/kaizensc/text-brightness.conf"

# Limit definitions are useful; usage/cache counters are intentionally excluded
# so a restored VPS does not immediately ban users because of stale history.
if [[ -d /etc/kaizensc/limit ]]; then
  copy_dir /etc/kaizensc/limit "$PAYLOAD/etc/kaizensc/limit"
  find "$PAYLOAD/etc/kaizensc/limit" -type d \( -name usage -o -name cache \) -prune -exec rm -rf {} + 2>/dev/null || true
fi

# User-adjustable protocol configuration only; binaries are reinstalled by autoscript.
copy_file /etc/kaizensc/udp-custom/config.json "$PAYLOAD/etc/kaizensc/udp-custom/config.json"
copy_file /etc/kaizensc/udp-request/config.json "$PAYLOAD/etc/kaizensc/udp-request/config.json"
copy_file /etc/kaizensc/websocket/config.yaml "$PAYLOAD/etc/kaizensc/websocket/config.yaml"
copy_file /etc/kaizensc/slowdns/server.key "$PAYLOAD/etc/kaizensc/slowdns/server.key"
copy_file /etc/kaizensc/slowdns/server.pub "$PAYLOAD/etc/kaizensc/slowdns/server.pub"

# Make a transaction-consistent Xray SQLite snapshot.
XRAY_DB=/etc/kaizensc/database/xray/accounts.db
SNAP_DB="$PAYLOAD/etc/kaizensc/database/xray/accounts.db"
if [[ -f "$XRAY_DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
  mkdir -p "$(dirname "$SNAP_DB")"
  rm -f "$SNAP_DB" "$SNAP_DB-wal" "$SNAP_DB-shm"
  sqlite3 "$XRAY_DB" ".timeout 10000" ".backup '$SNAP_DB'" ||
    cp -a "$XRAY_DB" "$SNAP_DB"
fi

# 2) Domain / certificate / tunnel data.
copy_dir /etc/xray "$PAYLOAD/etc/xray"
copy_dir /etc/letsencrypt "$PAYLOAD/etc/letsencrypt"
copy_dir /etc/cloudflared "$PAYLOAD/etc/cloudflared"
copy_dir /root/.cloudflared "$PAYLOAD/root/.cloudflared"

# 3) Protocol databases/configs not stored under /etc/kaizensc.
copy_dir /etc/shadowsocks-libev "$PAYLOAD/etc/shadowsocks-libev"
copy_dir /etc/zivpn "$PAYLOAD/etc/zivpn"
copy_file /usr/local/bin/zivpn "$PAYLOAD/usr/local/bin/zivpn"
copy_file /etc/systemd/system/zivpn.service "$PAYLOAD/etc/systemd/system/zivpn.service"

# WireGuard generated client files; WireGuard account DB itself is under kaizensc/database.
if compgen -G '/var/www/html/fn/wg-*.conf' >/dev/null; then
  cp -a /var/www/html/fn/wg-*.conf "$PAYLOAD/var/www/html/fn/" 2>/dev/null || true
fi

# Small user customizations.
copy_file /etc/issue.net "$PAYLOAD/etc/issue.net"
copy_file /etc/dns-manager-selected.conf "$PAYLOAD/etc/dns-manager-selected.conf"

# Machine identity files such as old public IP/ISP/country are not included.

# Validate critical databases before packaging.
SSH_DB="$PAYLOAD/etc/kaizensc/database/ssh/database.json"
if [[ -f "$SSH_DB" ]]; then
  jq empty "$SSH_DB" >/dev/null 2>&1 || {
    red "SSH database is invalid. Backup cancelled."
    exit 1
  }
fi
if [[ -f "$SNAP_DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
  [[ "$(sqlite3 "$SNAP_DB" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || {
    red "Xray database integrity check failed. Backup cancelled."
    exit 1
  }
fi

cat > "$PAYLOAD/MANIFEST.json" <<EOF
{
  "product": "KaizenSC",
  "backup_schema": 2,
  "created_at": "$(date '+%Y-%m-%d %H:%M:%S %Z')",
  "hostname": "$(hostname 2>/dev/null || echo unknown)",
  "domain": "$(cat /etc/xray/domain 2>/dev/null || echo unknown)",
  "password": "KznAutoSC",
  "restore_model": "fresh KaizenSC install + database restore",
  "notes": [
    "System passwd/shadow/group files are intentionally not included.",
    "Systemd units and package files are intentionally not included.",
    "Runtime IP/quota usage/cache history is intentionally not included.",
    "SSH users are recreated safely from the KaizenSC SSH database."
  ]
}
EOF

cat > "$PAYLOAD/README-RESTORE.txt" <<'EOF'
KaizenSC Database Backup
========================
This archive contains important KaizenSC account/database/configuration data only.

Recommended restore method on another VPS:
1. Install the same/latest KaizenSC autoscript first.
2. Copy this ZIP to /root on the new VPS.
3. Open System VPS > Bot & Backup Manager > Restore Database.
4. The restore script validates ZIP integrity/checksums before changing the system.

The backup intentionally excludes:
- /etc/passwd, /etc/shadow, /etc/group, /etc/gshadow
- the whole /etc/systemd/system directory
- package/binary files that the fresh installer recreates
- runtime login/IP/quota usage/cache history

SSH accounts are recreated from /etc/kaizensc/database/ssh/database.json.
EOF

# Checksums make partial/corrupt backups fail before restore.
(
  cd "$WORK"
  find backup -type f ! -name SHA256SUMS -print0 |
    sort -z |
    xargs -0 sha256sum > backup/SHA256SUMS
)

green "Creating protected ZIP..."
(
  cd "$WORK"
  zip -q -r -P "$ZIP_PASSWORD" "$ARCHIVE" backup
)

[[ -s "$ARCHIVE" ]] || {
  red "Failed to create backup ZIP."
  exit 1
}

# Final ZIP test before reporting success.
unzip -P "$ZIP_PASSWORD" -t "$ARCHIVE" >/dev/null 2>&1 || {
  rm -f "$ARCHIVE"
  red "ZIP integrity test failed."
  exit 1
}

size_bytes=$(stat -c %s "$ARCHIVE" 2>/dev/null || echo 0)
size_human=$(du -h "$ARCHIVE" | awk '{print $1}')

telegram_status="Not configured"
if [[ -s "$BOT_DIR/bot.key" && -s "$BOT_DIR/client.id" && "$size_bytes" -le 47185920 ]] && command -v curl >/dev/null 2>&1; then
  token=$(tr -d '\r\n' < "$BOT_DIR/bot.key")
  chat=$(tr -d '\r\n' < "$BOT_DIR/client.id")
  caption="KaizenSC Database Backup
File: $(basename "$ARCHIVE")
Size: $size_human
Password: KznAutoSC
Restore: Install KaizenSC on the new VPS first, then use Restore Database."
  if curl -fsS --connect-timeout 10 --max-time 180 \
      -X POST "https://api.telegram.org/bot${token}/sendDocument" \
      -F "chat_id=${chat}" \
      -F "document=@${ARCHIVE}" \
      -F "caption=${caption}" >/dev/null 2>&1; then
    telegram_status="Sent successfully"
  else
    telegram_status="Send failed; local backup kept"
  fi
elif (( size_bytes > 47185920 )); then
  telegram_status="Archive is over 45 MB; local backup kept"
fi

clear
if declare -F kaizen_header >/dev/null 2>&1; then
  kaizen_header " • BACKUP DATABASE COMPLETED • "
fi
green "Backup completed successfully."
echo
echo "Backup File : $ARCHIVE"
echo "Backup Size : $size_human"
echo "Password    : $ZIP_PASSWORD"
echo "Telegram    : $telegram_status"
echo
yellow "The local ZIP is kept in /root. Do not delete it until you confirm the backup can be opened."

__KZN_BACKUP__
chmod 0755 "$RERE/backup"
bash -n "$RERE/backup"

[[ -f "$RERE/restore" ]] && cp -a "$RERE/restore" "$BACKUP/restore" || true
cat > "$RERE/restore" <<'__KZN_RESTORE__'
#!/usr/bin/env bash
set -euo pipefail
source /usr/local/rere/kaizen-ui 2>/dev/null || true

DEFAULT_PASSWORD='KznAutoSC'
LEGACY_PASSWORD='Rerechan02'
WORK=$(mktemp -d /tmp/kaizensc-restore.XXXXXX)
DOWNLOAD_FILE="$WORK/download.zip"
PRE="/root/kaizensc-pre-restore-$(date '+%Y%m%d-%H%M%S')"

cleanup(){ rm -rf "$WORK"; }
trap cleanup EXIT

green(){ printf '\e[0;32m%s\e[0m\n' "$*"; }
yellow(){ printf '\e[0;33m%s\e[0m\n' "$*"; }
red(){ printf '\e[0;31m%s\e[0m\n' "$*"; }

header(){
  clear
  if declare -F kaizen_header >/dev/null 2>&1; then
    kaizen_header " • $1 • "
  else
    echo "=== $1 ==="
  fi
}

need(){
  command -v "$1" >/dev/null 2>&1 || {
    red "Required command is missing: $1"
    exit 1
  }
}

for cmd in unzip jq awk getent useradd usermod passwd chpasswd chage sha256sum; do need "$cmd"; done

header "RESTORE DATABASE"
echo "Restore is designed for a VPS where KaizenSC is already installed."
echo "It restores account databases/configuration, not old OS/system files."
echo

# Pick newest local KaizenSC backup if present.
backup_file=$(ls -1t /root/KaizenSC-Backup-*.zip 2>/dev/null | head -1 || true)

if [[ -n "$backup_file" ]]; then
  echo "Local backup found:"
  echo "  $backup_file"
  echo
  read -rp "Use this backup? (y/n): " use_local
  [[ "$use_local" =~ ^[Yy]$ ]] || backup_file=""
fi

if [[ -z "$backup_file" ]]; then
  echo "Enter one of the following:"
  echo "- Local ZIP path, e.g. /root/KaizenSC-Backup-xxxx.zip"
  echo "- Direct HTTPS URL"
  echo
  read -rp "Backup path / URL: " input
  [[ -n "$input" ]] || { red "Restore cancelled."; exit 1; }

  if [[ "$input" == http://* || "$input" == https://* ]]; then
    need curl
    green "Downloading backup..."
    curl -fL \
      --retry 3 \
      --retry-delay 2 \
      --connect-timeout 15 \
      --max-time 600 \
      -o "$DOWNLOAD_FILE" "$input" || {
        red "Backup download failed."
        exit 1
      }
    backup_file="$DOWNLOAD_FILE"
  else
    backup_file="$input"
  fi
fi

[[ -f "$backup_file" && -s "$backup_file" ]] || {
  red "Backup ZIP was not found or is empty: $backup_file"
  exit 1
}

# Detect supported password.
ZIP_PASSWORD=""
if unzip -P "$DEFAULT_PASSWORD" -t "$backup_file" >/dev/null 2>&1; then
  ZIP_PASSWORD="$DEFAULT_PASSWORD"
elif unzip -P "$LEGACY_PASSWORD" -t "$backup_file" >/dev/null 2>&1; then
  ZIP_PASSWORD="$LEGACY_PASSWORD"
else
  red "Backup ZIP is damaged or the password is unsupported."
  exit 1
fi

green "ZIP integrity check passed."
mkdir -p "$WORK/extract"
unzip -q -P "$ZIP_PASSWORD" "$backup_file" -d "$WORK/extract"

SRC="$WORK/extract/backup"
[[ -d "$SRC" ]] || {
  red "Invalid backup structure: backup/ directory is missing."
  exit 1
}

LEGACY=0
if [[ -f "$SRC/MANIFEST.json" ]]; then
  schema=$(jq -r '.backup_schema // 0' "$SRC/MANIFEST.json" 2>/dev/null || echo 0)
  [[ "$schema" == "2" ]] || {
    red "Unsupported KaizenSC backup schema: $schema"
    exit 1
  }

  [[ -f "$SRC/SHA256SUMS" ]] || {
    red "Checksum manifest is missing."
    exit 1
  }

  green "Verifying backup checksums..."
  (
    cd "$WORK/extract"
    sha256sum -c backup/SHA256SUMS >/dev/null
  ) || {
    red "Checksum verification failed. No files were restored."
    exit 1
  }

  KZN_SRC="$SRC/etc/kaizensc"
  XRAY_SRC="$SRC/etc/xray"
  SS_SRC="$SRC/etc/shadowsocks-libev"
  ZI_SRC="$SRC/etc/zivpn"
  LE_SRC="$SRC/etc/letsencrypt"
  CF_SRC="$SRC/etc/cloudflared"
  ROOT_CF_SRC="$SRC/root/.cloudflared"
  WG_WEB_SRC="$SRC/var/www/html/fn"
  ZI_BIN_SRC="$SRC/usr/local/bin/zivpn"
  ZI_UNIT_SRC="$SRC/etc/systemd/system/zivpn.service"
else
  # Selective compatibility with older KaizenSC backups. Dangerous OS files
  # such as passwd/shadow/systemd are deliberately ignored.
  LEGACY=1
  yellow "Legacy backup detected. Restoring only safe KaizenSC data."
  KZN_SRC="$SRC/kaizensc"
  XRAY_SRC="$SRC/xray"
  SS_SRC="$SRC/shadowsocks-libev"
  ZI_SRC="$SRC/zivpn"
  LE_SRC="$SRC/letsencrypt"
  CF_SRC="$SRC/cloudflared"
  ROOT_CF_SRC="$SRC/.cloudflared"
  WG_WEB_SRC=""
  ZI_BIN_SRC=""
  ZI_UNIT_SRC=""
fi

# Validate account databases BEFORE touching current system.
SSH_DB_SRC="$KZN_SRC/database/ssh/database.json"
if [[ -f "$SSH_DB_SRC" ]]; then
  jq empty "$SSH_DB_SRC" >/dev/null 2>&1 || {
    red "SSH account database is invalid. Restore cancelled."
    exit 1
  }
fi

XRAY_DB_SRC="$KZN_SRC/database/xray/accounts.db"
if [[ -f "$XRAY_DB_SRC" ]] && command -v sqlite3 >/dev/null 2>&1; then
  [[ "$(sqlite3 "$XRAY_DB_SRC" 'PRAGMA quick_check;' 2>/dev/null)" == "ok" ]] || {
    red "Xray account database integrity check failed. Restore cancelled."
    exit 1
  }
fi

header "RESTORE DATABASE"
echo "Backup       : $backup_file"
echo "Password     : $ZIP_PASSWORD"
echo "Backup Type  : $([[ $LEGACY -eq 1 ]] && echo Legacy || echo 'Schema 2')"
echo
yellow "A rollback copy of current KaizenSC data will be stored at:"
echo "  $PRE"
echo
read -rp "Continue restore? (y/n): " answer
[[ "$answer" =~ ^[Yy]$ ]] || { echo "Restore cancelled."; exit 0; }

mkdir -p "$PRE"
[[ -d /etc/kaizensc ]] && cp -a /etc/kaizensc "$PRE/kaizensc" 2>/dev/null || true
[[ -d /etc/xray ]] && cp -a /etc/xray "$PRE/xray" 2>/dev/null || true
[[ -d /etc/shadowsocks-libev ]] && cp -a /etc/shadowsocks-libev "$PRE/shadowsocks-libev" 2>/dev/null || true
[[ -d /etc/zivpn ]] && cp -a /etc/zivpn "$PRE/zivpn" 2>/dev/null || true

# Stop only services whose live config/data is being replaced.
for svc in xray-vless xray-vmess xray-trojan zivpn; do
  systemctl stop "$svc" >/dev/null 2>&1 || true
done

merge_dir(){
  local src="$1" dst="$2"
  [[ -d "$src" ]] || return 0
  mkdir -p "$dst"
  cp -a "$src"/. "$dst"/
}
copy_file(){
  local src="$1" dst="$2"
  [[ -f "$src" ]] || return 0
  mkdir -p "$(dirname "$dst")"
  cp -a "$src" "$dst"
}

green "Restoring KaizenSC databases and configuration..."
merge_dir "$KZN_SRC" /etc/kaizensc
merge_dir "$XRAY_SRC" /etc/xray
merge_dir "$SS_SRC" /etc/shadowsocks-libev
merge_dir "$ZI_SRC" /etc/zivpn
merge_dir "$LE_SRC" /etc/letsencrypt
merge_dir "$CF_SRC" /etc/cloudflared
merge_dir "$ROOT_CF_SRC" /root/.cloudflared
[[ -n "$WG_WEB_SRC" ]] && merge_dir "$WG_WEB_SRC" /var/www/html/fn
if [[ -n "${ZI_BIN_SRC:-}" && -f "$ZI_BIN_SRC" ]]; then
  copy_file "$ZI_BIN_SRC" /usr/local/bin/zivpn
  chmod 0755 /usr/local/bin/zivpn
fi
if [[ -n "${ZI_UNIT_SRC:-}" && -f "$ZI_UNIT_SRC" ]]; then
  copy_file "$ZI_UNIT_SRC" /etc/systemd/system/zivpn.service
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable zivpn >/dev/null 2>&1 || true
fi

if [[ $LEGACY -eq 0 ]]; then
  copy_file "$SRC/etc/issue.net" /etc/issue.net
  copy_file "$SRC/etc/dns-manager-selected.conf" /etc/dns-manager-selected.conf
fi

# Do not restore stale runtime counters from any backup.
find /etc/kaizensc/limit -type d \( -name usage -o -name cache \) -prune -exec sh -c 'rm -f "$1"/* 2>/dev/null || true' _ {} \; 2>/dev/null || true

# Recreate SSH member accounts from KaizenSC DB; never overwrite OS passwd/shadow.
SSH_DB=/etc/kaizensc/database/ssh/database.json
ssh_restored=0
ssh_skipped=0
if [[ -f "$SSH_DB" ]]; then
  while IFS=$'\t' read -r user pass exp locked; do
    [[ -n "$user" ]] || continue

    # Only safe account names.
    [[ "$user" =~ ^[A-Za-z0-9_.-]+$ ]] || { ssh_skipped=$((ssh_skipped+1)); continue; }

    if getent passwd "$user" >/dev/null 2>&1; then
      uid=$(getent passwd "$user" | awk -F: '{print $3}')
      if [[ ! "$uid" =~ ^[0-9]+$ ]] || ((uid<1000 || uid==65534)); then
        yellow "Skipped system username: $user"
        ssh_skipped=$((ssh_skipped+1))
        continue
      fi
      usermod -s /usr/sbin/nologin "$user" >/dev/null 2>&1 || true
    else
      useradd --shell /usr/sbin/nologin "$user" >/dev/null 2>&1 || {
        yellow "Failed to recreate SSH user: $user"
        ssh_skipped=$((ssh_skipped+1))
        continue
      }
    fi

    [[ -n "$pass" && "$pass" != "null" ]] && printf '%s:%s\n' "$user" "$pass" | chpasswd >/dev/null 2>&1 || true

    if [[ -n "$exp" && "$exp" != "null" && "$exp" != "Lifetime" ]]; then
      # chage is date-only. +1 day prevents an exact-time account from being
      # disabled at 00:00 before KaizenSC's exact expiry daemon runs.
      chage_date=$(date -d "${exp%% *} +1 day" +%F 2>/dev/null || true)
      [[ -n "$chage_date" ]] && chage -E "$chage_date" "$user" >/dev/null 2>&1 || true
    fi

    if [[ "$locked" == "true" || "$locked" == "1" ]]; then
      passwd -l "$user" >/dev/null 2>&1 || true
    else
      passwd -u "$user" >/dev/null 2>&1 || true
    fi

    ssh_restored=$((ssh_restored+1))
  done < <(jq -r '.[] | [.Username, (.Password//""), (.Expired//""), (.Locked//false)] | @tsv' "$SSH_DB")
fi

# Re-enable Shadowsocks account services using the fresh VPS's service template.
if [[ -f /etc/shadowsocks-libev/akun.conf ]]; then
  while read -r username; do
    [[ -n "$username" ]] || continue
    for suffix in tls http; do
      unit="shadowsocks-libev-server@${username}-${suffix}.service"
      systemctl enable --now "$unit" >/dev/null 2>&1 || true
    done
  done < <(awk '/^### / {print $2}' /etc/shadowsocks-libev/akun.conf | sort -u)
fi

# Restart only services already installed by the fresh autoscript.
for svc in xray-vless xray-vmess xray-trojan haproxy nginx sslh ssh cron zivpn cloudflared; do
  if systemctl cat "$svc" >/dev/null 2>&1; then
    systemctl restart "$svc" >/dev/null 2>&1 || true
  fi
done

# Ensure restored database files have safe root ownership.
chown -R root:root /etc/kaizensc /etc/xray /etc/shadowsocks-libev /etc/zivpn 2>/dev/null || true
chmod 600 /etc/kaizensc/bot/notif/bot.key /etc/kaizensc/bot/notif/client.id 2>/dev/null || true

header "RESTORE DATABASE COMPLETED"
green "Restore completed successfully."
echo
echo "SSH Accounts Recreated : $ssh_restored"
echo "SSH Accounts Skipped   : $ssh_skipped"
echo "Rollback Copy          : $PRE"
echo
echo "Restored important account/database/configuration data only."
echo "Old OS passwd/shadow/systemd files were NOT restored."

__KZN_RESTORE__
chmod 0755 "$RERE/restore"
