#!/usr/bin/env bash
log_file="/var/log/expired-ss.log"
akun_conf="/etc/shadowsocks-libev/akun.conf"
[[ -f "$akun_conf" ]] || exit 0
now=$(date +%s)
echo "[$(date)] Checking expired Shadowsocks accounts..." >> "$log_file"
while read -r user exp; do
  [[ -n "$user" && -n "$exp" ]] || continue
  exp_epoch=$(date -d "$exp" +%s 2>/dev/null || echo 0)
  if ((exp_epoch>0 && exp_epoch<=now)); then
    sed -i "/^### $user $exp$/,/^port_http /d" "$akun_conf"
    systemctl disable --now "shadowsocks-libev-server@$user-tls.service" "shadowsocks-libev-server@$user-http.service" >/dev/null 2>&1 || true
    rm -f "/etc/shadowsocks-libev/$user-tls.json" "/etc/shadowsocks-libev/$user-http.json"
    echo "[$(date)] Account $user expired ($exp) and was removed." >> "$log_file"
    /usr/local/rere/account-notify EXPIRED Shadowsocks "$user" "Expired: $exp; account auto deleted" >/dev/null 2>&1 || true
  fi
done < <(awk '/^### /{print $2,$3}' "$akun_conf")

