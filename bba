#!/usr/bin/env bash
set -euo pipefail
TARGET=/usr/local/rere/xray-account
BACKUP=/root/xray-account-backup-$(date +%Y%m%d-%H%M%S)
[[ $EUID -eq 0 ]] || { echo "[ERROR] Run as root."; exit 1; }
[[ -f "$TARGET" ]] || { echo "[ERROR] $TARGET not found."; exit 1; }
cp -a "$TARGET" "$BACKUP"
echo "[INFO] Backup: $BACKUP"
tmp=$(mktemp)
base64 -d <<'PAYLOAD' | gzip -dc > "$tmp"

PAYLOAD
printf '%s  %s
' '5eedef938ce6e6050d0c35ef2f152860323f65303097f046a8e1827de8618933' "$tmp" | sha256sum -c - >/dev/null
bash -n "$tmp"
install -m 0755 "$tmp" "$TARGET"
rm -f "$tmp"
echo "[OK] Xray account manager updated."
echo "[OK] Unlock now clears account login/IP history and resets Xray stats baseline."
echo "[OK] Extend supports custom YYYY-MM-DD or add-days mode."
echo "[OK] Action lists now show expiry dates; Unlock shows only locked accounts."
