#!/usr/bin/env bash
set -euo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo 'Please run as root.'; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo 'Installing python3...'; DEBIAN_FRONTEND=noninteractive apt-get update -y && DEBIAN_FRONTEND=noninteractive apt-get install -y python3; }
STAMP=$(date +%Y%m%d-%H%M%S)
BACKUP="/root/kaizensc-system-ui-backup-$STAMP"
mkdir -p "$BACKUP/usr/local/rere"
FILES=(restore menu-system menu-argo bot-menu bmenu menu-admin adjust-text-brightness menu-api menu-domain detail fn-sc1 backup)
for f in "${FILES[@]}"; do
  [[ -e "/usr/local/rere/$f" ]] && cp -a "/usr/local/rere/$f" "$BACKUP/usr/local/rere/$f"
done
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
printf '%s' '' | base64 -d > "$TMP/payload.tar.gz"
tar -xzf "$TMP/payload.tar.gz" -C "$TMP"
install -d /usr/local/rere
cp -a "$TMP/usr/local/rere/." /usr/local/rere/
chmod +x /usr/local/rere/{restore,menu-system,menu-argo,bot-menu,bmenu,menu-admin,adjust-text-brightness,menu-api,menu-domain,detail,fn-sc1,backup}
# Preserve current selection. If state is missing or invalid, use Normal / Not Bright.
mode='normal'
if [[ -f /etc/kaizensc/text-brightness.conf ]]; then
  case "$(cat /etc/kaizensc/text-brightness.conf 2>/dev/null)" in
    bold) mode='bold' ;;
    normal) mode='normal' ;;
  esac
fi
/usr/local/rere/adjust-text-brightness --apply "$mode"
echo "Patch completed successfully."
echo "Backup: $BACKUP"
echo "Brightness mode applied: $mode"
echo "Normal white now uses ANSI 0;37 (non-bold standard white)."
