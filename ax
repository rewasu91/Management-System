#!/usr/bin/env bash

# === COLOUR ===
export red='\033[0;31m'
export NC='\033[0m'
export cyan='\e[0;36m'
export green='\e[0;32m'
RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
CYAN='\e[0;36m'
WHITE='\e[0;97m'
red='\e[0;31m'
green='\e[0;32m'
yellow='\e[0;33m'
cyan='\e[0;36m'
white='\e[0;97m'
plain='\e[0m'
bgPutih='\e[0;47;30m'
keatas="${CYAN}│${plain}"

# === RAINBOW LINE ===
cmd() {
    printf '  '
    local i
    for i in {52..57} {57..52}; do
        printf "\e[38;5;${i}m────\e[0m"
    done
    echo
}

# === SAFE HELPERS ===
read_file() {
    [[ -r "$1" ]] && tr -d '\r\n' < "$1"
}

check_service() {
    local svc="$1"
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        printf '%bONLINE%b' "$GREEN" "$NC"
    else
        printf '%bOFFLINE%b' "$RED" "$NC"
    fi
}

check_any_service() {
    local svc
    for svc in "$@"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf '%bONLINE%b' "$GREEN" "$NC"
            return 0
        fi
    done
    printf '%bOFFLINE%b' "$RED" "$NC"
}

count_xray() {
    local proto="$1"
    local n
    n=$(/usr/local/rere/xray-account count "$proto" 2>/dev/null | tail -n1 | tr -dc '0-9')
    printf '%s' "${n:-0}"
}

# === VPS INFO ===
OS=$(hostnamectl 2>/dev/null | awk -F: '/Operating System/{sub(/^[[:space:]]+/,"",$2); print $2; exit}')
[[ -z "$OS" && -r /etc/os-release ]] && OS=$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-$NAME}")
OS=${OS:-Unknown}
RAM=$(free -m 2>/dev/null | awk '/Mem:/ {print $2; exit}')
RAM=${RAM:-0}
ISP=$(read_file /root/.isp)
ISP=${ISP:-Unknown}
COUNTRY=$(read_file /root/.country)
if [[ -z "$COUNTRY" ]]; then
    if command -v jq >/dev/null 2>&1; then
        COUNTRY=$(curl -4 -fsS --max-time 4 https://ipwho.is/ 2>/dev/null | jq -r '.country // empty' 2>/dev/null || true)
    fi
    [[ -n "$COUNTRY" ]] || COUNTRY=$(curl -4 -fsS --max-time 4 ipinfo.io/country 2>/dev/null || true)
fi
COUNTRY=${COUNTRY:-Unknown}
VPS_IP=$(read_file /root/.ip)
[[ -n "$VPS_IP" ]] || VPS_IP=$(curl -4 -fsS --max-time 4 ipinfo.io/ip 2>/dev/null || true)
VPS_IP=${VPS_IP:-Unknown}
DOMAIN=$(read_file /etc/xray/domain)
DOMAIN=${DOMAIN:-Unknown}

UPTIME_SECONDS=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
[[ "$UPTIME_SECONDS" =~ ^[0-9]+$ ]] || UPTIME_SECONDS=0
UPTIME_HOURS=$((UPTIME_SECONDS / 3600))
UPTIME_MINUTES=$(((UPTIME_SECONDS % 3600) / 60))
UPTIME_TEXT="${UPTIME_HOURS} hours, ${UPTIME_MINUTES} minutes"

# === CLIENT DETAILS ===
PERMISSION_URL='https://kznsc.kznvpn.com/izin.txt'
LOCAL_IP=$(read_file /root/.ip)
[[ -z "$LOCAL_IP" ]] && LOCAL_IP=$(curl -4 -fsS --max-time 4 ipinfo.io/ip 2>/dev/null || true)
CLIENT_NAME='Unknown'
CLIENT_IP=${LOCAL_IP:-Unknown}
EXP_DATE='Unknown'
DAYS_LEFT='0'

calculate_remaining_days() {
    local expired_date="$1" today expiry
    today=$(date +%s)
    expiry=$(date -d "$expired_date" +%s 2>/dev/null) || return 1
    echo $(( (expiry - today) / 86400 ))
}

if [[ -n "$LOCAL_IP" ]]; then
    PERMISSION_DATA=$(curl -fsS --max-time 8 "$PERMISSION_URL" 2>/dev/null || true)
    if [[ -n "$PERMISSION_DATA" ]]; then
        MATCH=$(printf '%s\n' "$PERMISSION_DATA" | awk -v ip="$LOCAL_IP" '$0 ~ /###/ && $3 == ip {print; exit}')
        if [[ -n "$MATCH" ]]; then
            CLIENT_NAME=$(awk '{print $2}' <<< "$MATCH")
            CLIENT_IP=$(awk '{print $3}' <<< "$MATCH")
            EXP_DATE=$(awk '{print $5}' <<< "$MATCH")
            DAYS_LEFT=$(calculate_remaining_days "$EXP_DATE" 2>/dev/null || echo 0)
        fi
    fi
fi

# === BANDWIDTH USAGE FROM VNSTAT ===
format_bytes() {
    local bytes="${1:-0}"
    awk -v b="$bytes" 'BEGIN {
        if (b >= 1099511627776) printf "%.2f TB", b/1099511627776;
        else if (b >= 1073741824) printf "%.2f GB", b/1073741824;
        else if (b >= 1048576) printf "%.2f MB", b/1048576;
        else if (b >= 1024) printf "%.2f KB", b/1024;
        else printf "%.2f MB", b/1048576;
    }'
}

TTODAY_BYTES=0
TYEST_BYTES=0
TMON_BYTES=0

# Prefer vnStat JSON because it is stable across vnStat display formats.
if command -v vnstat >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    VNJSON=$(vnstat --json 2>/dev/null || true)
    if [[ -n "$VNJSON" ]]; then
        TTODAY_BYTES=$(jq '[.interfaces[].traffic.day // [] | .[] | select(.date.year == (now|strftime("%Y")|tonumber) and .date.month == (now|strftime("%m")|tonumber) and .date.day == (now|strftime("%d")|tonumber)) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
        TYEST_BYTES=$(jq '[.interfaces[].traffic.day // [] | .[] | select((.date.year|tostring)+"-"+(.date.month|tostring)+"-"+(.date.day|tostring) == ((now-86400)|strftime("%Y-%-m-%-d"))) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
        TMON_BYTES=$(jq '[.interfaces[].traffic.month // [] | .[] | select(.date.year == (now|strftime("%Y")|tonumber) and .date.month == (now|strftime("%m")|tonumber)) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
    fi
fi

ttoday=$(format_bytes "$TTODAY_BYTES")
tyest=$(format_bytes "$TYEST_BYTES")
tmon=$(format_bytes "$TMON_BYTES")

# === SERVICE STATUS ===
status_xray_vless=$(check_service xray-vless)
status_xray_vmess=$(check_service xray-vmess)
status_xray_trojan=$(check_service xray-trojan)
status_ssh=$(check_any_service ssh sshd)
status_sslh=$(check_service sslh)
status_nginx=$(check_service nginx)
status_haproxy=$(check_service haproxy)
status_shadowsocks=$(check_any_service shadowsocks-libev shadowsocks-libev.service)

# === TOTAL ACTIVE USERS ===
xray_vless_user=$(count_xray vless)
xray_vmess_user=$(count_xray vmess)
xray_trojan_user=$(count_xray trojan)
ssh_dropbear_user=$(awk -F: '$3 >= 1000 && $1 != "nobody" && $7 !~ /(nologin|false)$/ {n++} END{print n+0}' /etc/passwd 2>/dev/null)
ss_user=$(grep -c '###' /etc/shadowsocks-libev/akun.conf 2>/dev/null || true)
ssh_dropbear_user=${ssh_dropbear_user:-0}
ss_user=${ss_user:-0}

# === DISPLAY INFORMATION ===
clear
echo -e ''
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}           • VPS DETAIL INFORMATION •          ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
echo -e "${white}  OS               : $OS"
echo -e "${white}  RAM              : ${RAM} MB"
echo -e "${white}  ISP              : $ISP"
echo -e "${white}  Country          : $COUNTRY"
echo -e "${white}  IP               : $VPS_IP"
echo -e "${white}  Domain           : $DOMAIN"
echo -e "${white}  Uptime           : ${GREEN}$UPTIME_TEXT${white}"
echo -e "${white}  Usage Today      : ${GREEN}$ttoday${white}"
echo -e "${white}  Usage Yesterday  : ${GREEN}$tyest${white}"
echo -e "${white}  Usage Monthly    : ${GREEN}$tmon${NC}"
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}               • SERVICE STATUS •              ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "SSH" "$status_ssh" "SSLH" "$status_sslh"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray Vless" "$status_xray_vless" "Shadowsocks" "$status_shadowsocks"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray Vmess" "$status_xray_vmess" "Nginx" "$status_nginx"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray Trojan" "$status_xray_trojan" "Haproxy" "$status_haproxy"
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}                • TOTAL ACCOUNT •              ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
printf "${white}     %-12s : %s   %-12s : %s\n" "SSH/Dropbear" "$ssh_dropbear_user" "Xray VLESS" "$xray_vless_user"
printf "${white}     %-12s : %s   %-12s : %s\n" "Xray VMess" "$xray_vmess_user" "Xray Trojan" "$xray_trojan_user"
printf "${white}     %-12s : %s\n" "Shadowsocks" "$ss_user"
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}               • CLIENT DETAILS •              ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
echo -e "${white}  Username   : ${GREEN}$CLIENT_NAME${white}"
echo -e "${white}  IP Address : ${GREEN}$CLIENT_IP"
if [[ "$EXP_DATE" != 'Unknown' ]]; then
    echo -e "${white}  Expire     : ${GREEN}$EXP_DATE${white} [ ${YELLOW}${DAYS_LEFT} ${white}days left ]${NC}"
else
    echo -e "${white}  Expire     : ${YELLOW}Unknown${NC}"
fi
cmd
echo -e "            ${white} To access, use ${GREEN}menu${NC} command"
cmd

__KAIZEN_INFO_VPS_PANEL_INFO__
