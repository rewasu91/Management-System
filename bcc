#!/usr/bin/env bash
set -euo pipefail
BACKUP="/root/kaizensc-ui-header-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP"
for f in /usr/local/rere/kaizen-ui /usr/local/rere/addssh /usr/local/rere/trial-ssh; do
  [[ -f "$f" ]] && cp -a "$f" "$BACKUP/$(basename "$f")"
done
cat > /usr/local/rere/kaizen-ui <<'KUI'
#!/usr/bin/env bash
KUI_CYAN='\e[1;36m'
KUI_PLAIN='\e[1;0m'
KUI_BG='\e[47;30m'
kaizen_repeat(){
  local ch="$1" n="$2" out='' i
  for ((i=0;i<n;i++)); do out+="$ch"; done
  printf '%s' "$out"
}
kaizen_header(){
  local title="$1" width=49 len left right line
  len=${#title}
  (( len > width )) && width=$len
  left=$(( (width-len)/2 )); right=$(( width-len-left ))
  line=$(kaizen_repeat '─' "$width")
  printf '%b┌%s┐%b\n' "$KUI_CYAN" "$line" "$KUI_PLAIN"
  printf '%b│%b%b%*s%s%*s%b%b│%b\n' "$KUI_CYAN" "$KUI_PLAIN" "$KUI_BG" "$left" '' "$title" "$right" '' "$KUI_PLAIN" "$KUI_CYAN" "$KUI_PLAIN"
  printf '%b└%s┘%b\n\n' "$KUI_CYAN" "$line" "$KUI_PLAIN"
}
KUI
chmod +x /usr/local/rere/kaizen-ui
python3 - <<'PY'
from pathlib import Path
for fn in ['addssh','trial-ssh']:
    p=Path('/usr/local/rere')/fn
    if not p.exists(): continue
    s=p.read_text(errors='ignore')
    lines=s.splitlines(); out=[]; i=0
    while i < len(lines):
        out.append(lines[i])
        if 'kaizen_header ' in lines[i]:
            j=i+1
            if j < len(lines) and lines[j].strip() in {'echo -e ""','echo ""'}: j += 1
            if j+2 < len(lines) and '┌─────────────────────────────────────────────────┐' in lines[j] and 'bgPutih' in lines[j+1] and '└─────────────────────────────────────────────────┘' in lines[j+2]:
                i=j+2
        i+=1
    p.write_text('\n'.join(out)+'\n')
PY
bash -n /usr/local/rere/kaizen-ui
[[ -f /usr/local/rere/addssh ]] && bash -n /usr/local/rere/addssh
[[ -f /usr/local/rere/trial-ssh ]] && bash -n /usr/local/rere/trial-ssh
echo "[OK] KaizenSC header rendering fixed."
echo "[INFO] Backup: $BACKUP"
