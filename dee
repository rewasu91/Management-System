#!/usr/bin/env bash
# Dinda Putri Cindyani
# Final version 4.2: API-Mode Trial Trojan script.
# Accepts a JSON timelimit and automatically generates a unique trial account.

# --- Periksa Dependensi ---
if ! command -v jq &> /dev/null; then
    echo '{"meta":{"code":500,"status":"error","message":"jq is not installed. Please install it to continue."}}'
    exit 1
fi

# --- Validasi Input dari Stdin ---
input_json=$(cat)
if [[ -z "$input_json" ]]; then
  echo '{"meta":{"code":400,"status":"error","message":"JSON input is required via stdin. Example: { \"timelimit\": \"1h\" }"}}'
  exit 1
fi

# -----------------
# --- KONFIGURASI ---
# -----------------
domain=$(cat /etc/xray/domain)
isp=$(cat /root/.isp 2>/dev/null || true)
[[ -n "$isp" ]] || isp="Unknown"
region=$(cat /root/.region)

declare -A paths
paths=(
    [ws,db]="/etc/kaizensc/database/websocket/database.db" [ws,json]="/etc/kaizensc/json/websocket.json" [ws,limit]="/etc/kaizensc/limit/websocket"
    [tcp,db]="/etc/kaizensc/database/tcp/database.db" [tcp,json]="/etc/kaizensc/json/tcp.json" [tcp,limit]="/etc/kaizensc/limit/tcp"
    [grpc,db]="/etc/kaizensc/database/grpc/database.db" [grpc,json]="/etc/kaizensc/json/grpc.json" [grpc,limit]="/etc/kaizensc/limit/grpc"
    [hu,db]="/etc/kaizensc/database/httpupgrade/database.db" [hu,json]="/etc/kaizensc/json/upgrade.json" [hu,limit]="/etc/kaizensc/limit/httpupgrade"
    [xhttp,db]="/etc/kaizensc/database/xhttp/database.db" [xhttp,json]="/etc/kaizensc/json/xhttp.json" [xhttp,limit]="/etc/kaizensc/limit/xhttp"
)

# ----------------------------------------
# --- PARSING & PENGATURAN PARAMETER TRIAL ---
# ----------------------------------------
timelimit=$(echo "$input_json" | jq -r '.timelimit // ""')
if [[ -z "$timelimit" ]]; then
  echo '{"meta":{"code":400,"status":"error","message":"Error: timelimit field cannot be empty. Use formats like 1m, 1h, 1d."}}'
  exit 1
fi

value=$(echo "$timelimit" | sed 's/[^0-9]*//g')
unit=$(echo "$timelimit" | sed 's/[0-9]*//g')
full_unit=""
case "$unit" in
    m) full_unit="minutes" ;;
    h) full_unit="hours" ;;
    d) full_unit="days" ;;
    *) echo '{"meta":{"code":400,"status":"error","message":"Error: Invalid time unit. Use m, h, or d."}}'; exit 1 ;;
esac
