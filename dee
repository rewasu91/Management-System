count_kaizen_ssh_accounts() {
  local db='/etc/kaizensc/database/ssh/database.json' user entry uid count=0
  [[ -s "$db" ]] || { echo 0; return; }
  command -v jq >/dev/null 2>&1 || { echo 0; return; }
  while IFS= read -r user; do
    [[ -n "$user" ]] || continue
    entry=$(getent passwd "$user" 2>/dev/null || true)
    [[ -n "$entry" ]] || continue
    uid=$(printf '%s' "$entry" | awk -F: '{print $3}')
    [[ "$uid" =~ ^[0-9]+$ ]] || continue
    (( uid >= 1000 && uid != 65534 )) || continue
    ((count+=1))
  done < <(jq -r '.[].Username // empty' "$db" 2>/dev/null | sort -u)
  echo "$count"
}

