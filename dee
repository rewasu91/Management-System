cek_email_all() { local email_to_check="$1"; for proto in ws tcp grpc hu xhttp; do [[ -n $(sqlite3 "${paths[$proto,db]}" "SELECT 1 FROM data WHERE email='$email_to_check' LIMIT 1;") ]] && return 0; done; return 1; }

