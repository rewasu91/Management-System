#!/usr/bin/env bash
set -euo pipefail
[[ ${EUID:-$(id -u)} -eq 0 ]] || { echo "Run as root."; exit 1; }

KAISC=/usr/local/kaisc
STAMP="$(date +%Y%m%d-%H%M%S)"
SAVE="/root/kaisc-country-cache-fix-${STAMP}"
mkdir -p "$SAVE"

[[ -d "$KAISC" ]] || { echo "[ERROR] /usr/local/kaisc not found."; exit 1; }

# Create missing cache files immediately.
ip=$(curl -4 -fsS --connect-timeout 3 --max-time 6 ipinfo.io/ip 2>/dev/null || true)
isp=$(curl -4 -fsS --connect-timeout 3 --max-time 6 ipinfo.io/org 2>/dev/null || true)
country=$(curl -4 -fsS --connect-timeout 3 --max-time 6 ipinfo.io/country 2>/dev/null || true)

[[ -n "$ip" ]] || ip=$(hostname -I 2>/dev/null | awk '{print $1}')
[[ -n "$ip" ]] || ip="Unknown"
[[ -n "$isp" ]] || isp="Unknown"
[[ -n "$country" ]] || country="Unknown"

printf '%s\n' "$ip" > /root/.ip
printf '%s\n' "$isp" > /root/.isp
printf '%s\n' "$country" > /root/.country
chmod 0600 /root/.ip /root/.isp /root/.country 2>/dev/null || true

mkdir -p "$(dirname "$KAISC/menu")"
[[ -f "$KAISC/menu" ]] && cp -a "$KAISC/menu" "$SAVE/menu" || true
cat > "$KAISC/menu" <<'__KZN_MENU__'
