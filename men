#!/usr/bin/env bash

# === COLOUR ===
export red='\033[0;31m'
export NC='\033[0m'
export cyan='\e[0;36m'
export green='\e[0;32m'
RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
CYAN='\e[0;36m'
WHITE='\e[0;97m'
red='\e[0;31m'
green='\e[0;32m'
yellow='\e[0;33m'
cyan='\e[0;36m'
white='\e[0;97m'
plain='\e[0m'
bgPutih='\e[0;47;30m'
keatas="${CYAN}│${plain}"

# === RAINBOW LINE ===
cmd() {
    printf '  '
    local i
    for i in {52..57} {57..52}; do
        printf "\e[38;5;${i}m────\e[0m"
    done
    echo
}

# === SAFE HELPERS ===
read_file() {
    [[ -r "$1" ]] && tr -d '\r\n' < "$1"
}

check_service() {
    local svc="$1"
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
        printf '%bONLINE%b' "$GREEN" "$NC"
    else
        printf '%bOFFLINE%b' "$RED" "$NC"
    fi
}

check_any_service() {
    local svc
    for svc in "$@"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf '%bONLINE%b' "$GREEN" "$NC"
            return 0
        fi
    done
    printf '%bOFFLINE%b' "$RED" "$NC"
}

count_xray() {
    local proto="$1"
    local n
    n=$(/usr/local/rere/xray-account count "$proto" 2>/dev/null | tail -n1 | tr -dc '0-9')
    printf '%s' "${n:-0}"
}

# === VPS INFO ===
OS=$(hostnamectl 2>/dev/null | awk -F: '/Operating System/{sub(/^[[:space:]]+/,"",$2); print $2; exit}')
[[ -z "$OS" && -r /etc/os-release ]] && OS=$(. /etc/os-release; printf '%s' "${PRETTY_NAME:-$NAME}")
OS=${OS:-Unknown}
RAM=$(free -m 2>/dev/null | awk '/Mem:/ {print $2; exit}')
RAM=${RAM:-0}
ISP=$(read_file /root/.isp)
ISP=${ISP:-Unknown}
DOMAIN=$(read_file /etc/xray/domain)
DOMAIN=${DOMAIN:-Unknown}

# === CLIENT DETAILS ===
PERMISSION_URL='https://kznsc.kznvpn.com/izin.txt'
LOCAL_IP=$(read_file /root/.ip)
[[ -z "$LOCAL_IP" ]] && LOCAL_IP=$(curl -4 -fsS --max-time 4 ipinfo.io/ip 2>/dev/null || true)
CLIENT_NAME='Unknown'
CLIENT_IP=${LOCAL_IP:-Unknown}
EXP_DATE='Unknown'
DAYS_LEFT='0'

calculate_remaining_days() {
    local expired_date="$1" today expiry
    today=$(date +%s)
    expiry=$(date -d "$expired_date" +%s 2>/dev/null) || return 1
    echo $(( (expiry - today) / 86400 ))
}

if [[ -n "$LOCAL_IP" ]]; then
    PERMISSION_DATA=$(curl -fsS --max-time 8 "$PERMISSION_URL" 2>/dev/null || true)
    if [[ -n "$PERMISSION_DATA" ]]; then
        MATCH=$(printf '%s\n' "$PERMISSION_DATA" | awk -v ip="$LOCAL_IP" '$0 ~ /###/ && $3 == ip {print; exit}')
        if [[ -n "$MATCH" ]]; then
            CLIENT_NAME=$(awk '{print $2}' <<< "$MATCH")
            CLIENT_IP=$(awk '{print $3}' <<< "$MATCH")
            EXP_DATE=$(awk '{print $5}' <<< "$MATCH")
            DAYS_LEFT=$(calculate_remaining_days "$EXP_DATE" 2>/dev/null || echo 0)
        fi
    fi
fi

# === BANDWIDTH USAGE FROM VNSTAT ===
format_bytes() {
    local bytes="${1:-0}"
    awk -v b="$bytes" 'BEGIN {
        if (b >= 1099511627776) printf "%.2f TB", b/1099511627776;
        else if (b >= 1073741824) printf "%.2f GB", b/1073741824;
        else if (b >= 1048576) printf "%.2f MB", b/1048576;
        else if (b >= 1024) printf "%.2f KB", b/1024;
        else printf "%.2f MB", b/1048576;
    }'
}

TTODAY_BYTES=0
TYEST_BYTES=0
TMON_BYTES=0

# Prefer vnStat JSON because it is stable across vnStat display formats.
if command -v vnstat >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
    VNJSON=$(vnstat --json 2>/dev/null || true)
    if [[ -n "$VNJSON" ]]; then
        TTODAY_BYTES=$(jq '[.interfaces[].traffic.day // [] | .[] | select(.date.year == (now|strftime("%Y")|tonumber) and .date.month == (now|strftime("%m")|tonumber) and .date.day == (now|strftime("%d")|tonumber)) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
        TYEST_BYTES=$(jq '[.interfaces[].traffic.day // [] | .[] | select((.date.year|tostring)+"-"+(.date.month|tostring)+"-"+(.date.day|tostring) == ((now-86400)|strftime("%Y-%-m-%-d"))) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
        TMON_BYTES=$(jq '[.interfaces[].traffic.month // [] | .[] | select(.date.year == (now|strftime("%Y")|tonumber) and .date.month == (now|strftime("%m")|tonumber)) | (.rx + .tx)] | add // 0' <<< "$VNJSON" 2>/dev/null || echo 0)
    fi
fi

ttoday=$(format_bytes "$TTODAY_BYTES")
tyest=$(format_bytes "$TYEST_BYTES")
tmon=$(format_bytes "$TMON_BYTES")

# === SERVICE STATUS ===
status_xray_vless=$(check_service xray-vless)
status_xray_vmess=$(check_service xray-vmess)
status_xray_trojan=$(check_service xray-trojan)
status_ssh=$(check_any_service ssh sshd)
