cp -a /etc/openvpn /root/backup/openvpn 2>/dev/null || true
cp -a /etc/letsencrypt /root/backup/letsencrypt 2>/dev/null || true
cp -a /etc/systemd/system /root/backup/systemd-system 2>/dev/null || true
cp /etc/crontab /root/backup/ 2>/dev/null || true
cp -a /etc/cloudflared /root/backup/cloudflared 2>/dev/null || true
cp -a /etc/zivpn /root/backup/zivpn 2>/dev/null || true
cp -a ~/.cloudflared /root/backup/.cloudflared 2>/dev/null || true

# Make a transaction-consistent snapshot of the Xray SQLite account database.
# This contains credentials, expiry, IP/quota limits and lock state.
XRAY_DB=/etc/kaizensc/database/xray/accounts.db
if [[ -f "$XRAY_DB" ]] && command -v sqlite3 >/dev/null 2>&1; then
    mkdir -p /root/backup/kaizensc/database/xray
    rm -f /root/backup/kaizensc/database/xray/accounts.db-wal /root/backup/kaizensc/database/xray/accounts.db-shm 2>/dev/null || true
    sqlite3 "$XRAY_DB" ".timeout 10000" ".backup '/root/backup/kaizensc/database/xray/accounts.db'" 2>/dev/null || cp -af "$XRAY_DB" /root/backup/kaizensc/database/xray/accounts.db
fi

# Manifest makes it easy to verify critical account data exists inside the ZIP.
cat > /root/backup/BACKUP-MANIFEST.txt <<'EOF'
Critical account data included:
- /etc/kaizensc/database/ (SSH + Xray account databases)
- /etc/kaizensc/limit/ (IP limits, quota limits, usage/cache state)
- /etc/kaizensc/recovery/ (locked/recoverable Xray accounts)
