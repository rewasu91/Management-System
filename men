cat > "$TMPDIR_PATCH/restore" <<'__KAIZEN_RESTORE__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
# SYSTEM_UI_TITLE_PATCH
if [[ -t 1 ]] && declare -F kaizen_header >/dev/null; then
  clear; echo; kaizen_header ' • RESTORE DATABASE • '
fi

clear

# Working directory
backup_dir="/root"
backup_file=$(ls $backup_dir/*.zip 2>/dev/null | head -n 1)

# Output color helpers
green() { echo -e "\\033[0;32m${*}\\033[0m"; }
red() { echo -e "\\033[0;31m${*}\\033[0m"; }
export NC='\033[0m'
echo -e "$(green "Starting restore process...")"

# Ensure required packages are installed
# Use a dedicated virtual environment for Debian/Ubuntu PEP 668 compatibility.
GDOWN_VENV="/root/.gdown-venv"
GDOWN_BIN="$GDOWN_VENV/bin/gdown"
if ! command -v python3 &>/dev/null; then
    echo -e "$(green "Installing Python3...")"
    apt update && apt install -y python3 python3-venv python3-pip || { echo -e "$(red "Failed to install Python3!")"; exit 1; }
fi
if [[ ! -x "$GDOWN_BIN" ]]; then
    echo -e "$(green "Installing gdown...")"
    apt update >/dev/null 2>&1
    apt install -y python3-venv python3-pip >/dev/null 2>&1 || true
    rm -rf "$GDOWN_VENV"
    python3 -m venv "$GDOWN_VENV" || { echo -e "$(red "Failed to create the gdown virtual environment!")"; exit 1; }
    "$GDOWN_VENV/bin/python" -m pip install --upgrade pip >/dev/null 2>&1 || true
    "$GDOWN_VENV/bin/python" -m pip install --no-cache-dir gdown || { echo -e "$(red "Failed to install gdown!")"; exit 1; }
fi

# Check for an existing backup ZIP in /root
if [[ -f "$backup_file" ]]; then
    clear
    echo -e "$(green "Backup file found: $backup_file")"
else
    # Ask for a Backup ID or URL
    while [[ -z "$backup_url" ]]; do
        clear
        read -rp "No backup file found! Enter Backup ID or URL: " input

        if [[ -z "$input" ]]; then
            clear
            echo -e "$(red "No Backup ID or URL was entered. Restore cancelled.")"
            exit 1
        fi

        if [[ "$input" == https* ]]; then
            backup_url="$input"
        else
            backup_url="https://drive.google.com/uc?id=${input}&export=download"
        fi
    done

    # Download the backup file using the appropriate method.
    # Google Drive uses gdown; GitHub/direct URLs use curl/wget.
    download_target="$backup_dir/rebackup.zip"
    rm -f "$download_target"

    if [[ "$backup_url" == *"drive.google.com"* ]]; then
        "$GDOWN_BIN" -O "$download_target" "$backup_url"
        download_rc=$?
    else
        if command -v curl >/dev/null 2>&1; then
            curl -fL --retry 5 --retry-delay 2 --connect-timeout 15 --max-time 600 \
                -o "$download_target" "$backup_url"
            download_rc=$?
        elif command -v wget >/dev/null 2>&1; then
            wget --tries=5 --timeout=30 -O "$download_target" "$backup_url"
            download_rc=$?
        else
            echo -e "$(red "curl/wget is not installed!")"
            exit 1
        fi
    fi

    if [[ $download_rc -ne 0 || ! -s "$download_target" ]]; then
        rm -f "$download_target"
        echo -e "$(red "Failed to download the backup file!")"
        exit 1
    fi

    # The backup uses a password-protected ZIP; unzip -t verifies
    # that the downloaded file is a real backup ZIP and not an HTML/error page.
    ZIP_PASSWORD="KznAutoSC"
    if unzip -P "$ZIP_PASSWORD" -t "$download_target" >/dev/null 2>&1; then
        :
    elif unzip -P "Rerechan02" -t "$download_target" >/dev/null 2>&1; then
        ZIP_PASSWORD="Rerechan02"
    else
        rm -f "$download_target"
        echo -e "$(red "Backup file is invalid, damaged, or is not a valid ZIP file!")"
        exit 1
    fi

    backup_file="$download_target"
    echo -e "$(green "Backup file downloaded successfully: $backup_file")"
fi

# Detect backup password. New KaizenSC backups use KznAutoSC; legacy backups remain supported.
if [[ -z "${ZIP_PASSWORD:-}" ]]; then
    if unzip -P "KznAutoSC" -t "$backup_file" >/dev/null 2>&1; then
        ZIP_PASSWORD="KznAutoSC"
    elif unzip -P "Rerechan02" -t "$backup_file" >/dev/null 2>&1; then
        ZIP_PASSWORD="Rerechan02"
    else
        echo -e "$(red "Backup password is invalid or the ZIP file is damaged!")"
        exit 1
    fi
fi

# Extract the backup file
unzip -P "$ZIP_PASSWORD" -o "$backup_file" -d "$backup_dir"

if [[ $? -ne 0 ]]; then
    echo -e "$(red "Failed to extract the backup file!")"
    exit 1
fi

# Restore files using the original directory structure
echo -e "$(green "Starting data restoration...")"
RESTORE_SRC="/root/backup"
if [[ ! -d "$RESTORE_SRC" ]]; then
    echo -e "$(red "Invalid backup structure: /root/backup was not found!")"
    exit 1
fi

# System account files
for f in passwd group shadow gshadow crontab; do
    [[ -f "$RESTORE_SRC/$f" ]] && cp -af "$RESTORE_SRC/$f" "/etc/$f"
done

# Configuration directories; restore only when present in the backup
restore_dir() {
    local src="$1" dst="$2"
    [[ -d "$src" ]] || return 0
    mkdir -p "$dst"
    cp -a "$src"/. "$dst"/
}
restore_dir "$RESTORE_SRC/xray" /etc/xray
restore_dir "$RESTORE_SRC/kaizensc" /etc/kaizensc
restore_dir "$RESTORE_SRC/shadowsocks-libev" /etc/shadowsocks-libev
