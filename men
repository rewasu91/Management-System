rm -rf "$backup_dir"

# Display backup details in the CLI
clear
echo -e "$(green "Backup and Telegram delivery completed.")"
echo -e "$(green "Backup Details:")"
echo -e "🆔 Backup ID: $backup_id"
echo -e "🖥 Server Information:"
echo -e "┣ 📛 Username: $USERNAME"
echo -e "┣ 🌐 Domain: $domain"
echo -e "┣ 🏢 ISP: $asn_info"
echo -e "┣ 🌍 IP VPS: $ipsaya"
echo -e "┣ ⏰ Backup Time: $tanggal at $waktu"
echo -e "┗━━━━━━━━━━━━━━━━━"
echo -e "📥 Download Backup: $link"
