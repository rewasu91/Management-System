echo -e "$(green "Starting Backup")"
sleep 1

# Create backup directory
rm -rf "$backup_dir"
mkdir -p "$backup_dir"

# Copy files included in the backup
sleep 1
echo Start Backup 2>/dev/null
rm -rf /root/backup 2>/dev/null
mkdir /root/backup 2>/dev/null
cp /etc/passwd /root/backup/ 2>/dev/null
cp /etc/group /root/backup/ 2>/dev/null
cp /etc/shadow /root/backup/ 2>/dev/null
cp /etc/gshadow /root/backup/ 2>/dev/null
# Core configuration and ALL account data/state
cp -a /etc/xray /root/backup/xray 2>/dev/null || true
