status_nginx=$(check_service nginx)
status_haproxy=$(check_service haproxy)
status_shadowsocks=$(check_any_service shadowsocks-libev shadowsocks-libev.service)

# === TOTAL ACTIVE USERS ===
xray_vless_user=$(count_xray vless)
xray_vmess_user=$(count_xray vmess)
xray_trojan_user=$(count_xray trojan)
ssh_dropbear_user=$(awk -F: '$3 >= 1000 && $1 != "nobody" && $7 !~ /(nologin|false)$/ {n++} END{print n+0}' /etc/passwd 2>/dev/null)
ss_user=$(grep -c '###' /etc/shadowsocks-libev/akun.conf 2>/dev/null || true)
ssh_dropbear_user=${ssh_dropbear_user:-0}
ss_user=${ss_user:-0}

# === DISPLAY INFORMATION ===
clear
echo -e ''
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}           • VPS DETAIL INFORMATION •          ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
echo -e "${white}  OS               : $OS"
echo -e "${white}  RAM              : ${RAM} MB"
echo -e "${white}  ISP              : $ISP"
echo -e "${white}  Domain           : $DOMAIN"
echo -e "${white}  Usage Today      : ${GREEN}$ttoday${white}"
echo -e "${white}  Usage Yesterday  : ${GREEN}$tyest${white}"
echo -e "${white}  Usage Monthly    : ${GREEN}$tmon${NC}"
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
echo -e "${keatas} ${bgPutih}               • SERVICE STATUS •              ${plain} ${keatas}"
echo -e "${CYAN}└─────────────────────────────────────────────────┘${plain}"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray VLESS" "$status_xray_vless" "Dropbear" "$status_dropbear"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray VMess" "$status_xray_vmess" "SSLH" "$status_sslh"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "Xray Trojan" "$status_xray_trojan" "Nginx" "$status_nginx"
printf "${white}   %-11s : %-7b   ${white}%-11s : %-7b\n" "SSH" "$status_ssh" "Haproxy" "$status_haproxy"
printf "${white}   %-11s : %-7b\n" "Shadowsocks" "$status_shadowsocks"
echo -e "${CYAN}┌─────────────────────────────────────────────────┐${plain}"
