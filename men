cat > "$TMPDIR_PATCH/fn-sc1" <<'__KAIZEN_FN_SC1__'
#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; YELLOW='\e[0;33m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; NC='\e[0m'
cmd(){ printf '  '; local i; for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done; echo; }

unit_exists(){ systemctl cat "$1" >/dev/null 2>&1; }
get_status(){ systemctl is-active --quiet "$1" && echo -e "${GREEN}[ ON ]${NC}" || echo -e "${RED}[ OFF ]${NC}"; }
toggle_service(){
  local svc=$1
  if ! unit_exists "$svc"; then echo -e "${RED}[ERROR] Service not installed: $svc${NC}"; return 1; fi
  if systemctl is-active --quiet "$svc"; then
    systemctl disable --now "$svc" >/dev/null 2>&1 || systemctl stop "$svc"
    echo -e "${YELLOW}$svc is now OFF.${NC}"
  else
    systemctl daemon-reload
    if systemctl enable --now "$svc"; then echo -e "${GREEN}$svc is now ON.${NC}"; else echo -e "${RED}[ERROR] Failed to start $svc.${NC}"; systemctl --no-pager -l status "$svc" | tail -20; fi
  fi
}

# Login notification only uses scripts that actually exist.
get_status_login_notif(){ [[ -f /etc/kaizensc/bot/ssh-login-bot.flag ]] && echo -e "${GREEN}[ ON ]${NC}" || echo -e "${RED}[ OFF ]${NC}"; }
toggle_login_notif(){
  mkdir -p /etc/kaizensc/bot
  local enabled=0; [[ -f /etc/kaizensc/bot/ssh-login-bot.flag ]] && enabled=1
  if (( enabled )); then
    rm -f /etc/kaizensc/bot/ssh-login-bot.flag
    crontab -l 2>/dev/null | grep -v -E 'cek-login-ssh' | crontab - 2>/dev/null || true
    echo -e "${YELLOW}Login notification is now OFF.${NC}"
  else
    local lines=()
    if [[ -x /usr/local/rere/cek-login-ssh ]]; then touch /etc/kaizensc/bot/ssh-login-bot.flag; lines+=("0 * * * * bash /usr/local/rere/cek-login-ssh >/dev/null 2>&1"); fi
    if ((${#lines[@]})); then (crontab -l 2>/dev/null; printf '%s\n' "${lines[@]}") | sort -u | crontab -; echo -e "${GREEN}Login notification is now ON.${NC}"; else echo -e "${RED}[ERROR] SSH login notification script not found.${NC}"; fi
  fi
}

