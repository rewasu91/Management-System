#!/usr/bin/env bash
set -euo pipefail
RERE='/usr/local/rere'
STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="/root/kaizensc-ssh-total-list-fix-backup-${STAMP}"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  echo "Please run this patch as root."
  exit 1
fi
[[ -d "$RERE" ]] || { echo "KaizenSC directory not found: $RERE"; exit 1; }
mkdir -p "$BACKUP"
for f in menu info list-ssh; do
  [[ -f "$RERE/$f" ]] && cp -a "$RERE/$f" "$BACKUP/$f"
done


