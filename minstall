#!/usr/bin/env bash
set -Eeuo pipefail

# VPS Clean Reinstaller v2
# Supported targets:
#   Debian 11 / 12 / 13
#   Ubuntu 22.04 / 24.04 / 26.04
# Engine: https://github.com/bin456789/reinstall

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info() { echo -e "${CYAN}[INFO]${NC} $*"; }
ok()   { echo -e "${GREEN}[ OK ]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
die()  { echo -e "${RED}[FAIL]${NC} $*" >&2; exit 1; }

TMP_FILE="/tmp/vps-reinstall-engine.$$"
ENGINE_FILE="/root/reinstall.sh"
ENGINE_URL="https://raw.githubusercontent.com/bin456789/reinstall/main/reinstall.sh"

cleanup() {
    rm -f "$TMP_FILE" 2>/dev/null || true
}
trap cleanup EXIT

clear 2>/dev/null || true
printf '%b\n' "${BOLD}====================================================${NC}"
printf '%b\n' "${BOLD}             VPS CLEAN REINSTALL v2               ${NC}"
printf '%b\n' "${BOLD}====================================================${NC}"
echo

[[ "$(id -u)" -eq 0 ]] || die "Please run this script as root."

# ---------------------------------------------------------
# Detect current environment
# ---------------------------------------------------------
[[ -r /etc/os-release ]] || die "Unable to detect the current Linux distribution."
# shellcheck disable=SC1091
. /etc/os-release

ARCH="$(uname -m)"
VIRT="$(systemd-detect-virt 2>/dev/null || true)"
[[ -n "$VIRT" ]] || VIRT="unknown"
MEM_MB="$(awk '/MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)"
ROOT_GB="$(df -BG / 2>/dev/null | awk 'NR==2 {gsub(/G/,"",$2); print $2}')"
[[ "$ROOT_GB" =~ ^[0-9]+$ ]] || ROOT_GB=0

info "Current OS      : ${PRETTY_NAME:-unknown}"
info "Kernel          : $(uname -r)"
info "Architecture    : $ARCH"
info "Virtualization  : $VIRT"
info "Memory          : ${MEM_MB} MB"
info "Current root FS : ${ROOT_GB} GB"

case "$VIRT" in
    openvz|lxc|lxc-libvirt)
        die "Disk-level reinstall is not supported on $VIRT virtualization."
        ;;
esac

case "$ARCH" in
    x86_64|amd64|aarch64|arm64) ;;
    *) warn "Architecture '$ARCH' is less commonly tested by this wrapper." ;;
esac

if (( MEM_MB < 256 )); then
    die "At least 256 MB RAM is required."
elif (( MEM_MB < 512 )); then
    warn "Less than 512 MB RAM detected. Debian is recommended over Ubuntu."
fi

# ---------------------------------------------------------
# Required tools
# ---------------------------------------------------------
missing=0
for cmd in curl awk grep sed sha256sum; do
    command -v "$cmd" >/dev/null 2>&1 || missing=1
done

if (( missing == 1 )); then
    info "Installing required utilities..."
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y curl ca-certificates coreutils gawk grep sed
fi

# ---------------------------------------------------------
# Connectivity checks
# ---------------------------------------------------------
info "Checking Internet connectivity..."
if curl -4fsSI --connect-timeout 8 --max-time 15 https://raw.githubusercontent.com/ >/dev/null 2>&1; then
    ok "IPv4 connectivity is working."
elif curl -fsSI --connect-timeout 8 --max-time 15 https://raw.githubusercontent.com/ >/dev/null 2>&1; then
    ok "Internet connectivity is working."
else
    die "Cannot reach raw.githubusercontent.com. Check DNS/network first."
fi

# ---------------------------------------------------------
# OS selection
# ---------------------------------------------------------
while true; do
    echo
    printf '%b\n' "${BOLD}Choose the new operating system:${NC}"
    echo
    echo "  1) Debian 11 (Bullseye)"
    echo "  2) Debian 12 (Bookworm)"
    echo "  3) Debian 13 (Trixie)"
    echo "  4) Ubuntu 22.04 LTS (Jammy)"
    echo "  5) Ubuntu 24.04 LTS (Noble)"
    echo "  6) Ubuntu 26.04 LTS"
    echo "  0) Cancel"
    echo
    read -r -p "Select [0-6]: " CHOICE

    case "$CHOICE" in
        1)
            TARGET_NAME="Debian 11 (Bullseye)"
            TARGET_OS="debian"
            TARGET_VERSION="11"
            break
            ;;
        2)
            TARGET_NAME="Debian 12 (Bookworm)"
            TARGET_OS="debian"
            TARGET_VERSION="12"
            break
            ;;
        3)
            TARGET_NAME="Debian 13 (Trixie)"
            TARGET_OS="debian"
            TARGET_VERSION="13"
            break
            ;;
        4)
            TARGET_NAME="Ubuntu 22.04 LTS (Jammy)"
            TARGET_OS="ubuntu"
            TARGET_VERSION="22.04"
            break
            ;;
        5)
            TARGET_NAME="Ubuntu 24.04 LTS (Noble)"
            TARGET_OS="ubuntu"
            TARGET_VERSION="24.04"
            break
            ;;
        6)
            TARGET_NAME="Ubuntu 26.04 LTS"
            TARGET_OS="ubuntu"
            TARGET_VERSION="26.04"
            break
            ;;
        0)
            echo "Cancelled. No changes were made."
            exit 0
            ;;
        *)
            warn "Invalid selection. Please choose 0-6."
            ;;
    esac
done

echo
info "Selected target : $TARGET_NAME"

# ---------------------------------------------------------
# Safety checks / warning
# ---------------------------------------------------------
if (( ROOT_GB > 0 && ROOT_GB < 2 )); then
    warn "The detected filesystem is very small (${ROOT_GB} GB). Installation may fail."
fi

if [[ "$TARGET_OS" == "ubuntu" ]] && (( MEM_MB < 512 )); then
    warn "Ubuntu requires more memory than Debian. This VPS has only ${MEM_MB} MB RAM."
fi

echo
printf '%b\n' "${RED}${BOLD}WARNING: THIS OPERATION WILL ERASE THE VPS SYSTEM DISK.${NC}"
echo "All existing files, VPN configurations, databases, users and installed software"
echo "on the system disk will be removed during the reinstall."
echo
cat <<'PASSINFO'
ROOT PASSWORD
-------------
Linux does not store your existing password in readable plaintext.
When the upstream installer asks for login credentials:

  Username : root
  Password : enter your CURRENT root password

Using the same password here gives the newly installed VPS the same root password.
PASSINFO

echo
read -r -p "Type ERASE to confirm installation of $TARGET_NAME: " CONFIRM
[[ "$CONFIRM" == "ERASE" ]] || die "Confirmation failed. No changes were made."

# ---------------------------------------------------------
# Fetch reinstall engine
# ---------------------------------------------------------
info "Downloading the latest reinstall engine..."
curl -fL --retry 3 --retry-delay 2 --connect-timeout 10 \
    "$ENGINE_URL" -o "$TMP_FILE" || die "Failed to download reinstall engine."

[[ -s "$TMP_FILE" ]] || die "Downloaded reinstall engine is empty."
grep -q 'reinstall' "$TMP_FILE" || die "Downloaded content does not appear to be the expected installer."

install -m 700 "$TMP_FILE" "$ENGINE_FILE"
ok "Reinstall engine saved as $ENGINE_FILE"
info "SHA256: $(sha256sum "$ENGINE_FILE" | awk '{print $1}')"

# ---------------------------------------------------------
# Final confirmation
# ---------------------------------------------------------
echo
warn "SSH will disconnect when the VPS reboots into the installer."
warn "The SSH host key will change after the new OS is installed."
echo
printf '%b\n' "${BOLD}Command that will be used:${NC}"
echo "  bash $ENGINE_FILE $TARGET_OS $TARGET_VERSION"
echo
read -r -p "Start reinstall setup now? [y/N]: " GO
case "$GO" in
    y|Y|yes|YES) ;;
    *) die "Cancelled before boot changes were made." ;;
esac

echo
info "Starting reinstall setup for $TARGET_NAME..."
info "When prompted, use 'root' and enter your CURRENT root password."
echo

# The password is deliberately entered interactively in the upstream installer.
# It is not written to this wrapper or exposed as a command-line argument.
bash "$ENGINE_FILE" "$TARGET_OS" "$TARGET_VERSION"

cat <<'DONE'

====================================================
REINSTALL SETUP COMPLETED
====================================================

Follow the reinstall engine's instructions shown above.
If it tells you to reboot, run:

  reboot

To cancel a prepared reinstall BEFORE rebooting:

  bash /root/reinstall.sh reset

After the fresh OS boots, if your PC reports:

  WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED!

remove the old SSH key on your PC with:

  ssh-keygen -R YOUR_VPS_IP

then reconnect:

  ssh root@YOUR_VPS_IP
====================================================
DONE
