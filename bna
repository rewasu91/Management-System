#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'
CONFIG=/etc/zivpn/config.json; SERVICE=/etc/systemd/system/zivpn.service; BIN=/usr/local/bin/zivpn; DB=/etc/zivpn/password.json
header(){ clear; kaizen_header " • $1 • "; }
cmd(){ printf '  '; for i in {52..57} {57..52}; do printf "\e[38;5;${i}m────\e[0m"; done; echo; }
installed(){ [[ -x "$BIN" && -f "$CONFIG" && -f "$SERVICE" ]]; }
init_db(){ mkdir -p /etc/zivpn; [[ -f "$DB" ]] || echo '[]' > "$DB"; }
passwords(){ jq -r '.auth.config[]?' "$CONFIG" 2>/dev/null; }
get_port(){ jq -r '.listen // ""' "$CONFIG" 2>/dev/null | grep -oE '[0-9]+'|head -1; }
get_obfs(){ jq -r '.obfs // "-"' "$CONFIG" 2>/dev/null; }
update_passwords(){
 local json; json=$(printf '%s\n' "$@" | jq -R . | jq -s .)
 jq --argjson a "$json" '.auth.config=$a' "$CONFIG" > "$CONFIG.tmp" && mv "$CONFIG.tmp" "$CONFIG"
 systemctl restart zivpn
}
pw_exp(){ init_db; jq -r --arg p "$1" '.[]|select(.password==$p)|.expired' "$DB"|head -1; }
list_table(){
 local title="$1" show_total="${2:-0}" count=0 p exp pw=16 ew=11
 header "$title"; mapfile -t arr < <(passwords)
 for p in "${arr[@]}"; do exp=$(pw_exp "$p"); [[ -n "$exp" && "$exp" != null ]] || exp="-"; exp="${exp%% *}"; ((${#p}>pw))&&pw=${#p}; ((${#exp}>ew))&&ew=${#exp}; done
 C=$(kaizen_table_colour); W=$(kaizen_text_colour); R=$(kaizen_reset); BG='\e[0;47;30m'; a=$(kaizen_repeat_line '─' $((pw+2))); b=$(kaizen_repeat_line '─' $((ew+2)))
 printf '%b┌%s┬%s┐%b\n' "$C" "$a" "$b" "$R"; printf '%b│%b%b %-*s %b%b│%b%b %-*s %b%b│%b\n' "$C" "$R" "$BG" "$pw" Password "$R" "$C" "$R" "$BG" "$ew" "Expire Date" "$R" "$C" "$R"; printf '%b├%s┼%s┤%b\n' "$C" "$a" "$b" "$R"
 for p in "${arr[@]}"; do exp=$(pw_exp "$p"); [[ -n "$exp" && "$exp" != null ]] || exp="-"; exp="${exp%% *}"; count=$((count+1)); printf '%b│%b %-*s %b│%b %-*s %b│%b\n' "$C" "$W" "$pw" "$p" "$C" "$W" "$ew" "$exp" "$C" "$R"; done
 ZCOUNT=$count
 if [[ "$show_total" == 1 ]]; then
   inner=$((pw + ew + 5))
   printf '%b├%s┴%s┤%b\n' "$C" "$a" "$b" "$R"
   printf '%b│%b Total User : %b%-*s%b│%b\n' "$C" "$W" "$(kaizen_yellow)" "$((inner-14))" "$count" "$C" "$R"
   printf '%b└%s┘%b\n' "$C" "$(kaizen_repeat_line '─' "$inner")" "$R"
 else
   printf '%b└%s┴%s┘%b\n' "$C" "$a" "$b" "$R"
 fi
}
install_z(){
 header "INSTALL / UPDATE ZIVPN"
 wget -qO "$BIN" https://github.com/zahidbd2/udp-zivpn/releases/download/udp-zivpn_1.4.9/udp-zivpn-linux-amd64 || { echo "Download failed."; read -rp 'Press Enter...' _; return; }
 chmod +x "$BIN"; mkdir -p /etc/zivpn; init_db
 port=$(get_port); [[ "$port" =~ ^[0-9]+$ ]] || port=5667
 [[ -f /etc/zivpn/zivpn.key ]] || openssl req -new -newkey rsa:4096 -days 365 -nodes -x509 -subj "/CN=zivpn" -keyout /etc/zivpn/zivpn.key -out /etc/zivpn/zivpn.crt >/dev/null 2>&1
 [[ -f "$CONFIG" ]] || cat > "$CONFIG" <<EOF
{"listen":":$port","cert":"/etc/zivpn/zivpn.crt","key":"/etc/zivpn/zivpn.key","obfs":"zivpn","auth":{"mode":"passwords","config":["zi"]}}
EOF
 cat > "$SERVICE" <<EOF
[Unit]
Description=ZiVPN UDP Server
After=network.target
[Service]
Type=simple
User=root
WorkingDirectory=/etc/zivpn
ExecStart=$BIN server -c $CONFIG
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
EOF
 systemctl daemon-reload; systemctl enable --now zivpn
 header "ZIVPN INSTALLED"; echo "Status : SUCCESS"; echo "Port   : $(get_port)"; read -rp 'Press Enter...' _
}
add_pw(){
 installed || { header "ADD ZIVPN PASSWORD"; echo "ZIVPN is not installed."; read -rp 'Press Enter...' _; return; }
 header "ADD ZIVPN PASSWORD"
 echo -e "  $(kaizen_text_colour)Information on adding an account$(kaizen_reset)"
 echo
 kaizen_expiry_help
 echo
 kaizen_rainbow_line
 echo
 read -rp "Password: " pw; [[ -n "$pw" ]] || return
 passwords | grep -Fxq "$pw" && { echo "Password already exists."; sleep 1; return; }
 while true; do
   read -rp "Expired: " expin
   exp=$(kaizen_parse_expiry "$expin" 2>/dev/null) && [[ -n "$exp" ]] && break
   echo "Invalid expiry. Use 10, YYYY-MM-DD, or YYYY-MM-DD HH:MM:SS."
 done
 mapfile -t arr < <(passwords); arr+=("$pw"); update_passwords "${arr[@]}"; init_db
 jq --arg p "$pw" --arg e "$exp" 'del(.[]|select(.password==$p)) + [{"password":$p,"expired":$e}]' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
 {
   echo "Password    : $pw"
   echo "Expire Date : $exp"
   echo "Domain      : $(cat /etc/xray/domain 2>/dev/null || hostname -f)"
   echo "Port        : $(get_port)"
   echo "Obfs        : $(get_obfs)"
   echo "Status      : SUCCESS"
 } | /usr/local/rere/account-notify-full "ZiVPN Password Created" ZiVPN "$pw" >/dev/null 2>&1 || true
 header "ZIVPN PASSWORD CREATED"; echo "Password    : $pw"; echo "Expire Date : $exp"; echo "Status      : SUCCESS"; read -rp 'Press Enter...' _
}
delete_pw(){
 installed || { header "DELETE ZIVPN PASSWORD"; echo "ZIVPN is not installed."; read -rp 'Press Enter...' _; return; }
 list_table "DELETE ZIVPN PASSWORD"; ((ZCOUNT)) || { read -rp 'Press Enter...' _; return; }; read -rp "Password to delete: " pw
 mapfile -t arr < <(passwords); found=0; new=(); for x in "${arr[@]}"; do [[ "$x" == "$pw" ]] && { found=1; continue; }; new+=("$x"); done; ((found)) || { echo "Password not found."; sleep 1; return; }
 ((${#new[@]})) || { echo "At least one password must remain."; sleep 1; return; }
 read -rp "Delete password '$pw'? (y/n): " yn; [[ "$yn" =~ ^[Yy]$ ]] || return
 update_passwords "${new[@]}"; jq --arg p "$pw" 'del(.[]|select(.password==$p))' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
 /usr/local/rere/account-notify DELETED ZiVPN "$pw" >/dev/null 2>&1 || true
 header "ZIVPN PASSWORD DELETED"; echo "Password : $pw"; echo "Status   : DELETED"; read -rp 'Press Enter...' _
}
extend_pw(){
 installed || { header "EXTEND ZIVPN ACCOUNT"; echo "ZIVPN is not installed."; read -rp 'Press Enter...' _; return; }
 list_table "EXTEND ZIVPN ACCOUNT"
 ((ZCOUNT)) || { read -rp 'Press Enter...' _; return; }
 echo
 kaizen_expiry_help
 echo
 kaizen_rainbow_line
 echo
 read -rp "Password to extend: " pw
 old=$(pw_exp "$pw"); [[ -n "$old" && "$old" != null ]] || { echo "Password not found."; sleep 1; return; }
 while true; do
   read -rp "Expired: " expin
   new=$(kaizen_parse_expiry "$expin" "$old" 2>/dev/null) && [[ -n "$new" ]] && break
   echo "Invalid expiry. Use 10, YYYY-MM-DD, or YYYY-MM-DD HH:MM:SS."
 done
 jq --arg p "$pw" --arg e "$new" 'map(if .password==$p then .expired=$e else . end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
 /usr/local/rere/account-notify EXTENDED ZiVPN "$pw" "Expire: $new" >/dev/null 2>&1 || true
 header "ZIVPN ACCOUNT EXTENDED"
 echo "Password     : $pw"
 echo "Previous     : $old"
 echo "New Expiry   : $new"
 echo "Status       : SUCCESS"
 read -rp 'Press Enter...' _
}
status_z(){
 header "ZIVPN STATUS"; if installed; then systemctl is-active --quiet zivpn && st=ONLINE || st=OFFLINE; else st=NOT-INSTALLED; fi
 [[ "$st" == ONLINE ]] && c=$(kaizen_green) || c=$(kaizen_red); W=$(kaizen_text_colour); R=$(kaizen_reset)
 printf '%bStatus : %b%s%b\n' "$W" "$c" "$st" "$R"; echo "Port   : $(get_port 2>/dev/null || echo -)"; echo "Obfs   : $(get_obfs 2>/dev/null || echo -)"; read -rp 'Press Enter...' _
