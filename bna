echo "Backup of previous scripts: $BACKUP"
echo
echo "Included:"
echo "- Full Xray create config notification"
echo "- Full WireGuard create config notification"
echo "- Full ZiVPN create information notification"
echo "- Google Drive backup upload restored"
echo "- Previous Backup ID/server info Telegram caption restored"
