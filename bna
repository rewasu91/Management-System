list_accounts(){
 local title="${1:-List Wireguard Account}" count=0 u type exp file uw=16 ew=11
 header "$title"
 while IFS='|' read -r u type exp file; do [[ -n "$u" ]] || continue; exp="${exp%% *}"; ((${#u}>uw))&&uw=${#u}; ((${#exp}>ew))&&ew=${#exp}; done < "$DB"
 C=$(kaizen_table_colour); W=$(kaizen_text_colour); R=$(kaizen_reset); BG='\e[0;47;30m'
 a=$(kaizen_repeat_line '─' $((uw+2))); b=$(kaizen_repeat_line '─' 8); d=$(kaizen_repeat_line '─' $((ew+2)))
 printf '%b┌%s┬%s┬%s┐%b\n' "$C" "$a" "$b" "$d" "$R"
 printf '%b│%b%b %-*s %b%b│%b%b %-6s %b%b│%b%b %-*s %b%b│%b\n' "$C" "$R" "$BG" "$uw" Username "$R" "$C" "$R" "$BG" Type "$R" "$C" "$R" "$BG" "$ew" "Expire Date" "$R" "$C" "$R"
 printf '%b├%s┼%s┼%s┤%b\n' "$C" "$a" "$b" "$d" "$R"
 while IFS='|' read -r u type exp file; do [[ -n "$u" ]] || continue; exp="${exp%% *}"; count=$((count+1)); printf '%b│%b %-*s %b│%b %-6s %b│%b %-*s %b│%b\n' "$C" "$W" "$uw" "$u" "$C" "$W" "$type" "$C" "$W" "$ew" "$exp" "$C" "$R"; done < "$DB"
 LIST_COUNT=$count
 if [[ "${SHOW_WG_TOTAL:-0}" == 1 ]]; then
   inner=$((uw + 6 + ew + 8))
   printf '%b├%s┴%s┴%s┤%b\n' "$C" "$a" "$b" "$d" "$R"
   printf '%b│%b Total User : %b%-*s%b│%b\n' "$C" "$W" "$(kaizen_yellow)" "$((inner-14))" "$count" "$C" "$R"
   printf '%b└%s┘%b\n' "$C" "$(kaizen_repeat_line '─' "$inner")" "$R"
 else
   printf '%b└%s┴%s┴%s┘%b\n' "$C" "$a" "$b" "$d" "$R"
 fi
}
create_account(){
