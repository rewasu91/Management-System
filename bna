change_obfs(){ installed || return; header "CHANGE ZIVPN OBFS"; echo "Current : $(get_obfs)"; read -rp "New Obfs: " v; [[ -n "$v" ]] || return; jq --arg v "$v" '.obfs=$v' "$CONFIG" > "$CONFIG.tmp"&&mv "$CONFIG.tmp" "$CONFIG"; systemctl restart zivpn; header "ZIVPN OBFS UPDATED"; echo "Obfs : $v"; echo "Status : SUCCESS"; read -rp 'Press Enter...' _; }
change_port(){ installed || return; header "CHANGE ZIVPN PORT"; echo "Current : $(get_port)"; read -rp "New Port: " v; [[ "$v" =~ ^[0-9]+$ && $v -ge 1 && $v -le 65535 ]] || return; jq --arg v ":$v" '.listen=$v' "$CONFIG" > "$CONFIG.tmp"&&mv "$CONFIG.tmp" "$CONFIG"; systemctl restart zivpn; header "ZIVPN PORT UPDATED"; echo "Port : $v"; echo "Status : SUCCESS"; read -rp 'Press Enter...' _; }
list_cfg(){ installed || return; list_table "LIST ZIVPN PASSWORD" 1; read -rp 'Press Enter...' _; }
uninstall_z(){ header "UNINSTALL ZIVPN"; read -rp "Uninstall ZIVPN? (y/n): " yn; [[ "$yn" =~ ^[Yy]$ ]] || return; systemctl disable --now zivpn >/dev/null 2>&1||true; rm -f "$SERVICE" "$BIN"; systemctl daemon-reload; header "ZIVPN UNINSTALLED"; echo "Status : SUCCESS"; read -rp 'Press Enter...' _; }
