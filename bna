 echo -e "  ${CYAN}[01]${plain} ${WHITE}Create Account with IPv4${plain}"
 echo -e "  ${CYAN}[02]${plain} ${WHITE}Create Account with IPv6${plain}"
 echo -e "  ${CYAN}[03]${plain} ${WHITE}List Wireguard Account${plain}"
 echo -e "  ${CYAN}[04]${plain} ${WHITE}Delete Wireguard Account${plain}"
 echo -e "  ${CYAN}[05]${plain} ${WHITE}Extend Wireguard Account${plain}"
 echo -e "  ${CYAN}[06]${plain} ${WHITE}Check Wireguard Config${plain}"
 echo -e "  ${CYAN}[07]${plain} ${WHITE}Back to Menu${plain}"
 cmd; echo -e "  ${CYAN}[ x]${plain} ${WHITE}Exit${plain}"; cmd
