 case "$opt" in 1|01) create_account IPv4;;2|02) create_account IPv6;;3|03) SHOW_WG_TOTAL=1; list_accounts; SHOW_WG_TOTAL=0; read -rp 'Press Enter...' _;;4|04) delete_account;;5|05) extend_account;;6|06) check_config;;7|07) exec menu;;x|X) exit 0;;*) sleep 1;;esac
