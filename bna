 while true; do
   read -rp "Expired: " expin
   exp=$(kaizen_parse_expiry "$expin" 2>/dev/null) && [[ -n "$exp" ]] && break
   echo -e "${RED}Invalid expiry. Use 10, YYYY-MM-DD, or YYYY-MM-DD HH:MM:SS.${plain}"
 done
 filename="wg-${username}-${type,,}.conf"; flag=-4; [[ "$type" == IPv6 ]] && flag=-6
 if ! warp "$flag" > "$WEB/$filename"; then echo -e "${RED}Failed to generate Wireguard config.${plain}"; rm -f "$WEB/$filename"; sleep 2; return; fi
 printf '%s|%s|%s|%s\n' "$username" "$type" "$exp" "$filename" >> "$DB"
 url="https://$domain/fn/$filename"
 {
   echo "Username    : $username"
   echo "Type        : $type"
   echo "Expire Date : $exp"
   echo "Download    : $url"
   echo
   echo "WireGuard Config:"
   cat "$WEB/$filename" 2>/dev/null || true
 } | /usr/local/rere/account-notify-full "WireGuard Account Created" WireGuard "$username" >/dev/null 2>&1 || true
 header "WIREGUARD ACCOUNT CREATED"
 echo "Username    : $username"; echo "Type        : $type"; echo "Expire Date : $exp"; echo "Download    : $url"
 read -rp 'Press Enter to continue...' _
}
