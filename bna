 read -rp "Delete Wireguard account '$user'? (y/n): " yn; [[ "$yn" =~ ^[Yy]$ ]] || return
 file=$(echo "$row"|cut -d'|' -f4)
 awk -F'|' -v u="$user" '$1!=u' "$DB" > "$DB.tmp"
 mv "$DB.tmp" "$DB"
 rm -f "$WEB/$file"
 /usr/local/rere/account-notify DELETED WireGuard "$user" >/dev/null 2>&1 || true
 header "WIREGUARD ACCOUNT DELETED"; echo "Account : $user"; echo "Status  : DELETED"; read -rp 'Press Enter...' _
}
extend_account(){
 list_accounts "EXTEND WIREGUARD ACCOUNT"; ((LIST_COUNT>0)) || { read -rp 'Press Enter...' _; return; }
 echo
 kaizen_expiry_help
 echo
 kaizen_rainbow_line
 echo
 read -rp "Username to extend: " user; row=$(awk -F'|' -v u="$user" '$1==u{print;exit}' "$DB"); [[ -n "$row" ]] || { echo "[ERROR] Account not found."; sleep 1; return; }
 old=$(echo "$row"|cut -d'|' -f3)
 while true; do
   read -rp "Expired: " expin
   new=$(kaizen_parse_expiry "$expin" "$old" 2>/dev/null) && [[ -n "$new" ]] && break
   echo -e "${RED}Invalid expiry. Use 10, YYYY-MM-DD, or YYYY-MM-DD HH:MM:SS.${plain}"
 done
 awk -F'|' -v OFS='|' -v u="$user" -v n="$new" '$1==u{$3=n}1' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
 /usr/local/rere/account-notify EXTENDED WireGuard "$user" "Expire: $new" >/dev/null 2>&1 || true
 header "WIREGUARD ACCOUNT EXTENDED"
 echo "Account      : $user"
 echo "Previous     : $old"
 echo "New Expiry   : $new"
 echo "Status       : SUCCESS"
 read -rp 'Press Enter...' _
}
check_config(){
 list_accounts "CHECK WIREGUARD CONFIG"; ((LIST_COUNT>0)) || { read -rp 'Press Enter...' _; return; }
 read -rp "Username: " user; row=$(awk -F'|' -v u="$user" '$1==u{print;exit}' "$DB"); [[ -n "$row" ]] || { echo "[ERROR] Account not found."; sleep 1; return; }
 IFS='|' read -r u type exp file <<< "$row"; header "WIREGUARD ACCOUNT CONFIG"
 echo "Username    : $u"; echo "Type        : $type"; echo "Expire Date : $exp"; echo "Download    : https://$domain/fn/$file"; echo; cat "$WEB/$file" 2>/dev/null || true
 read -rp 'Press Enter to continue...' _
}
while true; do
