#!/usr/bin/env bash
set -euo pipefail

TS=$(date +%Y%m%d-%H%M%S)
BK=/root/xray-transport-fix-$TS
mkdir -p "$BK"
echo "[INFO] Backup: $BK"

mkdir -p "$(dirname /etc/haproxy/haproxy.cfg)"
[[ -f /etc/haproxy/haproxy.cfg ]] && cp -a /etc/haproxy/haproxy.cfg "$BK/$(echo /etc/haproxy/haproxy.cfg | tr "/" "_")" || true
base64 -d > /etc/haproxy/haproxy.cfg <<'__PAYLOAD_8__'

__PAYLOAD_8__

mkdir -p "$(dirname /etc/funny/nginx/main.conf)"
[[ -f /etc/funny/nginx/main.conf ]] && cp -a /etc/funny/nginx/main.conf "$BK/$(echo /etc/funny/nginx/main.conf | tr "/" "_")" || true
base64 -d > /etc/funny/nginx/main.conf <<'__PAYLOAD_14__'

__PAYLOAD_14__

mkdir -p "$(dirname /etc/funny/config/xray/xray.conf)"
[[ -f /etc/funny/config/xray/xray.conf ]] && cp -a /etc/funny/config/xray/xray.conf "$BK/$(echo /etc/funny/config/xray/xray.conf | tr "/" "_")" || true
base64 -d > /etc/funny/config/xray/xray.conf <<'__PAYLOAD_20__'

__PAYLOAD_20__

mkdir -p "$(dirname /usr/local/rere/xray-account)"
[[ -f /usr/local/rere/xray-account ]] && cp -a /usr/local/rere/xray-account "$BK/$(echo /usr/local/rere/xray-account | tr "/" "_")" || true
base64 -d > /usr/local/rere/xray-account <<'__PAYLOAD_26__'

__PAYLOAD_26__

chmod +x /usr/local/rere/xray-account
echo "[INFO] Checking xray-account syntax..."
bash -n /usr/local/rere/xray-account

XRAY_BIN=/usr/local/xray-new/xray
[[ -x "$XRAY_BIN" ]] || XRAY_BIN=/usr/local/bin/xray
for p in vless vmess trojan; do
  echo "[INFO] Validating Xray $p..."
  "$XRAY_BIN" run -test -config "/etc/funny/json/$p.json"
done

echo "[INFO] Validating Nginx..."
nginx -t

echo "[INFO] Validating HAProxy..."
[[ -s /etc/haproxy/funny.pem ]] || { echo "[ERROR] /etc/haproxy/funny.pem is missing."; exit 1; }
haproxy -c -f /etc/haproxy/haproxy.cfg

echo "[INFO] Restarting unified Xray services..."
systemctl daemon-reload
systemctl restart xray-vless xray-vmess xray-trojan

# Restart Nginx first so ports 80/2082 are released for the new HAProxy ingress.
systemctl restart nginx
systemctl restart haproxy

echo "[INFO] Service status:"
for s in xray-vless xray-vmess xray-trojan nginx haproxy; do
  if systemctl is-active --quiet "$s"; then echo "  [ONLINE] $s"; else echo "  [FAILED] $s"; systemctl --no-pager -l status "$s" | tail -20 || true; fi
done

echo "[INFO] External listeners:"
ss -lntp 2>/dev/null | grep -E ":(80|443|8443|8999|9443|9755|2082|8000|8080|8180)\b" || true

echo "[OK] XHTTP/gRPC/TCP routing and TLS/non-TLS output fix applied."
echo "[INFO] Existing accounts were not deleted or recreated."
