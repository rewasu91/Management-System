#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true
RED='\e[0;31m'; GREEN='\e[0;32m'; YELLOW='\e[0;33m'; MAGENTA='\e[0;35m'; CYAN='\e[0;36m'; WHITE='\e[0;97m'; plain='\e[0m'

header(){
  clear
  if declare -F kaizen_header >/dev/null; then
    kaizen_header " • CHECK STREAMING COUNTRY STATUS • "
  else
    echo -e "${CYAN}=== CHECK STREAMING COUNTRY STATUS ===${plain}"
  fi
}
value(){ printf '%b%s%b' "$GREEN" "$1" "$plain"; }
fail(){ printf '%b%s%b' "$RED" "$1" "$plain"; }

fetch_json(){
  local url="$1" family="${2:-4}"
  curl -"$family" -fsS --connect-timeout 5 --max-time 10 -A 'Mozilla/5.0 KaizenSC' "$url" 2>/dev/null || true
}
json_get(){
  local json="$1" key="$2"
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$json" | jq -r --arg k "$key" '.[$k] // empty' 2>/dev/null
  else
    python3 - "$key" <<<"$json" 2>/dev/null <<'PY'
import json,sys
key=sys.argv[1]
try:
    d=json.load(sys.stdin)
    v=d.get(key,"")
    print(v if v is not None else "")
except Exception:
    pass
PY
  fi
}
country_code(){
  local family="$1" j c
  j=$(fetch_json 'https://ipwho.is/' "$family")
  c=$(json_get "$j" country_code)
  [[ -n "$c" ]] || c='-'
  printf '%s' "$c"
}
print_ip_info(){
  local family="$1" j ip country region city isp
  j=$(fetch_json 'https://ipwho.is/' "$family")
  if [[ -z "$j" ]]; then
    echo -e "${RED}Unable to retrieve IPv${family} information.${plain}"
    return 1
  fi
  ip=$(json_get "$j" ip); country=$(json_get "$j" country); region=$(json_get "$j" region); city=$(json_get "$j" city)
  if command -v jq >/dev/null 2>&1; then
    isp=$(printf '%s' "$j" | jq -r '.connection.isp // .connection.org // empty' 2>/dev/null)
  else
    isp=''
  fi
  printf "${WHITE}%-12s : ${GREEN}%s${plain}\n" "IP" "${ip:--}"
  printf "${WHITE}%-12s : ${GREEN}%s${plain}\n" "Country" "${country:--}"
  printf "${WHITE}%-12s : ${GREEN}%s${plain}\n" "Region" "${region:--}"
  printf "${WHITE}%-12s : ${GREEN}%s${plain}\n" "City" "${city:--}"
  printf "${WHITE}%-12s : ${GREEN}%s${plain}\n" "ISP" "${isp:--}"
}
http_code(){
  local family="$1" url="$2"
  curl -"$family" -LksS -o /dev/null --connect-timeout 5 --max-time 12 -A 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/124 Safari/537.36' -w '%{http_code}' "$url" 2>/dev/null || printf '000'
}
show_service(){
  local label="$1" url="$2" family="$3" code cc
  code=$(http_code "$family" "$url")
  cc=$(country_code "$family")
  cc=${cc^^}

  # KaizenSC policy: only Malaysia (MY) is considered a positive Global region.
  # Any other detected region (SG, US, JP, etc.) is shown as NO in red.
  if [[ "$cc" != "MY" ]]; then
    printf "${WHITE}%-16s : ${RED}No (Region: %s)${plain}\n" "$label" "$cc"
    return
  fi

  case "$code" in
    200|201|202|204|301|302|303|307|308)
      printf "${WHITE}%-16s : ${GREEN}Yes (Region: MY)${plain}\n" "$label" ;;
    *)
      printf "${WHITE}%-16s : ${RED}No (Region: MY)${plain}\n" "$label" ;;
  esac
}

header
