#!/usr/bin/env bash
source /usr/local/rere/kaizen-ui 2>/dev/null || true

RED='\e[0;31m'
GREEN='\e[0;32m'
YELLOW='\e[0;33m'
CYAN='\e[0;36m'
WHITE='\e[0;97m'
plain='\e[0m'
SYSCTL_FILE='/etc/sysctl.d/99-kaizensc-ipv6.conf'

cmd(){
  printf '  '
  local i
  for i in {52..57} {57..52}; do
    printf "\e[38;5;${i}m────\e[0m"
  done
  echo
}

header(){
  clear
  if declare -F kaizen_header >/dev/null; then
    kaizen_header " • ON/OFF IPV6 • "
  else
    echo -e "${CYAN}=== ON/OFF IPV6 ===${plain}"
  fi
}

ipv6_disabled(){
  local v
  v=$(sysctl -n net.ipv6.conf.all.disable_ipv6 2>/dev/null || printf '1')
  [[ "$v" == "1" ]]
}

write_persistent(){
  local state="$1"
  mkdir -p /etc/sysctl.d
  cat > "$SYSCTL_FILE" <<EOF
# KaizenSC persistent IPv6 setting.
# 0 = IPv6 enabled, 1 = IPv6 disabled.
net.ipv6.conf.all.disable_ipv6 = ${state}
net.ipv6.conf.default.disable_ipv6 = ${state}
net.ipv6.conf.lo.disable_ipv6 = ${state}
EOF
  chmod 644 "$SYSCTL_FILE"
}

apply_all_interfaces(){
  local state="$1" path ifname
  # Apply the persistent base values first.
  sysctl -q -w "net.ipv6.conf.all.disable_ipv6=${state}" 2>/dev/null || true
  sysctl -q -w "net.ipv6.conf.default.disable_ipv6=${state}" 2>/dev/null || true
  sysctl -q -w "net.ipv6.conf.lo.disable_ipv6=${state}" 2>/dev/null || true

  # Apply to every currently-created network interface as well.
  for path in /proc/sys/net/ipv6/conf/*/disable_ipv6; do
    [[ -e "$path" ]] || continue
    ifname=${path#/proc/sys/net/ipv6/conf/}
    ifname=${ifname%/disable_ipv6}
    sysctl -q -w "net.ipv6.conf.${ifname}.disable_ipv6=${state}" 2>/dev/null || true
  done
}

set_ipv6(){
  local state="$1" label="$2"
  write_persistent "$state"
  apply_all_interfaces "$state"

  header
  if [[ "$state" == "0" ]]; then
    if ipv6_disabled; then
      echo -e "${RED}  IPv6 could not be enabled by sysctl.${plain}"
      if grep -qw 'ipv6.disable=1' /proc/cmdline 2>/dev/null; then
        echo -e "${YELLOW}  Kernel boot parameter ipv6.disable=1 is active.${plain}"
      fi
    else
      echo -e "${GREEN}  IPv6 is now ON.${plain}"
      echo -e "${WHITE}  The setting is persistent after VPS reboot.${plain}"
    fi
  else
    if ipv6_disabled; then
      echo -e "${RED}  IPv6 is now OFF.${plain}"
      echo -e "${WHITE}  The setting is persistent after VPS reboot.${plain}"
    else
      echo -e "${YELLOW}  IPv6 disable setting was written, but runtime state did not change.${plain}"
    fi
  fi
  echo
  read -rp '  Press Enter to continue...' _
}

while true; do
  header
  if ipv6_disabled; then
    echo -e "                  ${WHITE}IPV6 Status ${RED}[OFF]${plain}"
  else
    echo -e "                  ${WHITE}IPV6 Status ${GREEN}[ON]${plain}"
  fi
  echo
  cmd
  echo -e "  ${CYAN}[01]${plain} ${WHITE}ON${plain}"
  echo -e "  ${CYAN}[02]${plain} ${WHITE}OFF${plain}"
  echo -e "  ${CYAN}[03]${plain} ${WHITE}Back to System VPS${plain}"
  cmd
  echo -e "  ${CYAN}[ x]${plain} ${WHITE}Exit${plain}"
  cmd
  echo
  read -rp " $(echo -e "${WHITE}Please select an option [01-03 or x]:${plain} ")" opt

  case "$opt" in
    1|01) set_ipv6 0 ON ;;
    2|02) set_ipv6 1 OFF ;;
    3|03) exec menu-system ;;
    x|X) clear; exit 0 ;;
    *) echo; echo -e "${RED}  Invalid option, please try again!${plain}"; sleep 1 ;;
  esac
done

