#!/usr/bin/env bash
set -Eeuo pipefail

CFG=/etc/haproxy/haproxy.cfg
NGX=/etc/funny/nginx/main.conf
SVC=/etc/systemd/system/ws-stunnel.service
BACKUP="/root/sshws-multiport-v2-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP"
for f in "$CFG" "$NGX" "$SVC"; do
  [[ -f "$f" ]] || { echo "[ERROR] Missing: $f"; exit 1; }
  cp -a "$f" "$BACKUP/$(basename "$f")"
done

echo "[INFO] Backup: $BACKUP"

python3 - <<'PY'
from pathlib import Path
import re

cfg = Path('/etc/haproxy/haproxy.cfg')
s = cfg.read_text()

# Remove any stale/incomplete SSH_WEBSOCKET backend block, then append one guaranteed block.
s = re.sub(r'(?ms)^backend SSH_WEBSOCKET\n.*?(?=^(?:backend|frontend|listen|global|defaults)\s|\Z)', '', s)
s = s.rstrip() + '''\n\n# Unified SSH WebSocket backend\nbackend SSH_WEBSOCKET\n    mode tcp\n    option tcp-check\n    server sshws 127.0.0.1:18080 check\n'''

# Ensure 2080 public frontend exists.
if not re.search(r'(?m)^frontend ssh_websocket_2080\s*$', s):
    s += '''\n\n# Public SSH WebSocket port 2080\nfrontend ssh_websocket_2080\n    mode tcp\n    bind *:2080 tfo\n    option tcplog\n    default_backend SSH_WEBSOCKET\n'''

cfg.write_text(s + '\n')

# Ensure private Node backend is 18080.
p = Path('/etc/systemd/system/ws-stunnel.service')
x = p.read_text()
x = re.sub(r'-mport\s+2080\b', '-mport 18080', x)
# Also normalize accidental legacy variants.
x = re.sub(r'-mport\s+18080\s+-skip\s+0\b', '-mport 18080 -skip 1', x)
p.write_text(x)

# Nginx internal proxy must follow private backend.
p = Path('/etc/funny/nginx/main.conf')
x = p.read_text().replace('127.0.0.1:2080', '127.0.0.1:18080')
p.write_text(x)
PY

# Validate syntax first. HAProxy does not require the backend process to be listening for -c.
echo "[INFO] Validating Nginx..."
nginx -t

echo "[INFO] Validating HAProxy..."
haproxy -c -f "$CFG"

# Move private ws-stunnel away from public 2080 before HAProxy is restarted.
systemctl daemon-reload
systemctl restart ws-stunnel
sleep 1

if ! ss -lntp 2>/dev/null | grep -qE '127\.0\.0\.1:18080|\[::1\]:18080|0\.0\.0\.0:18080|\*:18080'; then
  echo "[ERROR] ws-stunnel did not listen on port 18080."
  systemctl --no-pager -l status ws-stunnel || true
  journalctl -u ws-stunnel -n 40 --no-pager || true
  exit 1
fi

# 2080 should now be free for HAProxy (ignoring an already-running HAProxy if it owns it).
if ss -lntp 2>/dev/null | grep -E ':2080\b' | grep -vq haproxy; then
  echo "[ERROR] Port 2080 is still occupied by a non-HAProxy process:"
  ss -lntp 2>/dev/null | grep -E ':2080\b' || true
  exit 1
fi

systemctl restart nginx
systemctl restart haproxy

# Firewall rules.
if command -v iptables >/dev/null 2>&1; then
  for port in 80 2080 2082 8000 8080 8880 443 8443; do
    iptables -C INPUT -p tcp --dport "$port" -j ACCEPT 2>/dev/null || iptables -I INPUT -p tcp --dport "$port" -j ACCEPT
  done
  command -v netfilter-persistent >/dev/null 2>&1 && netfilter-persistent save >/dev/null 2>&1 || true
fi

echo
echo "[OK] HAProxy SSH_WEBSOCKET backend exists and validated."
echo "[OK] Private backend : 127.0.0.1:18080"
echo "[OK] Non-TLS ports  : 80, 2080, 2082, 8000, 8080, 8880"
echo "[OK] TLS ports      : 443, 8443"
echo
echo "[INFO] Services:"
for svc in ws-stunnel nginx haproxy; do
  printf '%-14s %s\n' "$svc" "$(systemctl is-active "$svc" 2>/dev/null || true)"
done

echo
echo "[INFO] Relevant listeners:"
ss -lntp 2>/dev/null | grep -E ':(80|2080|2082|8000|8080|8880|443|8443|18080)\b' || true
