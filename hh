#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo '[ERROR] Run as root.'; exit 1; }
BACKUP="/root/kaizensc-v4-menu-expiry-backup-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$BACKUP/usr/local/rere"
FILES=(menu-ssh menu-xray menu-vless menu-vmess menu-trojan lock-ssh unlock-ssh check-ssh-config change-limit-ip-ssh change-limit-ip-all-ssh extend-ssh delete-ssh xp-ssh xray-account limit-ip-ssh detail menu-system addssh trial-ssh)
for f in "${FILES[@]}"; do [[ -e "/usr/local/rere/$f" ]] && cp -a "/usr/local/rere/$f" "$BACKUP/usr/local/rere/"; done
cp -a /etc/crontab "$BACKUP/crontab" 2>/dev/null || true
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
PAYLOAD_LINE=$(awk '/^__PAYLOAD_BELOW__$/{print NR+1; exit}' "$0")
tail -n +"$PAYLOAD_LINE" "$0" | base64 -d > "$TMP/patch.tgz"
tar -xzf "$TMP/patch.tgz" -C /
chmod +x /usr/local/rere/*
# Expiry every minute; de-duplicate old cadence lines.
if [[ -f /etc/crontab ]]; then
  sed -i -E '\|/usr/local/rere/xp-ssh|d; \|/usr/local/rere/xray-account expire all|d' /etc/crontab
  printf '%s\n' '* * * * * root /usr/local/rere/xp-ssh >/dev/null 2>&1' '* * * * * root /usr/local/rere/xray-account expire all >/dev/null 2>&1' >> /etc/crontab
fi
# Normalize SSH DB Locked field if database exists.
DB=/etc/kaizensc/database/ssh/database.json
if [[ -f "$DB" ]] && command -v jq >/dev/null 2>&1 && jq empty "$DB" 2>/dev/null; then
  jq 'map(if has("Locked") then . else . + {Locked:false} end)' "$DB" > "$DB.tmp" && mv "$DB.tmp" "$DB"
fi
# Syntax validation
for f in "${FILES[@]}"; do bash -n "/usr/local/rere/$f"; done
# Xray config validation, no restart needed unless invalid; current service remains untouched.
XR=/usr/local/xray-new/xray
if [[ -x "$XR" ]]; then
  mkdir -p /var/log/xray; touch /var/log/xray/vless.log /var/log/xray/vmess.log /var/log/xray/trojan.log
  for p in vless vmess trojan; do "$XR" run -test -confdir "/etc/kaizensc/xray/$p" >/dev/null; done
fi
echo "[OK] KaizenSC menu/system/expiry patch applied."
echo "[INFO] Backup: $BACKUP"
exit 0
__PAYLOAD_BELOW__

